// Kontrolki interfejsu: przyciski wstążki, pola liczbowe, listy rozwijane, przełączniki,
// próbki kolorów i podpowiedzi po najechaniu (każda kontrolka ma swoją).

import { Theme } from "theme.slint";

export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <int> serial;
}

/// TouchArea z podpowiedzią po najechaniu; kliknięcie chowa dymek.
export component TipArea inherits TouchArea {
    in property <string> tip;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-action-default => {
        root.clicked();
    }
    changed has-hover => {
        if (self.has-hover && self.tip != "") {
            Tip.text = self.tip;
            Tip.x = self.absolute-position.x + self.mouse-x;
            Tip.y = self.absolute-position.y + self.mouse-y;
            Tip.serial += 1;
        } else if (!self.has-hover && Tip.text == self.tip) {
            Tip.text = "";
        }
    }
    changed pressed => {
        if (self.pressed) {
            Tip.text = "";
        }
    }
}

export component Label inherits Text {
    font-family: Theme.font;
    font-size: Theme.fs;
    color: Theme.text;
    vertical-alignment: center;
    overflow: elide;
}

export component Dim inherits Text {
    font-family: Theme.font;
    font-size: Theme.fs-small;
    color: Theme.text-dim;
    vertical-alignment: center;
    overflow: elide;
}

/// Mały przycisk z ikoną (pasek szybkiego dostępu, wstążka, panele).
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <length> size: 28px * Theme.scale;
    in property <length> icon-size: 16px * Theme.scale;
    in property <color> tint: Theme.text;
    callback clicked();
    width: size;
    height: size;
    border-radius: Theme.r-small;
    background: !enabled ? transparent : ta.pressed ? Theme.press : active ? Theme.accent-soft : ta.has-hover ? Theme.hover : transparent;
    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        colorize: !root.enabled ? Theme.text-faint : root.active ? Theme.accent : root.tint;
    }
    ta := TipArea {
        enabled: root.enabled;
        tip: root.tip;
        clicked => {
            root.clicked();
        }
    }
}

/// Duży przycisk wstążki: ikona nad podpisem.
export component BigButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> tip;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <bool> menu;
    in property <color> tint: Theme.text;
    callback clicked();
    min-width: max(48px * Theme.scale, t.preferred-width + 12px);
    height: 66px * Theme.scale;
    border-radius: Theme.r-small;
    background: !enabled ? transparent : ta.pressed ? Theme.press : active ? Theme.accent-soft : ta.has-hover ? Theme.hover : transparent;
    VerticalLayout {
        padding-top: 6px * Theme.scale;
        padding-bottom: 4px * Theme.scale;
        spacing: 4px * Theme.scale;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 24px * Theme.scale;
                height: 24px * Theme.scale;
                colorize: !root.enabled ? Theme.text-faint : root.active ? Theme.accent : root.tint;
            }
        }
        t := Text {
            text: root.label + (root.menu ? " ▾" : "");
            font-family: Theme.font;
            font-size: Theme.fs-small;
            color: root.enabled ? Theme.text : Theme.text-faint;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-width: 90px * Theme.scale;
        }
    }
    ta := TipArea {
        enabled: root.enabled;
        tip: root.tip != "" ? root.tip : root.label;
        clicked => {
            root.clicked();
        }
    }
}

/// Średni przycisk wstążki: ikona i podpis w jednym wierszu.
export component RowButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> tip;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <bool> menu;
    callback clicked();
    height: 24px * Theme.scale;
    min-width: hl.preferred-width;
    border-radius: Theme.r-small;
    background: !enabled ? transparent : ta.pressed ? Theme.press : active ? Theme.accent-soft : ta.has-hover ? Theme.hover : transparent;
    hl := HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 6px;
        alignment: start;
        Image {
            source: root.icon;
            width: 16px * Theme.scale;
            height: 16px * Theme.scale;
            y: (parent.height - self.height) / 2;
            colorize: !root.enabled ? Theme.text-faint : root.active ? Theme.accent : Theme.text;
        }
        Text {
            text: root.label + (root.menu ? " ▾" : "");
            font-family: Theme.font;
            font-size: Theme.fs-small;
            color: root.enabled ? Theme.text : Theme.text-faint;
            vertical-alignment: center;
        }
    }
    ta := TipArea {
        enabled: root.enabled;
        tip: root.tip != "" ? root.tip : root.label;
        clicked => {
            root.clicked();
        }
    }
}

/// Grupa wstążki: zawartość i podpis u dołu, rozdzielona cienką linią od następnej.
export component Group inherits Rectangle {
    in property <string> title;
    in property <bool> last;
    HorizontalLayout {
        spacing: 0;
        VerticalLayout {
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 4px;
            padding-bottom: 2px;
            spacing: 2px;
            HorizontalLayout {
                spacing: 2px;
                alignment: start;
                @children
            }
            Text {
                text: root.title;
                font-family: Theme.font;
                font-size: 10px * Theme.scale;
                color: Theme.text-faint;
                horizontal-alignment: center;
                vertical-alignment: bottom;
                height: 14px * Theme.scale;
            }
        }
        if !root.last: VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            Rectangle {
                width: 1px;
                background: Theme.line;
            }
        }
    }
}

export component Col inherits VerticalLayout {
    spacing: 2px;
    alignment: start;
}

export component Row inherits HorizontalLayout {
    spacing: 2px;
    alignment: start;
}

/// Pole tekstowe w stylu motywu.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> tip;
    in property <length> w: 120px;
    in property <bool> mono;
    out property <bool> focused: ti.has-focus;
    callback accepted(string);
    callback edited(string);
    width: root.w;
    height: 24px * Theme.scale;
    border-radius: Theme.r-small;
    background: Theme.raised;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.line;
    ti := TextInput {
        x: 7px;
        width: parent.width - 14px;
        height: parent.height;
        text <=> root.text;
        font-family: root.mono ? "Consolas" : Theme.font;
        font-size: Theme.fs;
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.selection;
        accepted => {
            root.accepted(self.text);
        }
        edited => {
            root.edited(self.text);
        }
    }
    if root.text == "" && !ti.has-focus: Text {
        x: 7px;
        text: root.placeholder;
        font-family: Theme.font;
        font-size: Theme.fs;
        color: Theme.text-faint;
        vertical-alignment: center;
        height: parent.height;
    }
    public function focus-input() {
        ti.focus();
        ti.select-all();
    }
}

/// Pole liczbowe z przyciskami − / +.
export component Spin inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    in property <string> value;
    in property <string> unit;
    in property <length> w: 92px;
    callback changed-value(string);
    callback step(int);
    height: 24px * Theme.scale;
    HorizontalLayout {
        spacing: root.label == "" ? 0 : 6px;
        Text {
            text: root.label;
            font-family: Theme.font;
            font-size: Theme.fs-small;
            color: Theme.text-dim;
            vertical-alignment: center;
        }
        Rectangle {
            width: root.w;
            border-radius: Theme.r-small;
            background: Theme.raised;
            border-width: 1px;
            border-color: inp.has-focus ? Theme.accent : Theme.line;
            HorizontalLayout {
                Rectangle {
                    width: 18px;
                    Text {
                        text: "−";
                        color: Theme.text-dim;
                        font-size: Theme.fs;
                    }
                    TipArea {
                        tip: root.tip;
                        clicked => {
                            root.step(-1);
                        }
                    }
                }
                inp := TextInput {
                    text: root.value;
                    font-family: Theme.font;
                    font-size: Theme.fs;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    single-line: true;
                    accepted => {
                        root.changed-value(self.text);
                    }
                    changed has-focus => {
                        if (!self.has-focus && self.text != root.value) {
                            root.changed-value(self.text);
                        }
                    }
                }
                if root.unit != "": Text {
                    text: root.unit;
                    font-size: Theme.fs-small;
                    color: Theme.text-faint;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 18px;
                    Text {
                        text: "+";
                        color: Theme.text-dim;
                        font-size: Theme.fs;
                    }
                    TipArea {
                        tip: root.tip;
                        clicked => {
                            root.step(1);
                        }
                    }
                }
            }
        }
    }
}

/// Przełącznik (włącz/wyłącz).
export component Switch inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    in property <string> tip;
    callback toggled();
    height: 24px * Theme.scale;
    min-width: hl.preferred-width;
    hl := HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Rectangle {
            width: 30px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: root.on ? Theme.accent : Theme.line-strong;
            animate background { duration: 120ms; }
            Rectangle {
                width: 12px;
                height: 12px;
                y: 2px;
                x: root.on ? 16px : 2px;
                border-radius: 6px;
                background: root.on ? Theme.accent-text : Theme.text;
                animate x { duration: 120ms; easing: ease-out; }
            }
        }
        if root.label != "": Text {
            text: root.label;
            font-family: Theme.font;
            font-size: Theme.fs;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    TipArea {
        tip: root.tip != "" ? root.tip : root.label;
        clicked => {
            root.toggled();
        }
    }
}

/// Próbka koloru z podpowiedzią.
export component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <string> tip;
    in property <bool> selected;
    in property <length> size: 18px;
    callback clicked();
    width: size;
    height: size;
    border-radius: 3px;
    background: root.swatch;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.line-strong;
    if root.swatch.alpha == 0: Path {
        commands: "M 0 18 L 18 0";
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: Theme.danger;
        stroke-width: 1.5px;
    }
    TipArea {
        tip: root.tip;
        clicked => {
            root.clicked();
        }
    }
}

/// Przycisk tekstowy (okna dialogowe, menu Plik).
export component Button inherits Rectangle {
    in property <string> label;
    in property <string> tip;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <image> icon;
    callback clicked();
    height: 30px * Theme.scale;
    min-width: hl.preferred-width + 8px;
    border-radius: Theme.r-small;
    background: !enabled ? Theme.hover : primary ? (ta.pressed ? Theme.accent.darker(0.15) : ta.has-hover ? Theme.accent.brighter(0.08) : Theme.accent) : (ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : Theme.raised);
    border-width: primary ? 0 : 1px;
    border-color: Theme.line;
    hl := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        if root.icon.width > 0: Image {
            source: root.icon;
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
            colorize: root.primary ? Theme.accent-text : Theme.text;
        }
        Text {
            text: root.label;
            font-family: Theme.font;
            font-size: Theme.fs;
            color: !root.enabled ? Theme.text-faint : root.primary ? Theme.accent-text : Theme.text;
            vertical-alignment: center;
        }
    }
    ta := TipArea {
        enabled: root.enabled;
        tip: root.tip;
        clicked => {
            root.clicked();
        }
    }
}

/// Wiersz menu (listy rozwijane, menu kontekstowe, wybór opcji).
export component MenuItem inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <image> icon;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> font-family: Theme.font;
    in property <length> font-size: Theme.fs;
    callback clicked();
    height: max(28px * Theme.scale, t.preferred-height + 8px);
    border-radius: Theme.r-small;
    background: ta.has-hover && root.enabled ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            width: 16px;
            if root.checked: Text {
                text: "✓";
                color: Theme.accent;
                font-size: Theme.fs;
            }
            if !root.checked && root.icon.width > 0: Image {
                source: root.icon;
                width: 15px;
                height: 15px;
                colorize: Theme.text-dim;
            }
        }
        t := Text {
            text: root.label;
            font-family: root.font-family;
            font-size: root.font-size;
            color: root.enabled ? Theme.text : Theme.text-faint;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.hint != "": Text {
            text: root.hint;
            font-family: Theme.font;
            font-size: Theme.fs-small;
            color: Theme.text-faint;
            vertical-alignment: center;
        }
    }
    ta := TipArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

export component MenuSep inherits Rectangle {
    height: 9px;
    Rectangle {
        height: 1px;
        background: Theme.line;
        x: 6px;
        width: parent.width - 12px;
    }
}

/// Tło wysuwanej karty / menu.
export component Card inherits Rectangle {
    background: Theme.popup;
    border-radius: Theme.r;
    border-width: 1px;
    border-color: Theme.line-strong;
    drop-shadow-blur: 24px;
    drop-shadow-color: #0000008c;
    drop-shadow-offset-y: 6px;
}

/// Pasek wyboru jednej z kilku opcji (segmenty).
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    in property <string> tip;
    callback picked(int);
    height: 26px * Theme.scale;
    border-radius: Theme.r-small;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.line;
    min-width: hl.preferred-width;
    hl := HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for it[i] in root.items: Rectangle {
            min-width: st.preferred-width + 18px;
            border-radius: Theme.r-small - 1px;
            background: i == root.current ? Theme.accent : sta.has-hover ? Theme.hover : transparent;
            st := Text {
                text: it;
                font-family: Theme.font;
                font-size: Theme.fs-small;
                color: i == root.current ? Theme.accent-text : Theme.text;
            }
            sta := TipArea {
                tip: root.tip;
                clicked => {
                    root.picked(i);
                }
            }
        }
    }
}

/// Suwak 0..1.
export component Slider inherits Rectangle {
    in property <float> value;
    in property <string> tip;
    callback moved(float);
    height: 20px;
    min-width: 80px;
    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.line-strong;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.value, 0, 1);
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        x: (parent.width - 12px) * clamp(root.value, 0, 1);
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
    }
    ta := TipArea {
        tip: root.tip;
        moved => {
            if (self.pressed) {
                root.moved(clamp(self.mouse-x / self.width, 0, 1));
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.moved(clamp(self.mouse-x / self.width, 0, 1));
            }
        }
    }
}
