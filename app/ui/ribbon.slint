        { id: "line", label: @tr("Liniowy"), icon: Icons.chart-line },
        { id: "area", label: @tr("Warstwowy"), icon: Icons.chart-area },
        { id: "pie", label: @tr("Kołowy"), icon: Icons.chart-pie },
        { id: "doughnut", label: @tr("Pierścieniowy"), icon: Icons.circle-dot },
    ];
    out property <[ItemV]> symbols: [
        { id: "©", label: "©  " + @tr("prawa autorskie") }, { id: "®", label: "®  " + @tr("znak zastrzeżony") }, { id: "™", label: "™  " + @tr("znak towarowy") },
        { id: "§", label: "§  " + @tr("paragraf") }, { id: "¶", label: "¶  " + @tr("akapit") }, { id: "†", label: "†  " + @tr("krzyżyk") },
        { id: "•", label: "•  " + @tr("punktor") }, { id: "…", label: "…  " + @tr("wielokropek") }, { id: "–", label: "–  " + @tr("półpauza") },
        { id: "—", label: "—  " + @tr("pauza") }, { id: "„", label: "„  " + @tr("cudzysłów dolny") }, { id: "”", label: "”  " + @tr("cudzysłów górny") },
        { id: "«", label: "«  " + @tr("cudzysłów francuski") }, { id: "»", label: "»" }, { id: "°", label: "°  " + @tr("stopień") },
        { id: "±", label: "±" }, { id: "×", label: "×  " + @tr("razy") }, { id: "÷", label: "÷" }, { id: "≈", label: "≈" }, { id: "≠", label: "≠" },
        { id: "≤", label: "≤" }, { id: "≥", label: "≥" }, { id: "€", label: "€  euro" }, { id: "£", label: "£" }, { id: "$", label: "$" },
        { id: "→", label: "→" }, { id: "←", label: "←" }, { id: "↑", label: "↑" }, { id: "↓", label: "↓" }, { id: "∞", label: "∞" },
        { id: "√", label: "√" }, { id: "π", label: "π" }, { id: "Ω", label: "Ω" }, { id: "µ", label: "µ" }, { id: "α", label: "α" },
        { id: "β", label: "β" }, { id: "γ", label: "γ" }, { id: "Δ", label: "Δ" }, { id: "★", label: "★" }, { id: "♥", label: "♥" },
        { id: "\u{00A0}", label: @tr("Twarda spacja (Ctrl+Shift+Spacja)") }, { id: "\u{00AD}", label: @tr("Miękki dywiz") },
    ];
    out property <[ItemV]> fields: [
        { id: "page-number", label: @tr("Numer strony"), icon: Icons.hash },
        { id: "page-count", label: @tr("Liczba stron") },
        { id: "date", label: @tr("Data (aktualizowana)"), icon: Icons.calendar },
        { id: "time", label: @tr("Godzina"), icon: Icons.clock },
        { id: "title", label: @tr("Tytuł dokumentu") },
        { id: "author", label: @tr("Autor") },
        { id: "running-1", label: @tr("Tytuł rozdziału"), icon: Icons.panel-top },
        { id: "running-2", label: @tr("Tytuł podrozdziału") },
        { id: "-" },
        { id: "date-text", label: @tr("Dzisiejsza data jako tekst") },
    ];
    out property <[ItemV]> captions: [
        { id: "figure", label: @tr("Rysunek"), icon: Icons.image },
        { id: "table", label: @tr("Tabela"), icon: Icons.rows-3 },
        { id: "equation", label: @tr("Wzór"), icon: Icons.sigma },
    ];
    out property <[ItemV]> repeats: [
        { id: "none", label: @tr("Tylko na tej stronie") },
        { id: "all", label: @tr("Na wszystkich stronach"), icon: Icons.layers },
        { id: "odd", label: @tr("Na stronach nieparzystych") },
        { id: "even", label: @tr("Na stronach parzystych") },
    ];
    out property <[ItemV]> page-sizes: [
        { id: "A4", label: "A4  ·  210 × 297 mm" }, { id: "A5", label: "A5  ·  148 × 210 mm" }, { id: "A3", label: "A3  ·  297 × 420 mm" },
        { id: "B5", label: "B5  ·  176 × 250 mm" }, { id: "Letter", label: "Letter  ·  8,5 × 11 in" }, { id: "Legal", label: "Legal  ·  8,5 × 14 in" },
        { id: "A6", label: "A6  ·  105 × 148 mm" }, { id: "DL", label: "DL  ·  99 × 210 mm" }, { id: "Square", label: @tr("Kwadrat  ·  210 × 210 mm") },
    ];
    out property <[ItemV]> margins: [
        { id: "normal", label: @tr("Normalne  ·  25 mm") }, { id: "narrow", label: @tr("Wąskie  ·  12,7 mm") }, { id: "moderate", label: @tr("Umiarkowane  ·  19 / 25 mm") },
        { id: "wide", label: @tr("Szerokie  ·  38 mm") }, { id: "book", label: @tr("Książkowe  ·  20 / 30 mm") }, { id: "none", label: @tr("Bez marginesów (plakat)") },
    ];
    out property <[ItemV]> wraps: [
        { id: "0", label: @tr("Bez opływania (przed tekstem)") },
        { id: "1", label: @tr("Wokół – z obu stron"), icon: Icons.wrap-text },
        { id: "2", label: @tr("Tylko po lewej stronie") },
        { id: "3", label: @tr("Tylko po prawej stronie") },
        { id: "4", label: @tr("Po stronie z większym miejscem") },
        { id: "5", label: @tr("Nad i pod obiektem") },
        { id: "6", label: @tr("Za tekstem") },
    ];
    out property <[ItemV]> zooms: [
        { id: "50", label: "50%" }, { id: "75", label: "75%" }, { id: "100", label: "100%" }, { id: "125", label: "125%" },
        { id: "150", label: "150%" }, { id: "200", label: "200%" }, { id: "300", label: "300%" }, { id: "400", label: "400%" },
        { id: "-" }, { id: "width", label: @tr("Szerokość strony") }, { id: "page", label: @tr("Cała strona") },
    ];
}

// ---------------------------------------------------------------- karty

component HomeTab inherits HorizontalLayout {
    // Szerokość wstążki – od niej zależy, ile stylów mieści się w galerii.
    in property <length> avail;
    alignment: start;
    Group {
        title: @tr("AI");
        optional: true;
        BigButton {
            icon: Icons.wand-sparkles;
            label: @tr("Generuj");
            tip: @tr("Generuj dokument z AI na podstawie opisu");
            tint: Theme.accent;
            clicked => {
                App.cmd("ai", "");
            }
        }
    }
    Group {
        title: @tr("Schowek");
        Col {
            BigButton {
                icon: Icons.clipboard-paste;
                label: @tr("Wklej");
                tip: @tr("Wklej (Ctrl+V)");
                height: 50px * Theme.scale;
                clicked => {
                    App.cmd("paste", "");
                }
            }
            MenuButton {
                icon: Icons.chevron-down;
                label: @tr("Opcje");
                tip: @tr("Wklej specjalnie – z formatowaniem albo jako sam tekst");
                items: Menus.paste;
                menu-w: 280px;
                picked(id) => {
                    App.cmd(id, "");
                }
            }
        }
        Col {
            RowButton {
                icon: Icons.scissors;
                label: @tr("Wytnij");
                tip: @tr("Wytnij (Ctrl+X)");
                clicked => {
                    App.cmd("cut", "");
                }
            }
            RowButton {
                icon: Icons.copy;
                label: @tr("Kopiuj");
                tip: @tr("Kopiuj (Ctrl+C)");
                clicked => {
                    App.cmd("copy", "");
                }
            }
            RowButton {
                icon: Icons.paintbrush;
                label: @tr("Malarz");
                tip: @tr("Malarz formatów – skopiuj formatowanie i kliknij tekst docelowy (Ctrl+Shift+C / Ctrl+Shift+V)");
                active: App.tool == 6;
                clicked => {
                    App.cmd("format-painter", "");
                }
            }
        }
    }
    Group {
        title: @tr("Czcionka");
        launcher-tip: @tr("Czcionka – wszystkie ustawienia");
        launch => {
            App.cmd("font-dialog", "");
        }
        Col {
            Row {
                FontBox {}
                SizeBox {}
                IconButton {
                    icon: Icons.a-arrow-up;
                    tip: @tr("Powiększ czcionkę (Ctrl+])");
                    size: 24px;
                    clicked => {
                        App.cmd("grow", "");
                    }
                }
                IconButton {
                    icon: Icons.a-arrow-down;
                    tip: @tr("Pomniejsz czcionkę (Ctrl+[)");
                    size: 24px;
                    clicked => {
                        App.cmd("shrink", "");
                    }
                }
                IconButton {
                    icon: Icons.eraser;
                    tip: @tr("Wyczyść formatowanie znaków (Ctrl+Spacja)");
                    size: 24px;
                    clicked => {
                        App.cmd("clear-format", "");
                    }
                }
            }
            Row {
                IconButton {
                    icon: Icons.bold;
                    tip: @tr("Pogrubienie (Ctrl+B)");
                    active: App.bold;
                    size: 26px;
                    clicked => {
                        App.cmd("bold", "");
                    }
                }
                IconButton {
                    icon: Icons.italic;
                    tip: @tr("Kursywa (Ctrl+I)");
                    active: App.italic;
                    size: 26px;
                    clicked => {
                        App.cmd("italic", "");
                    }
                }
                IconButton {
                    icon: Icons.underline;
                    tip: @tr("Podkreślenie (Ctrl+U)");
                    active: App.underline;
                    size: 26px;
                    clicked => {
                        App.cmd("underline", "");
                    }
                }
                MenuButton {
                    icon: Icons.chevron-down;
                    label: "";
                    tip: @tr("Rodzaj podkreślenia");
                    items: Menus.underline;
                    menu-w: 180px;
                    width: 16px;
                    picked(id) => {
                        App.cmd("underline-kind", id);
                    }
                }
                IconButton {
                    icon: Icons.strikethrough;
                    tip: @tr("Przekreślenie");
                    active: App.strike;
                    size: 26px;
                    clicked => {
                        App.cmd("strike", "");
                    }
                }
                IconButton {
                    icon: Icons.superscript;
                    tip: @tr("Indeks górny (Ctrl+Shift+=)");
                    active: App.sup;
                    size: 26px;
                    clicked => {
                        App.cmd("sup", "");
                    }
                }
                IconButton {
                    icon: Icons.subscript;
                    tip: @tr("Indeks dolny (Ctrl+=)");
                    active: App.sub;
                    size: 26px;
                    clicked => {
                        App.cmd("sub", "");
                    }
                }
                MenuButton {
                    icon: Icons.case-sensitive;
                    label: "";
                    tip: @tr("Wersaliki, kapitaliki i zmiana wielkości liter");
                    items: Menus.caps;
                    active: App.caps > 0;
                    menu-w: 230px;
                    picked(id) => {
                        App.cmd("caps", id);
                    }
                }
                ColorPick {
                    icon: Icons.baseline;
                    current: App.last-color;
                    tip: @tr("Kolor czcionki");
                    allow-none: false;
                    apply => {
                        App.cmd("color", "last");
                    }
                    picked(c) => {
                        App.last-color = c;
                        App.cmd("color", "last");
                    }
                }
                ColorPick {
                    icon: Icons.highlighter;
                    current: App.last-highlight;
                    tip: @tr("Kolor wyróżnienia tekstu");
                    apply => {
                        App.cmd("highlight", "last");
                    }
                    picked(c) => {
                        App.last-highlight = c;
                        App.cmd("highlight", "last");
                    }
                }
            }
            Row {
                IconButton {
                    icon: Icons.fold-vertical;
                    tip: @tr("Zagęść znaki (−0,5 pt)");
                    size: 24px;
                    clicked => {
                        App.cmd("tracking-step", "-1");
                    }
                }
                IconButton {
                    icon: Icons.unfold-horizontal;
                    tip: @tr("Rozstrzel znaki (+0,5 pt)");
                    size: 24px;
                    clicked => {
                        App.cmd("tracking-step", "1");
                    }
                }
                IconButton {
                    icon: Icons.type-outline;
                    tip: @tr("Kontur tekstu");
                    active: App.outline-text;
                    size: 24px;
                    clicked => {
                        App.cmd("outline-text", "");
                    }
                }
                MenuButton {
                    icon: Icons.sparkles;
                    label: "";
                    tip: @tr("Efekty tekstu: cień, poświata");
                    items: Menus.effects;
                    active: App.effect != "";
                    current: App.effect;
                    menu-w: 180px;
                    picked(id) => {
                        App.cmd("effect", id);
                    }
                }
            }
        }
    }
    Group {
        title: @tr("Akapit");
        launcher-tip: @tr("Akapit – wszystkie ustawienia");
        launcher-icon: Icons.sliders-vertical;
        launch => {
            App.cmd("para-dialog", "");
        }
        Col {
            Row {
                MenuButton {
                    icon: Icons.list;
                    label: "";
                    tip: @tr("Punktory (listy nienumerowane)");
                    items: Menus.lists;
                    active: App.list-kind != "" && App.list-kind != "number";
                    current: App.list-kind;
                    picked(id) => {
                        App.cmd("list", id);
                    }
                }
                IconButton {
                    icon: Icons.list-ordered;
                    tip: @tr("Numeracja");
                    active: App.list-kind == "number";
                    size: 26px;
                    clicked => {
                        App.cmd("list", App.list-kind == "number" ? "" : "number");
                    }
                }
                IconButton {
                    icon: Icons.list-indent-decrease;
                    tip: @tr("Zmniejsz wcięcie / poziom listy (Shift+Tab)");
                    size: 26px;
                    clicked => {
                        App.cmd("outdent", "");
                    }
                }
                IconButton {
                    icon: Icons.list-indent-increase;
                    tip: @tr("Zwiększ wcięcie / poziom listy (Tab)");
                    size: 26px;
                    clicked => {
                        App.cmd("indent", "");
                    }
                }
                IconButton {
                    icon: Icons.pilcrow;
                    tip: @tr("Pokaż znaki formatowania (Ctrl+*)");
                    active: App.marks;
                    size: 26px;
                    clicked => {
                        App.cmd("marks", "");
                    }
                }
            }
            Row {
                IconButton {
                    icon: Icons.align-left;
                    tip: @tr("Do lewej (Ctrl+L)");
                    active: App.align == 0;
                    size: 26px;
                    clicked => {
                        App.cmd("align", "0");
                    }
                }
                IconButton {
                    icon: Icons.align-center;
                    tip: @tr("Wyśrodkuj (Ctrl+E)");
                    active: App.align == 1;
                    size: 26px;
                    clicked => {
                        App.cmd("align", "1");
                    }
                }
                IconButton {
                    icon: Icons.align-right;
                    tip: @tr("Do prawej (Ctrl+R)");
                    active: App.align == 2;
                    size: 26px;
                    clicked => {
                        App.cmd("align", "2");
                    }
                }
                IconButton {
                    icon: Icons.align-justify;
                    tip: @tr("Wyjustuj (Ctrl+J)");
                    active: App.align == 3;
                    size: 26px;
                    clicked => {
                        App.cmd("align", "3");
                    }
                }
                MenuButton {
                    icon: Icons.move-vertical;
                    label: App.line-spacing;
                    tip: @tr("Interlinia i odstępy akapitu");
                    items: Menus.spacing;
                    menu-w: 240px;
                    picked(id) => {
                        App.cmd("line-spacing", id);
                    }
                }
                ColorPick {
                    icon: Icons.paint-bucket;
                    current: App.shading;
                    tip: @tr("Cieniowanie akapitu");
                    apply => {
                        App.cmd("shading", "current");
                    }
                    picked(c) => {
                        App.shading = c;
                        App.cmd("shading", "current");
                    }
                }
            }
            Row {
                IconButton {
                    icon: Icons.list-tree;
                    tip: @tr("Lista wielopoziomowa (1. / 1.1. / 1.1.1.) – poziom zmieniasz klawiszem Tab");
                    active: App.list-kind == "multi";
                    size: 26px;
                    clicked => {
                        App.cmd("list", App.list-kind == "multi" ? "" : "multi");
                    }
                }
                MenuButton {
                    icon: Icons.rows-3;
                    label: "";
                    tip: @tr("Sortuj zaznaczone akapity alfabetycznie");
                    items: Menus.sort;
                    menu-w: 170px;
                    picked(id) => {
                        App.cmd("sort", id);
                    }
                }
                MenuButton {
                    icon: Icons.square;
                    label: "";
                    tip: @tr("Obramowanie akapitu");
                    items: Menus.borders;
                    menu-w: 190px;
                    picked(id) => {
                        App.cmd("para-border", id);
                    }
                }
                IconButton {
                    icon: Icons.arrow-up-from-line;
                    tip: @tr("Odstęp przed akapitem +6 pt");
                    size: 26px;
                    clicked => {
                        App.cmd("space-before-step", "3");
                    }
                }
                IconButton {
                    icon: Icons.arrow-down-to-line;
                    tip: @tr("Odstęp po akapicie +6 pt");
                    size: 26px;
                    clicked => {
                        App.cmd("space-after-step", "3");
                    }
                }
                IconButton {
                    icon: Icons.between-horizontal-start;
                    tip: @tr("Usuń odstępy przed i po akapicie");
                    size: 26px;
                    clicked => {
                        App.cmd("space-before", "0");
                        App.cmd("space-after", "0");
                    }
                }
                IconButton {
                    icon: Icons.letter-text;
                    tip: @tr("Inicjał – duża pierwsza litera na 3 wiersze");
                    active: App.drop-cap;
                    size: 26px;
                    clicked => {
                        App.cmd("drop-cap", "");
                    }
                }
            }
        }
    }
    Group {
        title: @tr("Style");
        StyleGallery {
            cols: Theme.ribbon-level >= 2 ? 2 : root.avail >= 1600px * Theme.scale ? 5 : root.avail >= 1500px * Theme.scale ? 4 : 3;
        }
        Col {
            IconButton {
                icon: Icons.plus;
                tip: @tr("Utwórz styl z zaznaczenia");
                size: 24px;
                clicked => {
                    App.cmd("style-new", "");
                }
            }
            IconButton {
                icon: Icons.refresh-cw;
                tip: @tr("Aktualizuj bieżący styl według zaznaczenia");
                size: 24px;
                clicked => {
                    App.cmd("style-update", "");
                }
            }
        }
    }
    Group {
        title: @tr("Edycja");
        last: true;
        Col {
            RowButton {
                icon: Icons.search;
                label: @tr("Znajdź");
                tip: @tr("Znajdź (Ctrl+F)");
                clicked => {
                    App.cmd("find", "");
                }
            }
            RowButton {
                icon: Icons.replace;
                label: @tr("Zamień");
                tip: @tr("Zamień (Ctrl+H)");
                clicked => {
                    App.cmd("replace", "");
                }
            }
            RowButton {
                icon: Icons.text-select;
                label: @tr("Zaznacz wszystko");
                tip: @tr("Zaznacz cały tekst (Ctrl+A)");
                clicked => {
                    App.cmd("select-all", "");
                }
            }
        }
        Col {
            MenuButton {
                icon: Icons.arrow-right;
                label: @tr("Przejdź do");
                tip: @tr("Przejdź do strony, nagłówka albo komentarza");
                items: Menus.goto;
                menu-w: 210px;
                picked(id) => {
                    App.cmd("goto", id);
                }
            }
        }
    }
}

component InsertTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("AI");
        optional: true;
        BigButton {
            icon: Icons.wand-sparkles;
            label: @tr("Generuj z AI");
            tip: @tr("Opisz dokument, a sztuczna inteligencja go napisze i złoży z formatowaniem");
            tint: Theme.accent;
            clicked => {
                App.cmd("ai", "");
            }
        }
    }
    Group {
        title: @tr("Strony");
        BigButton {
            icon: Icons.file-plus;
            label: @tr("Pusta strona");
            tip: @tr("Dodaj pustą stronę na obiekty");
            clicked => {
                App.cmd("page-blank", "");
            }
        }
        Col {
            RowButton {
                icon: Icons.separator-horizontal;
                label: @tr("Podział strony");
                tip: @tr("Podział strony (Ctrl+Enter)");
                clicked => {
                    App.cmd("page-break", "");
                }
            }
            RowButton {
                icon: Icons.columns-2;
                label: @tr("Podział kolumny");
                tip: @tr("Następny tekst od nowej kolumny (Ctrl+Shift+Enter)");
                clicked => {
                    App.cmd("column-break", "");
                }
            }
            RowButton {
                icon: Icons.square-split-vertical;
                label: @tr("Podział sekcji");
                tip: @tr("Podział sekcji – dalsza treść od nowej strony, z własnymi kolumnami i orientacją");
                clicked => {
                    App.cmd("section-new", "page");
                }
            }
        }
        BigMenuButton {
            icon: Icons.book-open;
            label: @tr("Strona tytułowa");
            tip: @tr("Wstaw stronę tytułową na początek dokumentu – tytuł, temat i autor z metadanych");
            items: [
                { id: "classic", label: @tr("Klasyczna – wyśrodkowana") },
                { id: "band", label: @tr("Pas koloru u góry") },
                { id: "minimal", label: @tr("Minimalna – tytuł na dole") },
            ];
            menu-w: 230px;
            picked(id) => {
                App.cmd("cover", id);
            }
        }
        BigMenuButton {
            icon: Icons.droplet;
            label: @tr("Znak wodny");
            tip: @tr("Ukośny napis w tle każdej strony");
            active: App.watermark != "";
            items: [
                { id: "POUFNE", label: @tr("POUFNE") },
                { id: "PROJEKT", label: @tr("PROJEKT") },
                { id: "KOPIA", label: @tr("KOPIA") },
                { id: "WZÓR", label: @tr("WZÓR") },
                { id: "PILNE", label: @tr("PILNE") },
                { id: "-" },
                { id: "custom", label: @tr("Własny napis…"), icon: Icons.square-pen },
                { id: "none", label: @tr("Usuń znak wodny"), icon: Icons.x },
            ];
            menu-w: 210px;
            picked(id) => {
                if id == "custom" {
                    App.tab = 3;
                } else if id == "none" {
                    App.cmd("watermark", "");
                } else {
                    App.cmd("watermark", id);
                }
            }
        }
    }
    Group {
        title: @tr("Ilustracje");
        BigMenuButton {
            icon: Icons.image;
            label: @tr("Obraz");
            tip: @tr("Wstaw obraz z pliku (PNG, JPEG, WebP, GIF, BMP) albo grafikę wektorową SVG");
            menu-w: 300px;
            items: [
                { id: "image", label: @tr("Osadzony – kopia w dokumencie"), hint: @tr("jeden plik .odtp"), icon: Icons.image },
                { id: "image-link", label: @tr("Linkowany – łącze do pliku"), hint: @tr("zmiany w pliku widać od razu"), icon: Icons.link },
                { id: "-" },
