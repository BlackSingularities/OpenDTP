                }
            }
        }
        MarginPreview {}
        Col {
            IconSpin {
                icon: Icons.arrow-right-from-line;
                tip: @tr("Margines lewy");
                value: App.m-left;
                unit: App.unit;
                w: 92px;
                changed-value(v) => {
                    App.cmd("m-left", v);
                }
                step(d) => {
                    App.cmd("m-left-step", d);
                }
            }
            IconSpin {
                icon: Icons.arrow-left-to-line;
                tip: @tr("Margines prawy");
                value: App.m-right;
                unit: App.unit;
                w: 92px;
                changed-value(v) => {
                    App.cmd("m-right", v);
                }
                step(d) => {
                    App.cmd("m-right-step", d);
                }
            }
        }
    }
    Group {
        title: @tr("Sekcje");
        BigButton {
            icon: Icons.file-plus;
            label: @tr("Nowa sekcja");
            tip: @tr("Podział sekcji – dalsza treść od nowej strony, z własnymi kolumnami i orientacją");
            clicked => {
                App.cmd("section-new", "page");
            }
        }
        Col {
            RowButton {
                icon: Icons.separator-horizontal;
                label: @tr("Ciągła");
                tip: @tr("Podział sekcji na tej samej stronie – np. zmiana liczby kolumn");
                clicked => {
                    App.cmd("section-new", "cont");
                }
            }
            RowButton {
                icon: Icons.x;
                label: @tr("Usuń podział");
                enabled: App.in-section;
                tip: @tr("Scal tę sekcję z poprzednią");
                clicked => {
                    App.cmd("section-remove", "");
                }
            }
        }
    }
    Group {
        title: App.in-section ? @tr("Kolumny sekcji") : @tr("Kolumny");
        BigButton {
            icon: Icons.file-text;
            label: @tr("Jedna");
            tip: @tr("Jedna kolumna");
            active: App.columns == 1;
            clicked => {
                App.cmd("columns", 1);
            }
        }
        BigMenuButton {
            icon: App.columns == 3 ? Icons.columns-3 : App.columns >= 4 ? Icons.columns-4 : Icons.columns-2;
            label: App.columns > 1 ? @tr("Kolumny: {}", App.columns) : @tr("Wiele");
            tip: @tr("Tekst w kilku kolumnach");
            active: App.columns > 1;
            current: App.columns;
            items: [
                { id: "2", label: @tr("Dwie kolumny"), icon: Icons.columns-2 },
                { id: "3", label: @tr("Trzy kolumny"), icon: Icons.columns-3 },
                { id: "4", label: @tr("Cztery kolumny"), icon: Icons.columns-4 },
                { id: "5", label: @tr("Pięć kolumn") },
                { id: "6", label: @tr("Sześć kolumn") },
            ];
            menu-w: 200px;
            picked(id) => {
                App.cmd("columns", id);
            }
        }
        Col {
            Spin {
                label: @tr("Odstęp");
                tip: @tr("Odstęp między kolumnami");
                value: App.col-gap;
                unit: App.unit;
                w: 80px;
                changed-value(v) => {
                    App.cmd("col-gap", v);
                }
                step(d) => {
