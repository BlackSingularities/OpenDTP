                { id: "header-edit", label: @tr("Edytuj nagłówek"), icon: Icons.square-pen },
                { id: "header-remove", label: @tr("Usuń nagłówek z tej sekcji"), icon: Icons.trash-2 },
            ] : [
                { id: "header-edit", label: @tr("Dodaj nagłówek"), icon: Icons.plus },
            ];
            menu-w: 240px;
            picked(id) => {
                App.cmd(id, "");
            }
        }
        BigMenuButton {
            icon: Icons.panel-bottom;
            label: @tr("Stopka");
            tip: @tr("Tekst u dołu każdej strony (z numerem strony)");
            active: App.has-footer;
            items: App.has-footer ? [
                { id: "footer-edit", label: @tr("Edytuj stopkę"), icon: Icons.square-pen },
                { id: "footer-remove", label: @tr("Usuń stopkę z tej sekcji"), icon: Icons.trash-2 },
            ] : [
                { id: "footer-edit", label: @tr("Dodaj stopkę"), icon: Icons.plus },
            ];
            menu-w: 240px;
            picked(id) => {
                App.cmd(id, "");
            }
        }
        Col {
            RowButton {
                icon: Icons.files;
                label: @tr("Inna pierwsza strona");
                tip: @tr("Osobny nagłówek i stopka na pierwszej stronie");
                active: App.diff-first;
                clicked => {
                    App.cmd("diff-first", "");
                }
            }
            RowButton {
                icon: Icons.book-open;
                label: @tr("Inne parzyste");
                tip: @tr("Osobny nagłówek i stopka stron parzystych – układ lustrzany jak w książce");
                active: App.odd-even;
                clicked => {
                    App.cmd("odd-even", "");
                }
            }
            MenuButton {
                icon: Icons.heading;
                label: @tr("Tytuł rozdziału");
                tip: @tr("Wstaw do nagłówka tytuł bieżącego rozdziału – zmienia się sam na każdej stronie");
                items: [
                    { id: "1", label: @tr("Rozdział (Nagłówek 1)") },
                    { id: "2", label: @tr("Podrozdział (Nagłówek 2)") },
                    { id: "3", label: @tr("Punkt (Nagłówek 3)") },
                ];
                menu-w: 240px;
                picked(id) => {
                    App.cmd("running-head", id);
                }
            }
        }
    }
    Group {
        title: @tr("Biblioteka");
        optional: true;
        last: true;
        BigButton {
            icon: Icons.book-a;
            label: @tr("Biblioteka");
            tip: @tr("Panel z zapisanymi fragmentami tekstu i obiektami do wstawienia");
            active: App.left-panel == "library";
            clicked => {
                App.cmd("panel", "library");
            }
        }
        Col {
            RowButton {
                icon: Icons.plus;
                label: @tr("Zapisz zaznaczenie");
                tip: @tr("Zapisz zaznaczony tekst albo obiekty do ponownego użycia w innych dokumentach");
                clicked => {
                    App.cmd("lib-save", "");
                }
            }
        }
    }
}

/// Miniatura strony z obszarem tekstu – proporcje kartki i marginesów na żywo.
component MarginPreview inherits Rectangle {
    width: 52px * Theme.scale;
    height: 66px * Theme.scale;
    property <length> pw: App.page-aspect >= 1 ? 46px * Theme.scale : 60px * Theme.scale * App.page-aspect;
    property <length> ph: App.page-aspect >= 1 ? 46px * Theme.scale / App.page-aspect : 60px * Theme.scale;
    Rectangle {
        x: (parent.width - root.pw) / 2;
        y: (parent.height - root.ph) / 2;
        width: root.pw;
        height: root.ph;
        border-radius: 2px;
        background: #ffffff;
        border-width: 1px;
        border-color: Theme.line;
        Rectangle {
            x: parent.width * App.m-frac-l;
            y: parent.height * App.m-frac-t;
            width: max(2px, parent.width * (1 - App.m-frac-l - App.m-frac-r));
            height: max(2px, parent.height * (1 - App.m-frac-t - App.m-frac-b));
            background: Theme.accent.with-alpha(0.14);
            border-width: 1px;
            border-color: Theme.accent;
            // Kilka „wierszy tekstu” – od razu widać, ile miejsca zostaje.
            for i in [0, 1, 2, 3, 4, 5]: Rectangle {
                x: 2px;
                y: 3px + i * 4px;
                width: (parent.width - 4px) * (i == 5 ? 0.6 : 1);
                height: 1.5px;
                visible: self.y + 2px < parent.height;
                background: Theme.accent.with-alpha(0.55);
            }
        }
    }
    TipArea {
        tip: @tr("Podgląd marginesów – obszar tekstu na stronie");
    }
}

component LayoutTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("Strona");
        launcher-tip: @tr("Ustawienia strony – papier, marginesy, kolumny");
        launcher-icon: Icons.file;
        launch => {
            App.cmd("page-dialog", "");
        }
        BigMenuButton {
            icon: Icons.file;
            label: App.page-size;
            tip: @tr("Rozmiar strony");
            items: Menus.page-sizes;
            current: App.page-size;
            menu-w: 230px;
            picked(id) => {
                App.cmd("page-size", id);
            }
        }
        BigButton {
            icon: App.landscape ? Icons.rectangle-horizontal : Icons.rectangle-vertical;
            label: App.landscape ? @tr("Pozioma") : @tr("Pionowa");
            tip: @tr("Orientacja strony");
            clicked => {
                App.cmd("orientation", "");
            }
        }
        BigMenuButton {
            icon: Icons.square-dashed;
            label: @tr("Marginesy");
            tip: @tr("Gotowe marginesy");
            items: Menus.margins;
            menu-w: 240px;
            picked(id) => {
                App.cmd("margins", id);
            }
        }
        // Marginesy: pola z ikonami krawędzi wokół miniatury strony, która pokazuje obszar tekstu.
        Col {
            IconSpin {
                icon: Icons.arrow-up-from-line;
                tip: @tr("Margines górny");
                value: App.m-top;
                unit: App.unit;
                w: 92px;
                changed-value(v) => {
                    App.cmd("m-top", v);
                }
