// Wstążka: karty z grupami poleceń. Każde polecenie to `App.cmd(id, argument)`; stan przycisków
// (pogrubienie, wyrównanie, opływanie…) pochodzi z formatowania w miejscu kursora.

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, ItemV, StyleV } from "state.slint";
import { TipArea, IconButton, BigButton, RowButton, Group, Col, Row, Field, Spin, Switch, Swatch, MenuItem, MenuSep, Card, Segmented, Slider, Label, Dim, IconSpin } from "widgets.slint";

// ---------------------------------------------------------------- próbnik kolorów

export global Colors {
    out property <[color]> theme: [
        #ffffff, #000000, #e7e6e6, #44546a, #4472c4, #ed7d31, #a5a5a5, #ffc000, #5b9bd5, #70ad47,
        #f2f2f2, #7f7f7f, #d0cece, #d6dce4, #d9e2f3, #fbe5d5, #ededed, #fff2cc, #deebf6, #e2efd9,
        #d8d8d8, #595959, #aeabab, #adb9ca, #b4c6e7, #f7cbac, #dbdbdb, #fee599, #bdd7ee, #c5e0b3,
        #bfbfbf, #3f3f3f, #757070, #8496b0, #8eaadb, #f4b183, #c9c9c9, #ffd965, #9cc3e5, #a8d08d,
        #a5a5a5, #262626, #3a3838, #323f4f, #2f5496, #c55a11, #7b7b7b, #bf8f00, #2e75b5, #538135,
        #c00000, #ff0000, #ffc000, #ffff00, #92d050, #00b050, #00b0f0, #0070c0, #002060, #7030a0,
    ];
}

export component ColorPick inherits Rectangle {
    in property <image> icon;
    in property <color> current;
    in property <string> tip;
    in property <bool> allow-none: true;
    in property <bool> big;
    callback picked(color);
    callback apply();
    width: root.big ? 52px : 40px;
    height: root.big ? 66px : 26px;
    border-radius: Theme.r-small;
    background: ta.has-hover || tb.has-hover ? Theme.hover : transparent;
    HorizontalLayout {
        Rectangle {
            Image {
                y: root.big ? 10px : 3px;
                source: root.icon;
                width: root.big ? 24px : 15px;
                height: root.big ? 24px : 15px;
                colorize: Theme.text;
            }
            Rectangle {
                y: root.big ? 38px : 19px;
                width: root.big ? 28px : 16px;
                height: 3px;
                background: root.current;
                border-width: root.current.alpha == 0 ? 1px : 0;
                border-color: Theme.line-strong;
            }
            ta := TipArea {
                tip: root.tip;
                clicked => {
                    root.apply();
                }
            }
        }
        Rectangle {
            width: 12px;
            Image {
                source: Icons.chevron-down;
                width: 10px;
                height: 10px;
                colorize: Theme.text-dim;
            }
            tb := TipArea {
                tip: root.tip;
                clicked => {
                    pop.show();
                }
            }
        }
    }
    pop := PopupWindow {
        x: 0;
        y: root.height + 2px;
        close-policy: close-on-click-outside;
        Card {
            width: 10 * 22px + 24px;
            height: vl.preferred-height;
            vl := VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Dim {
                    text: @tr("Kolory motywu i podstawowe");
                }
                for rowi in 6: HorizontalLayout {
                    spacing: 4px;
                    for coli in 10: Swatch {
                        swatch: Colors.theme[rowi * 10 + coli];
                        tip: "";
                        clicked => {
                            root.picked(self.swatch);
                            pop.close();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    if root.allow-none: Rectangle {
                        width: none-t.preferred-width + 16px;
                        height: 24px;
                        border-radius: Theme.r-small;
                        background: nta.has-hover ? Theme.hover : Theme.raised;
                        none-t := Text {
                            text: @tr("Brak");
                            font-size: Theme.fs-small;
                            color: Theme.text;
                        }
                        nta := TipArea {
                            tip: @tr("Bez koloru");
                            clicked => {
                                root.picked(#00000000);
                                pop.close();
                            }
                        }
                    }
                    hex := Field {
                        w: 90px;
                        placeholder: "#rrggbb";
                        tip: @tr("Własny kolor szesnastkowo");
                        accepted(t) => {
                            App.cmd("color-hex-check", t);
                        }
                    }
                    Rectangle {
                        width: ok-t.preferred-width + 16px;
                        height: 24px;
                        border-radius: Theme.r-small;
                        background: Theme.accent;
                        ok-t := Text {
                            text: @tr("Użyj");
                            font-size: Theme.fs-small;
                            color: Theme.accent-text;
                        }
                        TipArea {
                            tip: @tr("Użyj wpisanego koloru");
                            clicked => {
                                if (hex.text != "") {
                                    App.cmd("pick-hex", hex.text);
                                    pop.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------- listy rozwijane

/// Przycisk otwierający menu z listą pozycji (id, podpis).
export component MenuButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> tip;
    in property <[ItemV]> items;
    in property <bool> active;
    in property <string> current;
    in property <length> menu-w: 220px;
    in property <bool> compactable: true;
    callback picked(string);
    min-width: rb.min-width;
    height: 24px * Theme.scale;
    rb := RowButton {
        compactable: root.compactable;
        width: parent.width;
        icon: root.icon;
        label: root.label;
        tip: root.tip;
        menu: true;
        active: root.active;
        clicked => {
            pop.show();
        }
    }
    pop := PopupWindow {
        x: 0;
        y: root.height + 2px;
        Card {
            width: root.menu-w;
            height: min(vl.preferred-height, 460px, max(160px, App.win-h - root.absolute-position.y - root.height - 14px));
            ScrollView {
                vl := VerticalLayout {
                    padding: 5px;
                    for it in root.items: Rectangle {
                        height: it.id == "-" ? 9px : 28px * Theme.scale;
                        if it.id == "-": MenuSep {
                            width: parent.width;
                        }
                        if it.id != "-": MenuItem {
                            width: parent.width;
                            label: it.label;
                            hint: it.hint;
                            icon: it.icon;
                            checked: it.checked || (root.current != "" && it.id == root.current);
                            font-family: it.font != "" ? it.font : Theme.font;
                            font-size: it.font != "" ? 14px : Theme.fs;
                            clicked => {
                                root.picked(it.id);
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Duży przycisk wstążki z menu.
export component BigMenuButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> tip;
    in property <[ItemV]> items;
    in property <bool> active;
    in property <string> current;
    in property <length> menu-w: 220px;
    in property <color> tint: Theme.text;
    callback picked(string);
    min-width: bb.min-width;
    height: 66px * Theme.scale;
    bb := BigButton {
        width: parent.width;
        icon: root.icon;
        label: root.label;
        tip: root.tip;
        tint: root.tint;
        menu: true;
        active: root.active;
        clicked => {
            pop.show();
        }
    }
    pop := PopupWindow {
        x: 0;
        y: root.height + 2px;
        Card {
            width: root.menu-w;
            height: min(vl.preferred-height, 460px, max(160px, App.win-h - root.absolute-position.y - root.height - 14px));
            ScrollView {
                vl := VerticalLayout {
                    padding: 5px;
                    for it in root.items: Rectangle {
                        height: it.id == "-" ? 9px : 28px * Theme.scale;
                        if it.id == "-": MenuSep {
                            width: parent.width;
                        }
                        if it.id != "-": MenuItem {
                            width: parent.width;
                            label: it.label;
                            hint: it.hint;
                            icon: it.icon;
                            checked: it.checked || (root.current != "" && it.id == root.current);
                            font-family: it.font != "" ? it.font : Theme.font;
                            font-size: it.font != "" ? 14px : Theme.fs;
                            clicked => {
                                root.picked(it.id);
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Wybór czcionki: pole z nazwą i lista rodzin pisana ich własnym krojem.
export component FontBox inherits Rectangle {
    width: 170px * Theme.scale;
    height: 24px * Theme.scale;
    border-radius: Theme.r-small;
    background: Theme.raised;
    border-width: 1px;
    border-color: fta.has-hover ? Theme.line-strong : Theme.line;
    Text {
        x: 8px;
        width: parent.width - 26px;
        text: App.font;
        font-family: App.font;
        font-size: Theme.fs;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
        height: parent.height;
    }
    Image {
        x: parent.width - 16px;
        y: (parent.height - self.height) / 2;
        source: Icons.chevron-down;
        width: 10px;
        height: 10px;
        colorize: Theme.text-dim;
    }
    fta := TipArea {
        tip: @tr("Czcionka – lista krojów zainstalowanych w systemie");
        clicked => {
            App.font-query("");
            pop.show();
        }
    }
    pop := PopupWindow {
        x: 0;
        y: root.height + 2px;
        close-policy: close-on-click-outside;
        Card {
            width: 300px;
            height: min(440px, max(160px, App.win-h - root.absolute-position.y - root.height - 14px));
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                search := Field {
                    tip: @tr("Wpisz część nazwy czcionki, aby zawęzić listę");
                    init => {
                        self.focus-input();
                    }
                    w: 284px;
                    placeholder: @tr("Szukaj czcionki…");
                    edited(t) => {
                        App.font-query(t);
                    }
                    accepted(t) => {
                        if (App.fonts.length > 0) {
                            App.cmd("font", App.fonts[0].id);
                            pop.close();
                        }
                    }
                }
                if App.recent-fonts.length > 0: VerticalLayout {
                    Dim {
                        text: @tr("Ostatnio używane");
                    }
                    for f in App.recent-fonts: MenuItem {
                        label: f.label;
                        font-family: f.id;
                        font-size: 14px;
                        checked: f.id == App.font;
                        clicked => {
                            App.cmd("font", f.id);
                            pop.close();
                        }
                    }
                    MenuSep {}
                }
                ListView {
                    for f in App.fonts: MenuItem {
                        label: f.label;
                        font-family: f.id;
                        font-size: 14px;
                        checked: f.id == App.font;
                        clicked => {
                            App.cmd("font", f.id);
                            pop.close();
                        }
                    }
                }
            }
        }
    }
}

export component SizeBox inherits Rectangle {
    width: 58px * Theme.scale;
    height: 24px * Theme.scale;
    border-radius: Theme.r-small;
    background: Theme.raised;
    border-width: 1px;
    border-color: inp.has-focus ? Theme.accent : Theme.line;
    inp := TextInput {
        x: 6px;
        width: parent.width - 22px;
        text: App.size;
        font-family: Theme.font;
        font-size: Theme.fs;
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
        accepted => {
            App.cmd("size", self.text);
        }
    }
    Rectangle {
        x: parent.width - 16px;
        width: 16px;
        Image {
            source: Icons.chevron-down;
            width: 10px;
            height: 10px;
            colorize: Theme.text-dim;
        }
        TipArea {
            tip: @tr("Rozmiar czcionki (pt)");
            clicked => {
                pop.show();
            }
        }
    }
    pop := PopupWindow {
        x: 0;
        y: root.height + 2px;
        Card {
            width: 80px;
            height: min(360px, max(160px, App.win-h - root.absolute-position.y - root.height - 14px));
            ListView {
                for s in ["8", "9", "10", "10,5", "11", "12", "14", "16", "18", "20", "22", "24", "28", "32", "36", "40", "48", "54", "60", "72", "96"]: MenuItem {
                    label: s;
                    checked: App.size == s;
                    clicked => {
                        App.cmd("size", s);
                    }
                }
            }
        }
    }
}

/// Galeria stylów akapitu (próbki pisane stylem).
export component StyleGallery inherits Rectangle {
    // Liczba stylów w wierszu – na szerszych oknach więcej (3–5).
    in property <int> cols: 3;
    width: root.cols * 101px * Theme.scale + 24px;
    height: 66px * Theme.scale;
    property <length> item: 101px * Theme.scale;
    HorizontalLayout {
        spacing: 3px;
        fl := Flickable {
            width: root.cols * root.item;
            content-width: App.styles.length * root.item;
            interactive: false;
            for s[i] in App.styles: Rectangle {
                x: i * root.item;
                width: root.item - 3px;
                height: parent.height;
                border-radius: Theme.r-small;
                background: s.id == App.style-id ? Theme.accent-soft : sta.has-hover ? Theme.hover : Theme.raised;
                border-width: 1px;
                border-color: s.id == App.style-id ? Theme.accent : Theme.line;
                Rectangle {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 22px;
                    border-radius: 3px;
                    background: s.shade.alpha > 0 ? s.shade : #ffffff;
                    Text {
                        x: 5px;
                        width: parent.width - 10px;
                        text: "AaBbĆć";
                        font-family: s.font;
                        font-size: min(s.size, 20px);
                        font-weight: s.bold ? 700 : 400;
                        font-italic: s.italic;
                        color: s.color;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
                Text {
                    y: parent.height - 17px;
                    x: 6px;
                    width: parent.width - 12px;
                    text: s.name;
                    font-family: Theme.font;
                    font-size: 10px * Theme.scale;
                    color: Theme.text-dim;
                    overflow: elide;
                    horizontal-alignment: center;
                }
                sta := TipArea {
                    tip: @tr("Styl: {}", s.name);
                    clicked => {
                        App.cmd("style", s.id);
                    }
                }
            }
        }
        VerticalLayout {
            width: 20px;
            spacing: 2px;
            IconButton {
                size: 20px;
                icon-size: 12px;
                icon: Icons.chevron-up;
                tip: @tr("Poprzednie style");
                enabled: fl.content-x < 0;
                clicked => {
                    fl.content-x = min(0px, fl.content-x + root.cols * root.item);
                }
            }
            IconButton {
                size: 20px;
                icon-size: 12px;
                icon: Icons.chevron-down;
                tip: @tr("Kolejne style");
                enabled: -fl.content-x + root.cols * root.item < App.styles.length * root.item;
                clicked => {
                    fl.content-x = max(-(App.styles.length * root.item - root.cols * root.item), fl.content-x - root.cols * root.item);
                }
            }
            IconButton {
                size: 20px;
                icon-size: 12px;
                icon: Icons.panel-right;
                tip: @tr("Panel stylów");
                clicked => {
                    App.cmd("panel", "styles");
                }
            }
        }
    }
}

