component ViewTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("Powiększenie");
        BigButton {
            icon: Icons.zoom-out;
            label: @tr("Pomniejsz");
            tip: @tr("Pomniejsz (Ctrl+−, Ctrl+kółko)");
            clicked => {
                App.cmd("zoom-out", "");
            }
        }
        BigButton {
            icon: Icons.zoom-in;
            label: @tr("Powiększ");
            tip: @tr("Powiększ (Ctrl++, Ctrl+kółko)");
            clicked => {
                App.cmd("zoom-in", "");
            }
        }
        Col {
            RowButton {
                icon: Icons.scan;
                label: "100%";
                clicked => {
                    App.cmd("zoom", "100");
                }
            }
            RowButton {
                icon: Icons.move-horizontal;
                label: @tr("Szerokość strony");
                clicked => {
                    App.cmd("zoom", "width");
                }
            }
            RowButton {
                icon: Icons.file;
                label: @tr("Cała strona");
                clicked => {
                    App.cmd("zoom", "page");
                }
            }
        }
    }
    Group {
        title: @tr("Pokaż");
        Col {
            Switch {
                label: @tr("Znaki formatowania");
                on: App.marks;
                toggled => {
                    App.cmd("marks", "");
                }
            }
            Switch {
                label: @tr("Linijka");
                tip: @tr("Linijka z suwakami wcięć i tabulatorami");
                on: App.ruler-on;
                toggled => {
                    App.cmd("ruler-toggle", "");
                }
            }
            Switch {
                label: @tr("Linie pomocnicze");
                tip: @tr("Marginesy, kolumny i kontury ramek");
                on: App.guides;
                toggled => {
                    App.cmd("guides", "");
                }
            }
            Switch {
                label: @tr("Nawigator");
                on: App.left-panel == "nav";
                toggled => {
                    App.cmd("panel", "nav");
                }
            }
        }
    }
    Group {
        title: @tr("Interfejs");
        last: true;
        Col {
            Segmented {
                items: ["AMOLED", @tr("Grafit"), @tr("Jasny")];
                current: Theme.mode;
                tip: @tr("Motyw interfejsu");
                picked(i) => {
                    App.cmd("theme", i);
                }
            }
            Switch {
                label: @tr("Zwinięta wstążka");
                on: App.ribbon-collapsed;
                toggled => {
                    App.cmd("ribbon-collapse", "");
                }
            }
        }
        BigButton {
            icon: App.fullscreen ? Icons.minimize : Icons.maximize;
            label: @tr("Pełny ekran");
            tip: @tr("Pełny ekran (F11)");
            active: App.fullscreen;
            clicked => {
                App.cmd("fullscreen", "");
            }
        }
        BigButton {
            icon: Icons.settings;
            label: @tr("Ustawienia");
            clicked => {
                App.cmd("settings", "");
            }
        }
    }
}

component CustomTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("Moje polecenia");
        last: true;
        for c in App.custom-tab: BigButton {
            icon: c.icon;
            label: c.label;
            tip: c.hint != "" ? c.label + " (" + c.hint + ")" : c.label;
            clicked => {
                App.cmd(c.id, "");
            }
        }
        BigButton {
            icon: Icons.plus;
            label: @tr("Dostosuj");
            tip: @tr("Wybierz polecenia tej karty");
            clicked => {
                App.cmd("customize", "tab");
            }
        }
    }
}

export component RibbonTabs inherits Rectangle {
    height: 34px * Theme.scale;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 2px;
        alignment: start;
        Rectangle {
            width: ft.preferred-width + 24px;
            height: 26px * Theme.scale;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.r-small;
            background: fta.pressed ? Theme.accent.darker(0.15) : Theme.accent;
            ft := Text {
                text: @tr("Plik");
                font-family: Theme.font;
                font-size: Theme.fs;
                font-weight: 600;
                color: Theme.accent-text;
            }
            fta := TipArea {
                tip: @tr("Nowy, otwórz, zapisz, eksport, ustawienia (Alt+F)");
                clicked => {
                    App.cmd("backstage", "");
                }
            }
        }
        for t[i] in [@tr("Narzędzia główne"), @tr("Wstawianie"), @tr("Projekt"), @tr("Układ"), @tr("Kształty tekstu"), @tr("Odwołania"), @tr("Recenzja"), @tr("Widok"), @tr("Moja karta")]: Rectangle {
            width: tt.preferred-width + 22px;
            tt := Text {
                text: t;
                font-family: Theme.font;
                font-size: Theme.fs;
                font-weight: App.tab == i ? 600 : 400;
                color: App.tab == i ? Theme.text : tta.has-hover ? Theme.text : Theme.text-dim;
            }
            if i == 4: Rectangle {
                x: parent.width - 9px;
                y: 7px;
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                background: Theme.accent;
            }
            Rectangle {
                y: parent.height - 3px;
                height: 2px;
                width: App.tab == i ? parent.width - 14px : 0;
                border-radius: 1px;
                background: Theme.accent;
                animate width { duration: 140ms; easing: ease-out; }
            }
            tta := TipArea {
                tip: i == 4 ? @tr("Kształty tekstu: tekst w dowolnym konturze z węzłów, opływanie, łączenie ramek") : "";
                clicked => {
                    if (App.ribbon-collapsed && App.tab == i) {
                        App.ribbon-peek = !App.ribbon-peek;
                    } else {
                        App.tab = i;
                        App.ribbon-peek = App.ribbon-collapsed;
                    }
                }
            }
        }
    }
}

export component RibbonBody inherits Rectangle {
    height: Theme.ribbon-h;
    background: Theme.panel;
    Flickable {
        content-width: max(self.width, hl.preferred-width);
        content-height: self.height;
        hl := HorizontalLayout {
            height: Theme.ribbon-h;
            padding-left: 6px;
            padding-right: 6px;
            alignment: start;
            if App.tab == 0: HomeTab {}
            if App.tab == 1: InsertTab {}
            if App.tab == 2: DesignTab {}
            if App.tab == 3: LayoutTab {}
            if App.tab == 4: ShapesTab {}
            if App.tab == 5: RefsTab {}
            if App.tab == 6: ReviewTab {}
            if App.tab == 7: ViewTab {}
            if App.tab == 8: CustomTab {}
        }
    }
}
