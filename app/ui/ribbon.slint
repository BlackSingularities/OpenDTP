    ];
    out property <[ItemV]> page-sizes: [
        { id: "A4", label: "A4  ·  210 × 297 mm" }, { id: "A5", label: "A5  ·  148 × 210 mm" }, { id: "A3", label: "A3  ·  297 × 420 mm" },
        { id: "B5", label: "B5  ·  176 × 250 mm" }, { id: "Letter", label: "Letter  ·  8,5 × 11 in" }, { id: "Legal", label: "Legal  ·  8,5 × 14 in" },
        { id: "A6", label: "A6  ·  105 × 148 mm" }, { id: "DL", label: "DL  ·  99 × 210 mm" }, { id: "Square", label: @tr("Kwadrat  ·  210 × 210 mm") },
    ];
    out property <[ItemV]> margins: [
        { id: "normal", label: @tr("Normalne  ·  25 mm") }, { id: "narrow", label: @tr("Wąskie  ·  12,7 mm") }, { id: "moderate", label: @tr("Umiarkowane  ·  19 / 25 mm") },
        { id: "wide", label: @tr("Szerokie  ·  38 mm") }, { id: "book", label: @tr("Książkowe  ·  20 / 30 mm") }, { id: "none", label: @tr("Bez marginesów (plakat)") },
    ];
    out property <[ItemV]> wraps: [
        { id: "0", label: @tr("Bez opływania (przed tekstem)") },
        { id: "1", label: @tr("Wokół – z obu stron"), icon: Icons.wrap-text },
        { id: "2", label: @tr("Tylko po lewej stronie") },
        { id: "3", label: @tr("Tylko po prawej stronie") },
        { id: "4", label: @tr("Po stronie z większym miejscem") },
        { id: "5", label: @tr("Nad i pod obiektem") },
        { id: "6", label: @tr("Za tekstem") },
    ];
    out property <[ItemV]> zooms: [
        { id: "50", label: "50%" }, { id: "75", label: "75%" }, { id: "100", label: "100%" }, { id: "125", label: "125%" },
        { id: "150", label: "150%" }, { id: "200", label: "200%" }, { id: "300", label: "300%" }, { id: "400", label: "400%" },
        { id: "-" }, { id: "width", label: @tr("Szerokość strony") }, { id: "page", label: @tr("Cała strona") },
    ];
}

// ---------------------------------------------------------------- karty

component HomeTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("AI");
        BigButton {
            icon: Icons.wand-sparkles;
            label: @tr("Generuj");
            tip: @tr("Generuj dokument z AI na podstawie opisu");
            tint: Theme.accent;
            clicked => {
                App.cmd("ai", "");
            }
        }
    }
    Group {
        title: @tr("Schowek");
        BigButton {
            icon: Icons.clipboard-paste;
            label: @tr("Wklej");
            tip: @tr("Wklej (Ctrl+V)");
            clicked => {
                App.cmd("paste", "");
            }
        }
        Col {
            RowButton {
                icon: Icons.scissors;
                label: @tr("Wytnij");
                tip: @tr("Wytnij (Ctrl+X)");
                clicked => {
                    App.cmd("cut", "");
                }
            }
            RowButton {
                icon: Icons.copy;
                label: @tr("Kopiuj");
                tip: @tr("Kopiuj (Ctrl+C)");
                clicked => {
                    App.cmd("copy", "");
                }
            }
            RowButton {
                icon: Icons.paintbrush;
                label: @tr("Malarz");
                tip: @tr("Malarz formatów – skopiuj formatowanie i kliknij tekst docelowy (Ctrl+Shift+C / Ctrl+Shift+V)");
                active: App.tool == 6;
                clicked => {
                    App.cmd("format-painter", "");
                }
            }
        }
    }
    Group {
        title: @tr("Czcionka");
        Col {
            Row {
                FontBox {}
                SizeBox {}
                IconButton {
                    icon: Icons.a-arrow-up;
                    tip: @tr("Powiększ czcionkę (Ctrl+])");
                    size: 24px;
                    clicked => {
                        App.cmd("grow", "");
                    }
                }
                IconButton {
                    icon: Icons.a-arrow-down;
                    tip: @tr("Pomniejsz czcionkę (Ctrl+[)");
                    size: 24px;
                    clicked => {
                        App.cmd("shrink", "");
                    }
                }
                IconButton {
                    icon: Icons.eraser;
                    tip: @tr("Wyczyść formatowanie znaków (Ctrl+Spacja)");
                    size: 24px;
                    clicked => {
                        App.cmd("clear-format", "");
                    }
                }
                IconButton {
                    icon: Icons.sliders-horizontal;
                    tip: @tr("Czcionka – wszystkie ustawienia");
                    size: 24px;
                    clicked => {
                        App.cmd("font-dialog", "");
                    }
                }
            }
            Row {
                IconButton {
                    icon: Icons.bold;
                    tip: @tr("Pogrubienie (Ctrl+B)");
                    active: App.bold;
                    size: 26px;
                    clicked => {
                        App.cmd("bold", "");
                    }
                }
                IconButton {
                    icon: Icons.italic;
                    tip: @tr("Kursywa (Ctrl+I)");
                    active: App.italic;
                    size: 26px;
                    clicked => {
                        App.cmd("italic", "");
                    }
                }
                IconButton {
                    icon: Icons.underline;
                    tip: @tr("Podkreślenie (Ctrl+U)");
                    active: App.underline;
                    size: 26px;
                    clicked => {
                        App.cmd("underline", "");
                    }
                }
                MenuButton {
                    icon: Icons.chevron-down;
                    label: "";
                    tip: @tr("Rodzaj podkreślenia");
                    items: Menus.underline;
                    menu-w: 180px;
                    width: 16px;
                    picked(id) => {
                        App.cmd("underline-kind", id);
                    }
                }
                IconButton {
                    icon: Icons.strikethrough;
                    tip: @tr("Przekreślenie");
                    active: App.strike;
                    size: 26px;
                    clicked => {
                        App.cmd("strike", "");
                    }
                }
                IconButton {
                    icon: Icons.superscript;
                    tip: @tr("Indeks górny (Ctrl+Shift+=)");
                    active: App.sup;
                    size: 26px;
                    clicked => {
                        App.cmd("sup", "");
                    }
                }
                IconButton {
                    icon: Icons.subscript;
                    tip: @tr("Indeks dolny (Ctrl+=)");
                    active: App.sub;
                    size: 26px;
                    clicked => {
                        App.cmd("sub", "");
                    }
                }
                MenuButton {
                    icon: Icons.case-sensitive;
                    label: "";
                    tip: @tr("Wersaliki, kapitaliki i zmiana wielkości liter");
                    items: Menus.caps;
                    active: App.caps > 0;
                    menu-w: 230px;
                    picked(id) => {
                        App.cmd("caps", id);
                    }
                }
                ColorPick {
                    icon: Icons.baseline;
                    current: App.last-color;
                    tip: @tr("Kolor czcionki");
                    allow-none: false;
                    apply => {
                        App.cmd("color", "last");
                    }
                    picked(c) => {
                        App.last-color = c;
                        App.cmd("color", "last");
                    }
                }
                ColorPick {
                    icon: Icons.highlighter;
                    current: App.last-highlight;
                    tip: @tr("Kolor wyróżnienia tekstu");
                    apply => {
                        App.cmd("highlight", "last");
                    }
                    picked(c) => {
                        App.last-highlight = c;
                        App.cmd("highlight", "last");
                    }
                }
            }
        }
    }
    Group {
        title: @tr("Akapit");
        Col {
            Row {
                MenuButton {
                    icon: Icons.list;
                    label: "";
                    tip: @tr("Punktory (listy nienumerowane)");
                    items: Menus.lists;
                    active: App.list-kind != "" && App.list-kind != "number";
                    current: App.list-kind;
                    picked(id) => {
                        App.cmd("list", id);
                    }
                }
                IconButton {
                    icon: Icons.list-ordered;
                    tip: @tr("Numeracja");
                    active: App.list-kind == "number";
                    size: 26px;
                    clicked => {
                        App.cmd("list", App.list-kind == "number" ? "" : "number");
                    }
                }
                IconButton {
                    icon: Icons.list-indent-decrease;
                    tip: @tr("Zmniejsz wcięcie / poziom listy (Shift+Tab)");
                    size: 26px;
                    clicked => {
                        App.cmd("outdent", "");
                    }
                }
                IconButton {
                    icon: Icons.list-indent-increase;
                    tip: @tr("Zwiększ wcięcie / poziom listy (Tab)");
                    size: 26px;
                    clicked => {
                        App.cmd("indent", "");
                    }
                }
                IconButton {
                    icon: Icons.pilcrow;
                    tip: @tr("Pokaż znaki formatowania (Ctrl+*)");
                    active: App.marks;
                    size: 26px;
                    clicked => {
                        App.cmd("marks", "");
                    }
                }
                IconButton {
                    icon: Icons.sliders-vertical;
                    tip: @tr("Akapit – wszystkie ustawienia");
                    size: 26px;
                    clicked => {
                        App.cmd("para-dialog", "");
                    }
                }
            }
            Row {
                IconButton {
                    icon: Icons.align-left;
                    tip: @tr("Do lewej (Ctrl+L)");
                    active: App.align == 0;
                    size: 26px;
                    clicked => {
                        App.cmd("align", "0");
                    }
                }
                IconButton {
                    icon: Icons.align-center;
                    tip: @tr("Wyśrodkuj (Ctrl+E)");
                    active: App.align == 1;
                    size: 26px;
                    clicked => {
                        App.cmd("align", "1");
                    }
                }
                IconButton {
                    icon: Icons.align-right;
                    tip: @tr("Do prawej (Ctrl+R)");
                    active: App.align == 2;
                    size: 26px;
                    clicked => {
                        App.cmd("align", "2");
                    }
                }
                IconButton {
                    icon: Icons.align-justify;
                    tip: @tr("Wyjustuj (Ctrl+J)");
                    active: App.align == 3;
                    size: 26px;
                    clicked => {
                        App.cmd("align", "3");
                    }
                }
                MenuButton {
                    icon: Icons.move-vertical;
                    label: App.line-spacing;
                    tip: @tr("Interlinia i odstępy akapitu");
                    items: Menus.spacing;
                    menu-w: 240px;
                    picked(id) => {
                        App.cmd("line-spacing", id);
                    }
                }
                ColorPick {
                    icon: Icons.paint-bucket;
                    current: App.shading;
                    tip: @tr("Cieniowanie akapitu");
                    apply => {
                        App.cmd("shading", "current");
                    }
                    picked(c) => {
                        App.shading = c;
                        App.cmd("shading", "current");
                    }
                }
            }
        }
    }
    Group {
        title: @tr("Style");
        StyleGallery {}
    }
    Group {
        title: @tr("Edycja");
        last: true;
        Col {
            RowButton {
                icon: Icons.search;
                label: @tr("Znajdź");
                tip: @tr("Znajdź (Ctrl+F)");
                clicked => {
                    App.cmd("find", "");
                }
            }
            RowButton {
                icon: Icons.replace;
                label: @tr("Zamień");
                tip: @tr("Zamień (Ctrl+H)");
                clicked => {
                    App.cmd("replace", "");
                }
            }
            RowButton {
                icon: Icons.text-select;
                label: @tr("Zaznacz wszystko");
                tip: @tr("Zaznacz cały tekst (Ctrl+A)");
                clicked => {
                    App.cmd("select-all", "");
                }
            }
        }
    }
}

component InsertTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("AI");
        BigButton {
            icon: Icons.wand-sparkles;
            label: @tr("Generuj z AI");
            tip: @tr("Opisz dokument, a sztuczna inteligencja go napisze i złoży z formatowaniem");
            tint: Theme.accent;
            clicked => {
                App.cmd("ai", "");
            }
        }
    }
    Group {
        title: @tr("Strony");
        BigButton {
            icon: Icons.file-plus;
            label: @tr("Pusta strona");
            tip: @tr("Dodaj pustą stronę na obiekty");
            clicked => {
                App.cmd("page-blank", "");
            }
        }
        Col {
            RowButton {
                icon: Icons.separator-horizontal;
                label: @tr("Podział strony");
                tip: @tr("Podział strony (Ctrl+Enter)");
                clicked => {
                    App.cmd("page-break", "");
                }
            }
            RowButton {
                icon: Icons.columns-2;
                label: @tr("Podział kolumny");
                tip: @tr("Następny tekst od nowej kolumny (Ctrl+Shift+Enter)");
                clicked => {
                    App.cmd("column-break", "");
                }
            }
        }
    }
    Group {
        title: @tr("Ilustracje");
        BigButton {
            icon: Icons.image;
            label: @tr("Obraz");
            tip: @tr("Wstaw obraz z pliku (PNG, JPEG, WebP, GIF, BMP) albo grafikę wektorową SVG");
            clicked => {
                App.cmd("image", "");
            }
        }
        BigMenuButton {
            icon: Icons.shapes;
            label: @tr("Kształt");
            tip: @tr("Wstaw kształt – przeciągnij na stronie, aby go narysować");
            items: Menus.shapes;
            menu-w: 230px;
            picked(id) => {
                App.cmd("shape", id);
            }
        }
        BigButton {
            icon: Icons.layout-template;
            label: @tr("Tabela");
            tip: @tr("Wstaw tabelę – dane edytujesz w panelu właściwości");
            clicked => {
                App.cmd("table", "");
            }
        }
        BigMenuButton {
            icon: Icons.chart-column;
            label: @tr("Wykres");
            tip: @tr("Wstaw wykres z edytowalnymi danymi");
            items: Menus.charts;
            menu-w: 190px;
            picked(id) => {
                App.cmd("chart", id);
            }
        }
    }
    Group {
        title: @tr("Tekst");
        BigButton {
            icon: Icons.type;
            label: @tr("Ramka tekstowa");
            tip: @tr("Narysuj ramkę tekstową (przeciągnij na stronie)");
            active: App.tool == 1;
            clicked => {
                App.cmd("text-frame", "");
            }
        }
        BigMenuButton {
            icon: Icons.pentagon;
            label: @tr("Kształt tekstu");
            tip: @tr("Tekst wpisany w kształt – opływa treść strony");
            items: Menus.shapes;
            menu-w: 230px;
            picked(id) => {
                App.cmd("text-shape", id);
            }
        }
        Col {
            RowButton {
                icon: Icons.spline;
                label: @tr("Tekst na ścieżce");
                tip: @tr("Tekst biegnący po krzywej");
                active: App.tool == 4;
                clicked => {
                    App.cmd("path-text", "");
                }
            }
            RowButton {
                icon: Icons.heading;
                label: @tr("Inicjał");
                tip: @tr("Pierwsza litera akapitu na trzy wiersze");
                active: App.drop-cap;
                clicked => {
                    App.cmd("drop-cap", "");
                }
            }
            MenuButton {
                icon: Icons.omega;
                label: @tr("Symbol");
                tip: @tr("Wstaw znak specjalny");
                items: Menus.symbols;
                menu-w: 260px;
                picked(id) => {
                    App.cmd("symbol", id);
                }
            }
        }
        Col {
            MenuButton {
                icon: Icons.hash;
                label: @tr("Pole");
                tip: @tr("Numer strony, liczba stron, data…");
                items: Menus.fields;
                menu-w: 230px;
                picked(id) => {
                    App.cmd("field", id);
                }
            }
            RowButton {
                icon: Icons.link;
                label: @tr("Łącze");
                tip: @tr("Hiperłącze (Ctrl+Shift+K)");
                clicked => {
                    App.cmd("link", "");
                }
            }
        }
    }
    Group {
        title: @tr("Nagłówek i stopka");
        last: true;
        Col {
            RowButton {
                icon: Icons.panel-top;
                label: App.has-header ? @tr("Edytuj nagłówek") : @tr("Dodaj nagłówek");
                tip: @tr("Tekst u góry każdej strony");
                clicked => {
                    App.cmd("header-edit", "");
                }
            }
            RowButton {
                icon: Icons.panel-bottom;
                label: App.has-footer ? @tr("Edytuj stopkę") : @tr("Dodaj stopkę");
                tip: @tr("Tekst u dołu każdej strony (z numerem strony)");
                clicked => {
                    App.cmd("footer-edit", "");
                }
            }
            RowButton {
                icon: Icons.files;
                label: @tr("Inna pierwsza strona");
                tip: @tr("Osobny nagłówek i stopka na pierwszej stronie");
                active: App.diff-first;
                clicked => {
                    App.cmd("diff-first", "");
                }
            }
        }
        Col {
            RowButton {
                icon: Icons.trash-2;
                label: @tr("Usuń nagłówek");
                enabled: App.has-header;
                clicked => {
                    App.cmd("header-remove", "");
                }
            }
            RowButton {
                icon: Icons.trash-2;
                label: @tr("Usuń stopkę");
                enabled: App.has-footer;
                clicked => {
                    App.cmd("footer-remove", "");
                }
            }
        }
    }
}

component DesignTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("Motyw dokumentu");
        for t in App.doc-themes: Rectangle {
            width: 76px * Theme.scale;
            height: 66px * Theme.scale;
            border-radius: Theme.r-small;
            background: t.id == App.doc-theme ? Theme.accent-soft : dta.has-hover ? Theme.hover : transparent;
            border-width: t.id == App.doc-theme ? 1px : 0;
            border-color: Theme.accent;
            VerticalLayout {
                padding: 5px;
                spacing: 3px;
                Rectangle {
                    border-radius: 4px;
                    background: #ffffff;
                    height: 36px * Theme.scale;
                    Text {
                        text: "Aa";
                        font-family: t.font;
                        font-size: 20px * Theme.scale;
                        color: #222;
                    }
                }
                Text {
                    text: t.label;
                    font-family: Theme.font;
                    font-size: 10px * Theme.scale;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
            dta := TipArea {
                tip: @tr("Motyw: {} – kroje i kolory stylów", t.label);
                clicked => {
                    App.cmd("doc-theme", t.id);
                }
            }
        }
    }
    Group {
        title: @tr("Tło strony");
        Col {
            Field {
                w: 150px;
                text: App.watermark;
                placeholder: @tr("Znak wodny, np. PROJEKT");
                tip: @tr("Ukośny napis w tle każdej strony");
                accepted(t) => {
                    App.cmd("watermark", t);
                }
            }
            Row {
                RowButton {
                    icon: Icons.sparkles;
                    label: @tr("POUFNE");
                    tip: @tr("Znak wodny „POUFNE”");
                    clicked => {
                        App.cmd("watermark", @tr("POUFNE"));
                    }
                }
                RowButton {
                    icon: Icons.x;
                    label: @tr("Usuń");
                    tip: @tr("Bez znaku wodnego");
                    clicked => {
                        App.cmd("watermark", "");
                    }
                }
            }
            Switch {
                label: @tr("Obramowanie strony");
                tip: @tr("Ramka dookoła każdej strony");
                on: App.page-border;
                toggled => {
                    App.cmd("page-border", "");
                }
            }
        }
    }
    Group {
        title: @tr("Tło i typografia");
        last: true;
        ColorPick {
            big: true;
            icon: Icons.paint-bucket;
            current: App.page-color;
            tip: @tr("Kolor strony");
            allow-none: false;
            apply => {
                App.cmd("page-color", "current");
            }
            picked(c) => {
                App.page-color = c;
                App.cmd("page-color", "current");
            }
        }
        Col {
            Switch {
                label: @tr("Polskie sierotki");
                tip: @tr("Krótkie wyrazy (a, i, o, u, w, z) nie zostają na końcu wiersza");
                on: App.orphans;
                toggled => {
                    App.cmd("orphans", "");
                }
            }
            Switch {
                label: @tr("Dzielenie wyrazów");
                tip: @tr("Automatyczne przenoszenie wyrazów z dywizem (polski i angielski)");
                on: App.hyphenate;
                toggled => {
                    App.cmd("hyphenate", "");
                }
            }
            Switch {
                label: @tr("Siatka bazowa");
                tip: @tr("Wiersze treści głównej na wspólnej siatce (równe linie w kolumnach)");
                on: App.baseline-grid;
                toggled => {
                    App.cmd("baseline-grid", "");
                }
            }
        }
    }
}

component LayoutTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("Strona");
        BigMenuButton {
            icon: Icons.file;
            label: App.page-size;
            tip: @tr("Rozmiar strony");
            items: Menus.page-sizes;
            current: App.page-size;
            menu-w: 230px;
            picked(id) => {
                App.cmd("page-size", id);
            }
        }
        BigButton {
            icon: App.landscape ? Icons.rectangle-horizontal : Icons.rectangle-vertical;
            label: App.landscape ? @tr("Pozioma") : @tr("Pionowa");
            tip: @tr("Orientacja strony");
            clicked => {
                App.cmd("orientation", "");
            }
        }
        BigMenuButton {
            icon: Icons.square-dashed;
            label: @tr("Marginesy");
            tip: @tr("Gotowe marginesy");
            items: Menus.margins;
            menu-w: 240px;
            picked(id) => {
                App.cmd("margins", id);
            }
        }
        Col {
            Row {
                Spin {
                    label: "↑";
                    tip: @tr("Margines górny");
                    value: App.m-top;
                    unit: App.unit;
                    w: 78px;
                    changed-value(v) => {
                        App.cmd("m-top", v);
                    }
                    step(d) => {
                        App.cmd("m-top-step", d);
                    }
                }
                Spin {
                    label: "↓";
                    tip: @tr("Margines dolny");
                    value: App.m-bottom;
                    unit: App.unit;
                    w: 78px;
                    changed-value(v) => {
                        App.cmd("m-bottom", v);
                    }
                    step(d) => {
                        App.cmd("m-bottom-step", d);
                    }
                }
            }
            Row {
                Spin {
                    label: "←";
                    tip: @tr("Margines lewy");
                    value: App.m-left;
                    unit: App.unit;
                    w: 78px;
                    changed-value(v) => {
                        App.cmd("m-left", v);
                    }
                    step(d) => {
                        App.cmd("m-left-step", d);
                    }
                }
                Spin {
                    label: "→";
                    tip: @tr("Margines prawy");
                    value: App.m-right;
                    unit: App.unit;
                    w: 78px;
                    changed-value(v) => {
                        App.cmd("m-right", v);
                    }
                    step(d) => {
                        App.cmd("m-right-step", d);
                    }
                }
            }
        }
    }
    Group {
        title: @tr("Sekcje");
        BigButton {
            icon: Icons.file-plus;
            label: @tr("Nowa sekcja");
            tip: @tr("Podział sekcji – dalsza treść od nowej strony, z własnymi kolumnami i orientacją");
            clicked => {
                App.cmd("section-new", "page");
            }
        }
        Col {
            RowButton {
                icon: Icons.separator-horizontal;
                label: @tr("Ciągła");
                tip: @tr("Podział sekcji na tej samej stronie – np. zmiana liczby kolumn");
                clicked => {
                    App.cmd("section-new", "cont");
                }
            }
            RowButton {
                icon: Icons.x;
                label: @tr("Usuń podział");
                enabled: App.in-section;
                tip: @tr("Scal tę sekcję z poprzednią");
                clicked => {
                    App.cmd("section-remove", "");
                }
            }
        }
    }
    Group {
        title: App.in-section ? @tr("Kolumny sekcji") : @tr("Kolumny");
        for n in [1, 2, 3, 4]: IconButton {
            icon: n == 1 ? Icons.file-text : n == 2 ? Icons.columns-2 : n == 3 ? Icons.columns-3 : Icons.columns-4;
            tip: n == 1 ? @tr("Jedna kolumna") : @tr("Kolumny: {}", n);
            active: App.columns == n;
            size: 36px;
            icon-size: 20px;
            clicked => {
                App.cmd("columns", n);
            }
        }
        Col {
            Spin {
                label: @tr("Odstęp");
                tip: @tr("Odstęp między kolumnami");
                value: App.col-gap;
                unit: App.unit;
                w: 80px;
                changed-value(v) => {
                    App.cmd("col-gap", v);
                }
                step(d) => {
                    App.cmd("col-gap-step", d);
                }
            }
            Switch {
                label: @tr("Linia między");
                on: App.col-rule;
                tip: @tr("Pionowa linia między kolumnami");
                toggled => {
                    App.cmd("col-rule", "");
                }
            }
        }
    }
    Group {
        title: @tr("Akapit");
        Col {
            Spin {
                label: @tr("Wcięcie ←");
                tip: @tr("Wcięcie z lewej");
                value: App.indent-left;
                unit: App.unit;
                w: 84px;
                changed-value(v) => {
                    App.cmd("indent-left", v);
                }
                step(d) => {
                    App.cmd("indent-left-step", d);
                }
            }
            Spin {
                label: @tr("Wcięcie →");
                tip: @tr("Wcięcie z prawej");
                value: App.indent-right;
                unit: App.unit;
                w: 84px;
                changed-value(v) => {
                    App.cmd("indent-right", v);
                }
                step(d) => {
                    App.cmd("indent-right-step", d);
                }
            }
            Spin {
                label: @tr("1. wiersz");
                tip: @tr("Wcięcie pierwszego wiersza (ujemne – wysunięcie)");
                value: App.first-line;
                unit: App.unit;
                w: 84px;
                changed-value(v) => {
                    App.cmd("first-line", v);
                }
                step(d) => {
                    App.cmd("first-line-step", d);
                }
            }
        }
        Col {
            Spin {
                label: @tr("Przed");
                tip: @tr("Odstęp przed akapitem (pt)");
                value: App.space-before;
                unit: "pt";
                w: 80px;
                changed-value(v) => {
                    App.cmd("space-before", v);
                }
                step(d) => {
                    App.cmd("space-before-step", d);
                }
            }
            Spin {
                label: @tr("Po");
                tip: @tr("Odstęp po akapicie (pt)");
                value: App.space-after;
                unit: "pt";
                w: 80px;
                changed-value(v) => {
                    App.cmd("space-after", v);
                }
                step(d) => {
                    App.cmd("space-after-step", d);
                }
            }
            Spin {
                label: @tr("Światło");
                tip: @tr("Odstępy między znakami zaznaczenia (pt)");
                value: App.tracking;
                unit: "pt";
                w: 80px;
                changed-value(v) => {
                    App.cmd("tracking", v);
                }
                step(d) => {
                    App.cmd("tracking-step", d);
                }
            }
        }
    }
    Group {
        title: @tr("Rozmieść");
        last: true;
        BigMenuButton {
            icon: Icons.wrap-text;
            label: @tr("Opływanie");
            tip: @tr("Jak tekst opływa zaznaczony obiekt");
            items: Menus.wraps;
            current: App.wrap-mode;
            menu-w: 250px;
            picked(id) => {
                App.cmd("wrap", id);
            }
        }
        Col {
            RowButton {
                icon: Icons.bring-to-front;
                label: @tr("Na wierzch");
                enabled: App.obj-sel;
                clicked => {
                    App.cmd("z-front", "");
                }
            }
            RowButton {
                icon: Icons.arrow-up-from-line;
                label: @tr("Do przodu");
                enabled: App.obj-sel;
                clicked => {
                    App.cmd("z-forward", "");
                }
            }
            RowButton {
                icon: Icons.arrow-down-to-line;
                label: @tr("Do tyłu");
                enabled: App.obj-sel;
                clicked => {
                    App.cmd("z-backward", "");
                }
            }
        }
        Col {
            RowButton {
                icon: Icons.send-to-back;
                label: @tr("Na spód");
                enabled: App.obj-sel;
                clicked => {
                    App.cmd("z-back", "");
                }
            }
            Row {
                IconButton {
                    icon: Icons.align-start-vertical;
                    tip: @tr("Do lewej krawędzi strony");
                    enabled: App.obj-sel;
                    size: 24px;
                    clicked => {
                        App.cmd("align-obj", "left");
                    }
                }
                IconButton {
                    icon: Icons.align-center-vertical;
                    tip: @tr("Wyśrodkuj na stronie w poziomie");
                    enabled: App.obj-sel;
                    size: 24px;
                    clicked => {
                        App.cmd("align-obj", "center");
                    }
                }
                IconButton {
                    icon: Icons.align-end-vertical;
                    tip: @tr("Do prawej krawędzi strony");
                    enabled: App.obj-sel;
                    size: 24px;
                    clicked => {
                        App.cmd("align-obj", "right");
                    }
                }
            }
            Row {
                IconButton {
                    icon: Icons.align-start-horizontal;
                    tip: @tr("Do górnej krawędzi strony");
                    enabled: App.obj-sel;
                    size: 24px;
                    clicked => {
                        App.cmd("align-obj", "top");
                    }
                }
                IconButton {
                    icon: Icons.align-center-horizontal;
                    tip: @tr("Wyśrodkuj na stronie w pionie");
                    enabled: App.obj-sel;
                    size: 24px;
                    clicked => {
                        App.cmd("align-obj", "middle");
                    }
                }
                IconButton {
                    icon: Icons.align-end-horizontal;
                    tip: @tr("Do dolnej krawędzi strony");
                    enabled: App.obj-sel;
                    size: 24px;
                    clicked => {
                        App.cmd("align-obj", "bottom");
                    }
                }
            }
        }
    }
}

component ShapesTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("Kształt tekstu");
        BigButton {
            icon: Icons.pen-tool;
            label: @tr("Rysuj węzłami");
            tip: @tr("Klikaj, aby stawiać węzły (przeciągnij – krzywa). Kliknij pierwszy węzeł albo Enter, aby zamknąć kształt; tekst wypełni jego wnętrze.");
            active: App.tool == 3;
            tint: Theme.accent;
            clicked => {
                App.cmd("draw-shape", "");
            }
        }
        BigMenuButton {
            icon: Icons.shapes;
            label: @tr("Gotowy kształt");
            tip: @tr("Kształt tekstu z gotowego wzoru");
            items: Menus.shapes;
            menu-w: 230px;
            picked(id) => {
                App.cmd("text-shape", id);
            }
        }
        BigButton {
            icon: Icons.type;
            label: @tr("Ramka");
            tip: @tr("Prostokątna ramka tekstowa");
            active: App.tool == 1;
            clicked => {
                App.cmd("text-frame", "");
            }
        }
    }
    Group {
        title: @tr("Węzły");
        BigButton {
            icon: Icons.spline-pointer;
            label: @tr("Edytuj węzły");
            tip: @tr("Pokaż węzły kształtu (dwuklik na obiekcie). Przeciągaj węzły i uchwyty krzywych; dwuklik na krawędzi dodaje węzeł.");
            active: App.node-mode;
            enabled: App.obj-sel;
            clicked => {
                App.cmd("node-mode", "");
            }
        }
        Col {
            RowButton {
                icon: Icons.plus;
                label: @tr("Dodaj węzeł");
                tip: @tr("Dodaj węzeł w połowie zaznaczonego odcinka");
                enabled: App.node-mode;
                clicked => {
                    App.cmd("node-add", "");
                }
            }
            RowButton {
                icon: Icons.minus;
                label: @tr("Usuń węzeł");
                tip: @tr("Usuń zaznaczony węzeł (Delete)");
                enabled: App.node-mode;
                clicked => {
                    App.cmd("node-delete", "");
                }
            }
            RowButton {
                icon: Icons.circle-dot;
                label: @tr("Gładki / narożny");
                tip: @tr("Przełącz węzeł między gładkim (z uchwytami) a narożnym");
                enabled: App.node-mode;
                clicked => {
                    App.cmd("node-smooth", "");
                }
            }
        }
        Col {
            RowButton {
                icon: Icons.minus;
                label: @tr("Odcinek prosty");
                tip: @tr("Odcinek za zaznaczonym węzłem jako prosta");
                enabled: App.node-mode;
                clicked => {
                    App.cmd("seg-line", "");
                }
            }
            RowButton {
                icon: Icons.spline;
                label: @tr("Odcinek krzywy");
                tip: @tr("Odcinek za zaznaczonym węzłem jako krzywa Béziera");
                enabled: App.node-mode;
                clicked => {
                    App.cmd("seg-curve", "");
                }
            }
            RowButton {
                icon: Icons.flip-horizontal;
                label: @tr("Odbij");
                tip: @tr("Odbij kształt w poziomie (Shift – w pionie)");
                enabled: App.obj-sel;
                clicked => {
                    App.cmd("flip-h", "");
                }
            }
        }
    }
    Group {
        title: @tr("Łączenie kształtów");
        Col {
            RowButton {
                icon: Icons.squares-unite;
                label: @tr("Suma");
                tip: @tr("Połącz zaznaczone kształty w jeden (zaznacz dwa z Shift)");
                enabled: App.multi-count >= 2;
                clicked => {
                    App.cmd("bool", "union");
                }
            }
            RowButton {
                icon: Icons.squares-subtract;
                label: @tr("Różnica");
                tip: @tr("Wytnij drugi kształt z pierwszego");
                enabled: App.multi-count >= 2;
                clicked => {
                    App.cmd("bool", "difference");
                }
            }
        }
        Col {
            RowButton {
                icon: Icons.squares-intersect;
                label: @tr("Część wspólna");
                enabled: App.multi-count >= 2;
                clicked => {
                    App.cmd("bool", "intersect");
                }
            }
            RowButton {
                icon: Icons.squares-exclude;
                label: @tr("Wyklucz");
                tip: @tr("Wszystko poza częścią wspólną");
                enabled: App.multi-count >= 2;
                clicked => {
                    App.cmd("bool", "xor");
                }
            }
        }
    }
    Group {
        title: @tr("Tekst w kształcie");
        Col {
            Spin {
                label: @tr("Margines");
                tip: @tr("Odstęp tekstu od krawędzi kształtu (pt)");
                value: App.padding;
                unit: "pt";
                w: 76px;
                changed-value(v) => {
                    App.cmd("padding", v);
                }
                step(d) => {
                    App.cmd("padding-step", d);
                }
            }
            Spin {
                label: @tr("Kolumny");
                tip: @tr("Liczba kolumn tekstu w kształcie");
                value: App.frame-cols;
                w: 76px;
                changed-value(v) => {
                    App.cmd("frame-cols", v);
                }
                step(d) => {
                    App.cmd("frame-cols-step", d);
                }
            }
            Segmented {
                items: [@tr("Góra"), @tr("Środek"), @tr("Dół")];
                current: App.valign;
                tip: @tr("Wyrównanie tekstu w pionie (ramki prostokątne)");
                picked(i) => {
                    App.cmd("valign", i);
                }
            }
        }
        Col {
            RowButton {
                icon: Icons.link-2;
                label: @tr("Połącz ramki");
                tip: @tr("Tekst, który się nie mieści, popłynie do wskazanej ramki");
                active: App.tool == 5;
                enabled: App.obj-kind == "text";
                clicked => {
                    App.cmd("link-frame", "");
                }
            }
            RowButton {
                icon: Icons.unlink;
                label: @tr("Rozłącz");
                enabled: App.linked;
                clicked => {
                    App.cmd("unlink-frame", "");
                }
            }
        }
    }
    Group {
        title: @tr("Opływanie");
        Col {
            Row {
                for m[i] in [Icons.x, Icons.wrap-text, Icons.align-start-vertical, Icons.align-end-vertical, Icons.move-horizontal, Icons.between-horizontal-start, Icons.layers]: IconButton {
                    icon: m;
                    size: 26px;
                    active: App.obj-sel && App.wrap-mode == i;
                    enabled: App.obj-sel;
                    tip: i == 0 ? @tr("Bez opływania") : i == 1 ? @tr("Z obu stron") : i == 2 ? @tr("Tekst po lewej") : i == 3 ? @tr("Tekst po prawej") : i == 4 ? @tr("Po większej stronie") : i == 5 ? @tr("Nad i pod") : @tr("Za tekstem");
                    clicked => {
                        App.cmd("wrap", i);
                    }
                }
            }
            Row {
                Spin {
                    label: @tr("Odstęp");
                    tip: @tr("Odstęp tekstu od obiektu (pt)");
                    value: App.wrap-dist;
                    unit: "pt";
                    w: 72px;
                    changed-value(v) => {
                        App.cmd("wrap-dist", v);
                    }
                    step(d) => {
                        App.cmd("wrap-dist-step", d);
                    }
                }
            }
            Row {
                Switch {
                    label: @tr("Po konturze");
                    tip: @tr("Opływaj kształt (wyłączone – prostokąt ramki)");
                    on: App.wrap-contour;
                    toggled => {
                        App.cmd("wrap-contour", "");
                    }
                }
                RowButton {
                    icon: Icons.scan;
                    label: @tr("Wykryj kontur");
                    tip: @tr("Kontur opływania z przezroczystości albo tła obrazu");
                    enabled: App.obj-kind == "image";
                    clicked => {
                        App.cmd("detect-contour", "");
                    }
                }
            }
        }
    }
    Group {
        title: @tr("Wypełnienie i obrys");
        ColorPick {
            big: true;
            icon: Icons.paint-bucket;
            current: App.has-fill ? App.fill : #00000000;
            tip: @tr("Wypełnienie kształtu");
            apply => {
                App.cmd("fill", "current");
            }
            picked(c) => {
                App.fill = c;
                App.cmd("fill", "current");
            }
        }
        ColorPick {
            big: true;
            icon: Icons.pen-line;
            current: App.has-stroke ? App.stroke : #00000000;
            tip: @tr("Kolor obrysu");
            apply => {
                App.cmd("stroke", "current");
            }
            picked(c) => {
                App.stroke = c;
                App.cmd("stroke", "current");
            }
        }
        Col {
            Segmented {
                items: [@tr("Jednolite"), @tr("Gradient"), @tr("Kołowy")];
                current: App.fill-kind;
                tip: @tr("Rodzaj wypełnienia");
                picked(i) => {
                    App.cmd("fill-kind", i);
                }
            }
            Spin {
                label: @tr("Obrys");
                tip: @tr("Grubość obrysu (pt)");
                value: App.stroke-w;
                unit: "pt";
                w: 76px;
                changed-value(v) => {
                    App.cmd("stroke-w", v);
                }
                step(d) => {
                    App.cmd("stroke-w-step", d);
                }
            }
            Switch {
                label: @tr("Kreski");
                tip: @tr("Obrys przerywany");
                on: App.dashed;
                toggled => {
                    App.cmd("dashed", "");
                }
            }
        }
    }
    Group {
        title: @tr("Efekty");
        last: true;
        Col {
            Switch {
                label: @tr("Cień");
                tip: @tr("Miękki cień pod kształtem");
                on: App.shadow;
                toggled => {
                    App.cmd("shadow", "");
                }
            }
            Spin {
                label: @tr("Narożniki");
                tip: @tr("Zaokrąglenie narożników prostokąta (pt)");
                value: App.corner;
                unit: "pt";
                w: 70px;
                changed-value(v) => {
                    App.cmd("corner", v);
                }
                step(d) => {
                    App.cmd("corner-step", d);
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Dim {
                    text: @tr("Krycie");
                }
                Slider {
                    width: 90px;
                    y: (parent.height - self.height) / 2;
                    value: App.opacity;
                    tip: @tr("Krycie obiektu");
                    moved(v) => {
                        App.cmd("opacity", v);
                    }
                }
                Dim {
                    text: round(App.opacity * 100) + "%";
                    width: 34px;
                }
            }
        }
    }
}

component RefsTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("Spis treści");
        BigButton {
            icon: Icons.table-of-contents;
            label: @tr("Spis treści");
            tip: @tr("Wstaw spis treści z nagłówków (z numerami stron)");
            clicked => {
                App.cmd("toc", "");
            }
        }
        BigButton {
            icon: Icons.refresh-cw;
            label: @tr("Aktualizuj");
            tip: @tr("Odśwież spis treści");
            clicked => {
                App.cmd("toc-update", "");
            }
        }
    }
    Group {
        title: @tr("Przypisy");
        BigButton {
            icon: Icons.superscript;
            label: @tr("Przypis dolny");
            tip: @tr("Wstaw przypis u dołu strony (numerowany automatycznie)");
            clicked => {
                App.cmd("footnote", "");
            }
        }
        Col {
            RowButton {
                icon: Icons.file-text;
                label: @tr("Przypis końcowy");
                tip: @tr("Wstaw przypis zebrany na końcu dokumentu");
                clicked => {
                    App.cmd("endnote", "");
                }
            }
            RowButton {
                icon: Icons.undo-2;
                label: @tr("Wróć do tekstu");
                enabled: App.in-note;
                tip: @tr("Wróć do odsyłacza w treści (Esc)");
                clicked => {
                    App.cmd("note-back", "");
                }
            }
        }
    }
    Group {
        title: @tr("Podpisy i nawigacja");
        last: true;
        BigButton {
            icon: Icons.captions;
            label: @tr("Podpis");
            tip: @tr("Wstaw podpis rysunku z kolejnym numerem");
            clicked => {
                App.cmd("caption", "");
            }
        }
        BigButton {
            icon: Icons.list-tree;
            label: @tr("Nawigator");
            tip: @tr("Panel z konspektem dokumentu");
            active: App.left-panel == "nav";
            clicked => {
                App.cmd("panel", "nav");
            }
        }
    }
}

component ReviewTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("Pisownia");
