                App.page-color = c;
                App.cmd("page-color", "current");
            }
        }
        Col {
            Field {
                w: 150px;
                text: App.watermark;
                placeholder: @tr("Znak wodny, np. PROJEKT");
                tip: @tr("Ukośny napis w tle każdej strony – Enter zatwierdza");
                accepted(t) => {
                    App.cmd("watermark", t);
                }
            }
            MenuButton {
                icon: Icons.droplet;
                label: @tr("Gotowe napisy");
                tip: @tr("Gotowe znaki wodne");
                items: [
                    { id: "POUFNE", label: @tr("POUFNE") },
                    { id: "PROJEKT", label: @tr("PROJEKT") },
                    { id: "KOPIA", label: @tr("KOPIA") },
                    { id: "WZÓR", label: @tr("WZÓR") },
                    { id: "PILNE", label: @tr("PILNE") },
                ];
                menu-w: 170px;
                picked(id) => {
                    App.cmd("watermark", id);
                }
            }
            RowButton {
                icon: Icons.x;
                label: @tr("Usuń znak wodny");
                tip: @tr("Bez znaku wodnego");
                enabled: App.watermark != "";
                clicked => {
                    App.cmd("watermark", "");
                }
            }
        }
    }
    Group {
        title: @tr("Obramowanie strony");
        BigMenuButton {
            icon: Icons.square-dashed;
            label: App.page-border-style == "none" ? @tr("Brak") : App.page-border-style == "double" ? @tr("Podwójna") : App.page-border-style == "dashed" ? @tr("Kreskowana") : App.page-border-style == "dotted" ? @tr("Kropkowana") : @tr("Pojedyncza");
            tip: @tr("Styl ramki dookoła każdej strony");
            active: App.page-border-style != "none";
            current: App.page-border-style;
            items: [
                { id: "single", label: @tr("Pojedyncza linia") },
                { id: "double", label: @tr("Podwójna linia") },
                { id: "dashed", label: @tr("Kreskowana") },
                { id: "dotted", label: @tr("Kropkowana") },
                { id: "-" },
                { id: "none", label: @tr("Bez obramowania") },
            ];
            menu-w: 200px;
            picked(id) => {
                App.cmd("page-border", id);
            }
        }
        Col {
            ColorPick {
                icon: Icons.square;
                current: App.page-border-color;
                tip: @tr("Kolor obramowania strony");
                allow-none: false;
                apply => {
                    App.cmd("page-border-color", "");
                }
                picked(c) => {
                    App.page-border-color = c;
                    App.cmd("page-border-color", "");
                }
            }
            Spin {
                label: @tr("Grubość");
