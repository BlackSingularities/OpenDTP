                    tip: @tr("Do dolnej krawędzi strony");
                    enabled: App.obj-sel;
                    size: 24px;
                    clicked => {
                        App.cmd("align-obj", "bottom");
                    }
                }
            }
        }
    }
}

component ShapesTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("Zamiana");
        BigMenuButton {
            icon: Icons.wand-sparkles;
            label: @tr("Tekst w kształt");
            tip: @tr("Zaznaczony tekst (albo bieżący akapit) staje się kształtem tekstu w tym samym miejscu strony – reszta treści go opływa");
            tint: Theme.accent;
            items: Menus.text-shapes;
            menu-w: 230px;
            picked(id) => {
                App.cmd("text-to-shape", id);
            }
        }
        BigButton {
            icon: Icons.text-cursor-input;
            label: @tr("Kształt w tekst");
            tip: @tr("Tekst z zaznaczonego kształtu wraca do treści dokumentu, a kształt znika");
            enabled: App.obj-kind == "text";
            clicked => {
                App.cmd("shape-to-text", "");
            }
        }
    }
    Group {
        title: @tr("Nowy kształt tekstu");
        BigButton {
            icon: Icons.pen-tool;
            label: @tr("Rysuj węzłami");
            tip: @tr("Klikaj, aby stawiać węzły (przeciągnij – krzywa). Kliknij pierwszy węzeł albo Enter, aby zamknąć kształt; tekst wypełni jego wnętrze.");
            active: App.tool == 3;
            tint: Theme.accent;
            clicked => {
                App.cmd("draw-shape", "");
            }
        }
        BigMenuButton {
            icon: Icons.shapes;
            label: @tr("Gotowy kształt");
            tip: @tr("Kształt tekstu z gotowego wzoru");
            items: Menus.shapes;
            menu-w: 230px;
            picked(id) => {
                App.cmd("text-shape", id);
            }
        }
        BigButton {
            icon: Icons.text-select;
            label: @tr("Ramka");
            tip: @tr("Prostokątna ramka tekstowa");
            active: App.tool == 1;
            clicked => {
                App.cmd("text-frame", "");
            }
        }
    }
    Group {
        title: @tr("Węzły");
        BigButton {
            icon: Icons.spline-pointer;
            label: @tr("Edytuj węzły");
            tip: @tr("Pokaż węzły kształtu (dwuklik na obiekcie). Przeciągaj węzły i uchwyty krzywych; dwuklik na krawędzi dodaje węzeł.");
            active: App.node-mode;
            enabled: App.obj-sel;
            clicked => {
                App.cmd("node-mode", "");
            }
        }
        Col {
            RowButton {
                icon: Icons.plus;
                label: @tr("Dodaj węzeł");
                tip: @tr("Dodaj węzeł w połowie zaznaczonego odcinka");
                enabled: App.node-mode;
                clicked => {
                    App.cmd("node-add", "");
                }
            }
            RowButton {
                icon: Icons.minus;
                label: @tr("Usuń węzeł");
                tip: @tr("Usuń zaznaczony węzeł (Delete)");
                enabled: App.node-mode;
                clicked => {
                    App.cmd("node-delete", "");
                }
            }
            RowButton {
                icon: Icons.circle-dot;
                label: @tr("Gładki / narożny");
                tip: @tr("Przełącz węzeł między gładkim (z uchwytami) a narożnym");
                enabled: App.node-mode;
                clicked => {
                    App.cmd("node-smooth", "");
                }
            }
        }
        Col {
            RowButton {
                icon: Icons.minus;
                label: @tr("Odcinek prosty");
                tip: @tr("Odcinek za zaznaczonym węzłem jako prosta");
                enabled: App.node-mode;
                clicked => {
                    App.cmd("seg-line", "");
                }
            }
            RowButton {
                icon: Icons.spline;
                label: @tr("Odcinek krzywy");
                tip: @tr("Odcinek za zaznaczonym węzłem jako krzywa Béziera");
                enabled: App.node-mode;
                clicked => {
                    App.cmd("seg-curve", "");
                }
            }
            RowButton {
                icon: Icons.flip-horizontal;
                label: @tr("Odbij");
                tip: @tr("Odbij kształt w poziomie (Shift – w pionie)");
                enabled: App.obj-sel;
                clicked => {
                    App.cmd("flip-h", "");
                }
            }
        }
    }
    Group {
        title: @tr("Łączenie kształtów");
        Col {
            RowButton {
                icon: Icons.squares-unite;
                label: @tr("Suma");
                tip: @tr("Połącz zaznaczone kształty w jeden (zaznacz dwa z Shift)");
                enabled: App.multi-count >= 2;
                clicked => {
                    App.cmd("bool", "union");
                }
            }
            RowButton {
                icon: Icons.squares-subtract;
                label: @tr("Różnica");
                tip: @tr("Wytnij drugi kształt z pierwszego");
                enabled: App.multi-count >= 2;
                clicked => {
                    App.cmd("bool", "difference");
                }
            }
        }
        Col {
            RowButton {
                tip: @tr("Zostaw tylko część wspólną zaznaczonych kształtów");
                icon: Icons.squares-intersect;
                label: @tr("Część wspólna");
                enabled: App.multi-count >= 2;
                clicked => {
                    App.cmd("bool", "intersect");
                }
            }
            RowButton {
                icon: Icons.squares-exclude;
                label: @tr("Wyklucz");
                tip: @tr("Wszystko poza częścią wspólną");
                enabled: App.multi-count >= 2;
                clicked => {
                    App.cmd("bool", "xor");
                }
            }
        }
    }
    Group {
        title: @tr("Tekst w kształcie");
        Col {
            Spin {
                label: @tr("Margines");
                tip: @tr("Odstęp tekstu od krawędzi kształtu (pt)");
                value: App.padding;
                unit: "pt";
                w: 76px;
                changed-value(v) => {
                    App.cmd("padding", v);
                }
                step(d) => {
                    App.cmd("padding-step", d);
                }
            }
            Spin {
                label: @tr("Kolumny");
                tip: @tr("Liczba kolumn tekstu w kształcie");
                value: App.frame-cols;
                w: 76px;
                changed-value(v) => {
                    App.cmd("frame-cols", v);
                }
                step(d) => {
                    App.cmd("frame-cols-step", d);
                }
            }
            Segmented {
                items: [@tr("Góra"), @tr("Środek"), @tr("Dół")];
                current: App.valign;
                tip: @tr("Wyrównanie tekstu w pionie (ramki prostokątne)");
                picked(i) => {
                    App.cmd("valign", i);
                }
            }
        }
        Col {
            RowButton {
                icon: Icons.link-2;
                label: @tr("Połącz ramki");
                tip: @tr("Tekst, który się nie mieści, popłynie do wskazanej ramki");
                active: App.tool == 5;
                enabled: App.obj-kind == "text";
                clicked => {
                    App.cmd("link-frame", "");
                }
            }
            RowButton {
                tip: @tr("Rozłącz ramkę – tekst przestanie płynąć do następnej");
                icon: Icons.unlink;
                label: @tr("Rozłącz");
                enabled: App.linked;
                clicked => {
                    App.cmd("unlink-frame", "");
                }
            }
        }
    }
    Group {
        title: @tr("Opływanie");
        Col {
            Row {
                for m[i] in [Icons.x, Icons.wrap-text, Icons.align-start-vertical, Icons.align-end-vertical, Icons.move-horizontal, Icons.between-horizontal-start, Icons.layers]: IconButton {
                    icon: m;
                    size: 24px;
                    active: App.obj-sel && App.wrap-mode == i;
                    enabled: App.obj-sel;
                    tip: i == 0 ? @tr("Bez opływania") : i == 1 ? @tr("Z obu stron") : i == 2 ? @tr("Tekst po lewej") : i == 3 ? @tr("Tekst po prawej") : i == 4 ? @tr("Po większej stronie") : i == 5 ? @tr("Nad i pod") : @tr("Za tekstem");
                    clicked => {
                        App.cmd("wrap", i);
                    }
                }
            }
            Row {
                Spin {
                    label: @tr("Odstęp");
                    tip: @tr("Odstęp tekstu od obiektu (pt)");
                    value: App.wrap-dist;
                    unit: "pt";
                    w: 72px;
                    changed-value(v) => {
                        App.cmd("wrap-dist", v);
                    }
                    step(d) => {
                        App.cmd("wrap-dist-step", d);
                    }
                }
            }
            Row {
                Switch {
                    label: @tr("Po konturze");
                    tip: @tr("Opływaj kształt (wyłączone – prostokąt ramki)");
                    on: App.wrap-contour;
                    toggled => {
                        App.cmd("wrap-contour", "");
                    }
                }
                RowButton {
                    icon: Icons.scan;
                    label: @tr("Wykryj kontur");
                    tip: @tr("Kontur opływania z przezroczystości albo tła obrazu");
                    enabled: App.obj-kind == "image";
                    clicked => {
                        App.cmd("detect-contour", "");
                    }
                }
            }
        }
    }
    Group {
        title: @tr("Wypełnienie i obrys");
        ColorPick {
            big: true;
            icon: Icons.paint-bucket;
            current: App.has-fill ? App.fill : #00000000;
            tip: @tr("Wypełnienie kształtu");
            apply => {
                App.cmd("fill", "current");
            }
            picked(c) => {
                App.fill = c;
                App.cmd("fill", "current");
            }
        }
        ColorPick {
            big: true;
            icon: Icons.pen-line;
            current: App.has-stroke ? App.stroke : #00000000;
            tip: @tr("Kolor obrysu");
            apply => {
                App.cmd("stroke", "current");
            }
            picked(c) => {
                App.stroke = c;
                App.cmd("stroke", "current");
            }
        }
        Col {
            Segmented {
                items: [@tr("Jednolite"), @tr("Gradient"), @tr("Kołowy")];
                current: App.fill-kind;
                tip: @tr("Rodzaj wypełnienia");
                picked(i) => {
                    App.cmd("fill-kind", i);
                }
            }
            Spin {
                label: @tr("Obrys");
                tip: @tr("Grubość obrysu (pt)");
                value: App.stroke-w;
                unit: "pt";
                w: 76px;
                changed-value(v) => {
                    App.cmd("stroke-w", v);
                }
                step(d) => {
                    App.cmd("stroke-w-step", d);
                }
            }
            Switch {
                label: @tr("Kreski");
                tip: @tr("Obrys przerywany");
                on: App.dashed;
                toggled => {
                    App.cmd("dashed", "");
                }
            }
        }
    }
    Group {
        title: @tr("Efekty");
        last: true;
        Col {
            Switch {
                label: @tr("Cień");
                tip: @tr("Miękki cień pod kształtem");
                on: App.shadow;
                toggled => {
                    App.cmd("shadow", "");
                }
            }
            MenuButton {
                icon: Icons.layers;
                label: @tr("Na stronach");
                tip: @tr("Element strony wzorcowej: powtarzaj obiekt na wszystkich, nieparzystych albo parzystych stronach");
                items: Menus.repeats;
                current: App.obj-repeat;
                menu-w: 240px;
                picked(id) => {
                    App.cmd("repeat", id);
                }
            }
        }
        Col {
            Spin {
                label: @tr("Narożniki");
                tip: @tr("Zaokrąglenie narożników prostokąta (pt)");
                value: App.corner;
                unit: "pt";
                w: 70px;
                changed-value(v) => {
                    App.cmd("corner", v);
                }
                step(d) => {
                    App.cmd("corner-step", d);
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Dim {
                    text: @tr("Krycie");
                }
                Slider {
                    width: 90px;
                    y: (parent.height - self.height) / 2;
                    value: App.opacity;
                    tip: @tr("Krycie obiektu");
                    moved(v) => {
                        App.cmd("opacity", v);
                    }
                }
                Dim {
                    text: round(App.opacity * 100) + "%";
                    width: 34px;
                }
            }
        }
    }
}

component RefsTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("Spis treści");
        BigMenuButton {
            icon: Icons.table-of-contents;
            label: @tr("Spis treści");
            tip: @tr("Spis treści z nagłówków, z numerami stron");
            items: [
                { id: "toc", label: @tr("Wstaw spis treści w miejscu kursora"), icon: Icons.table-of-contents },
                { id: "toc-update", label: @tr("Aktualizuj istniejący spis"), icon: Icons.refresh-cw },
            ];
            menu-w: 260px;
            picked(id) => {
                App.cmd(id, "");
            }
        }
        BigButton {
            icon: Icons.refresh-all;
            label: @tr("Aktualizuj wszystko");
            tip: @tr("Odśwież spis treści, indeks, numery podpisów i odsyłacze naraz");
            clicked => {
                App.cmd("refs-update", "");
            }
        }
    }
    Group {
        title: @tr("Przypisy");
        BigButton {
            icon: Icons.superscript;
            label: @tr("Przypis dolny");
            tip: @tr("Wstaw przypis u dołu strony (numerowany automatycznie)");
            clicked => {
                App.cmd("footnote", "");
            }
        }
        BigButton {
            icon: Icons.arrow-down-to-line;
            label: @tr("Przypis końcowy");
            tip: @tr("Wstaw przypis zebrany na końcu dokumentu (numeracja rzymska)");
            clicked => {
                App.cmd("endnote", "");
            }
        }
        Col {
            RowButton {
                icon: Icons.undo-2;
                label: @tr("Wróć do tekstu");
                enabled: App.in-note;
                tip: @tr("Wróć do odsyłacza w treści (Esc)");
                clicked => {
                    App.cmd("note-back", "");
                }
            }
        }
    }
    Group {
        title: @tr("Podpisy");
        BigMenuButton {
            icon: Icons.captions;
            label: @tr("Wstaw podpis");
            tip: @tr("Podpis rysunku, tabeli albo wzoru z automatycznym numerem");
            items: Menus.captions;
            picked(id) => {
                App.cmd("caption", id);
            }
        }
    }
    Group {
        title: @tr("Odsyłacze");
        BigButton {
            icon: Icons.bookmark;
            label: @tr("Zakładka");
            tip: @tr("Oznacz to miejsce jako cel odsyłaczy (nazwa z zaznaczenia albo akapitu)");
            clicked => {
                App.cmd("bookmark", "");
            }
        }
        BigMenuButton {
            icon: Icons.link-2;
            label: @tr("Odsyłacz");
            tip: @tr("„zob. s. 12”, „rys. 3” – numer i strona aktualizują się same. Cele: zakładki i podpisy.");
            items: App.ref-targets;
            menu-w: 320px;
            picked(id) => {
                App.cmd("xref", id);
            }
        }
    }
    Group {
        title: @tr("Indeks");
        last: true;
        BigButton {
            icon: Icons.book-a;
            label: @tr("Wstaw indeks");
            tip: @tr("Wstaw albo odśwież skorowidz alfabetyczny z numerami stron");
            clicked => {
                App.cmd("index", "");
            }
        }
        Col {
            RowButton {
                icon: Icons.hash;
                label: @tr("Oznacz hasło");
                tip: @tr("Dodaj zaznaczony wyraz do indeksu („hasło: podhasło” tworzy podhasło)");
                clicked => {
                    App.cmd("index-mark", "");
                }
            }
            RowButton {
                icon: Icons.whole-word;
                label: @tr("Oznacz wszystkie");
                tip: @tr("Dodaj do indeksu każde wystąpienie zaznaczonego wyrazu");
                clicked => {
                    App.cmd("index-mark-all", "");
                }
            }
        }
    }
}

component ReviewTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("Pisownia");
        BigButton {
            icon: Icons.spell-check;
            label: @tr("Sprawdź");
            tip: @tr("Przejdź do następnego błędu (F7)");
            clicked => {
                App.cmd("spell-next", "");
            }
        }
        Col {
            Switch {
                label: @tr("Podczas pisania");
                tip: @tr("Podkreślaj błędy na bieżąco");
                on: App.spell-live;
                toggled => {
                    App.cmd("spell-live", "");
                }
            }
            MenuButton {
                icon: Icons.languages;
                label: @tr("Język tekstu");
                tip: @tr("Język zaznaczonego tekstu – pisownia i dzielenie wyrazów");
                items: [
                    { id: "pl", label: @tr("Polski") },
                    { id: "en", label: @tr("Angielski") },
                ];
                menu-w: 170px;
                picked(id) => {
                    App.cmd("lang", id);
                }
            }
            RowButton {
                icon: Icons.book-a;
                label: @tr("Mój słownik");
                tip: @tr("Słownik użytkownika – wyrazy dodane do sprawdzania pisowni");
                active: App.left-panel == "dict";
                clicked => {
                    App.cmd("user-dict", "");
                }
            }
        }
    }
    Group {
        title: @tr("Komentarze");
        BigButton {
            icon: Icons.message-square-quote;
            label: @tr("Nowy komentarz");
            tip: @tr("Dodaj komentarz do zaznaczonego miejsca");
            clicked => {
                App.cmd("comment", "");
            }
        }
        BigButton {
            icon: Icons.panel-left;
            label: @tr("Wszystkie komentarze");
            tip: @tr("Panel komentarzy: odpowiedzi, rozwiązane, przejście do miejsca");
            active: App.left-panel == "comments";
            clicked => {
                App.cmd("panel", "comments");
            }
        }
    }
    Group {
        title: @tr("Śledzenie zmian");
        BigButton {
            icon: Icons.square-pen;
            label: @tr("Śledź zmiany");
            tip: @tr("Oznaczaj nowy tekst i usunięcia – do akceptacji albo odrzucenia");
            active: App.track;
            tint: App.track ? Theme.accent : Theme.text;
            clicked => {
                App.cmd("track-toggle", "");
            }
        }
        BigMenuButton {
            icon: Icons.check;
            label: @tr("Akceptuj");
            tip: @tr("Zaakceptuj zmianę w miejscu kursora albo wszystkie");
            items: [
                { id: "rev-accept", label: @tr("Akceptuj tę zmianę"), icon: Icons.check },
                { id: "rev-accept-all", label: @tr("Akceptuj wszystkie zmiany"), icon: Icons.list-checks },
            ];
            menu-w: 230px;
            picked(id) => {
                App.cmd(id, "");
            }
        }
        BigMenuButton {
            icon: Icons.x;
            label: @tr("Odrzuć");
            tip: @tr("Odrzuć zmianę w miejscu kursora albo wszystkie");
            items: [
                { id: "rev-reject", label: @tr("Odrzuć tę zmianę"), icon: Icons.x },
                { id: "rev-reject-all", label: @tr("Odrzuć wszystkie zmiany"), icon: Icons.eraser },
            ];
            menu-w: 230px;
            picked(id) => {
                App.cmd(id, "");
            }
        }
        BigButton {
            icon: Icons.chevron-right;
            label: App.rev-count > 0 ? @tr("Następna ({})", App.rev-count) : @tr("Następna");
            tip: @tr("Przejdź do następnej zmiany");
            enabled: App.rev-count > 0;
            clicked => {
                App.cmd("rev-next", "");
            }
        }
    }
    Group {
        title: @tr("Wersje");
        BigButton {
            icon: Icons.save;
            label: @tr("Zapisz wersję");
            tip: @tr("Zapamiętaj obecną treść jako wersję (w pliku .odtp)");
            clicked => {
                App.cmd("version-save", "");
            }
        }
        BigButton {
            icon: Icons.history;
            label: @tr("Historia");
            tip: @tr("Historia wersji zapisana w pliku dokumentu – podgląd i przywracanie");
            active: App.left-panel == "versions";
            clicked => {
                App.cmd("panel", "versions");
            }
        }
    }
    Group {
        title: @tr("Druk");
        BigButton {
            icon: Icons.list-checks;
            label: @tr("Preflight");
            tip: @tr("Kontrola przed drukiem: nadmiar tekstu, brakujące pliki i czcionki, rozdzielczość, spady");
            active: App.left-panel == "preflight";
            clicked => {
                App.cmd("preflight", "");
            }
        }
        BigButton {
            icon: Icons.printer;
            label: @tr("PDF do druku");
            tip: @tr("Zapisz PDF dla drukarni: CMYK, spady i znaczniki cięcia");
            clicked => {
                App.cmd("export", "pdf-print");
            }
        }
        Col {
            Switch {
                label: @tr("Znaczniki cięcia");
                tip: @tr("Kreski w narożnikach pokazujące, gdzie drukarnia przytnie kartkę");
                on: App.print-marks;
                toggled => {
                    App.cmd("print-marks", "");
                }
            }
            Switch {
                label: @tr("Kolory CMYK");
                tip: @tr("Zapisz kolory w CMYK (farby drukarskie) zamiast RGB (ekran)");
                on: App.print-cmyk;
                toggled => {
                    App.cmd("print-cmyk", "");
                }
            }
            Spin {
                label: @tr("Spad");
                tip: @tr("Spad – ile tła i obrazów wychodzi poza kartkę do obcięcia (mm, zwykle 3)");
                value: App.print-bleed;
                unit: "mm";
                w: 60px;
                changed-value(v) => {
                    App.cmd("print-bleed", v);
                }
                step(d) => {
                    App.cmd("print-bleed-step", d);
                }
            }
        }
        Col {
            RowButton {
                icon: Icons.palette;
                label: @tr("Kolory dokumentu");
                tip: @tr("Próbki kolorów: dokładne CMYK i kolory dodatkowe (Pantone)");
                active: App.left-panel == "swatches";
                clicked => {
                    App.cmd("panel", "swatches");
                }
            }
        }
    }
    Group {
        title: @tr("Statystyka");
        last: true;
        optional: true;
        BigButton {
            icon: Icons.sigma;
            label: @tr("Statystyka");
            tip: @tr("Wyrazy, znaki, akapity i strony");
            clicked => {
                App.cmd("stats", "");
            }
        }
    }
}

component ViewTab inherits HorizontalLayout {
    alignment: start;
    Group {
        title: @tr("Powiększenie");
        BigButton {
            icon: Icons.zoom-out;
            label: @tr("Pomniejsz");
            tip: @tr("Pomniejsz (Ctrl+−, Ctrl+kółko)");
            clicked => {
                App.cmd("zoom-out", "");
            }
        }
        BigButton {
            icon: Icons.zoom-in;
            label: @tr("Powiększ");
            tip: @tr("Powiększ (Ctrl++, Ctrl+kółko)");
            clicked => {
                App.cmd("zoom-in", "");
            }
        }
        BigButton {
            tip: @tr("Powiększenie 100% – rzeczywisty rozmiar kartki na ekranie");
            icon: Icons.scan;
            label: "100%";
            active: App.zoom == 100;
            clicked => {
                App.cmd("zoom", "100");
            }
        }
        Col {
            RowButton {
                tip: @tr("Dopasuj powiększenie do szerokości strony");
                icon: Icons.move-horizontal;
                label: @tr("Szerokość strony");
                clicked => {
                    App.cmd("zoom", "width");
                }
            }
            RowButton {
                tip: @tr("Pokaż całą stronę w oknie");
                icon: Icons.file;
                label: @tr("Cała strona");
                clicked => {
                    App.cmd("zoom", "page");
                }
            }
        }
    }
    Group {
        title: @tr("Pokaż");
        Col {
            Switch {
                tip: @tr("Pokaż znaki niedrukowane: spacje, akapity, tabulatory");
                label: @tr("Znaki formatowania");
                on: App.marks;
                toggled => {
                    App.cmd("marks", "");
                }
            }
            Switch {
                label: @tr("Linie pomocnicze");
                tip: @tr("Marginesy, kolumny i kontury ramek");
                on: App.guides;
                toggled => {
                    App.cmd("guides", "");
                }
            }
            Switch {
                tip: @tr("Panel nawigatora z nagłówkami dokumentu");
                label: @tr("Nawigator");
                on: App.left-panel == "nav";
                toggled => {
                    App.cmd("panel", "nav");
                }
            }
        }
        Col {
            Switch {
                label: @tr("Linijka");
                tip: @tr("Linijka z suwakami wcięć i tabulatorami");
                on: App.ruler-on;
                toggled => {
                    App.cmd("ruler-toggle", "");
                }
            }
            Switch {
                label: @tr("Linijka pionowa");
                tip: @tr("Linijka po lewej stronie – wysokość strony i marginesy górny i dolny");
                on: App.ruler-v-on;
                toggled => {
                    App.cmd("ruler-v-toggle", "");
                }
            }
            MenuButton {
                icon: Icons.list-ordered;
                label: App.line-numbers > 0 ? @tr("Numery wierszy: co {}", App.line-numbers) : @tr("Numery wierszy");
                tip: @tr("Numeracja wierszy na lewym marginesie – od 1 na każdej stronie, także w PDF i DOCX");
                active: App.line-numbers > 0;
                current: App.line-numbers;
                items: [
                    { id: "1", label: @tr("Każdy wiersz") },
                    { id: "5", label: @tr("Co 5 wierszy") },
                    { id: "10", label: @tr("Co 10 wierszy") },
                    { id: "-" },
                    { id: "0", label: @tr("Bez numeracji") },
                ];
                menu-w: 190px;
                picked(id) => {
                    App.cmd("line-numbers", id);
                }
            }
        }
    }
    Group {
        title: @tr("Interfejs");
        last: true;
        Col {
            Segmented {
                items: ["AMOLED", @tr("Grafit"), @tr("Jasny")];
                current: Theme.mode;
                tip: @tr("Motyw interfejsu");
                picked(i) => {
                    App.cmd("theme", i);
                }
            }
        }
        BigButton {
            icon: App.fullscreen ? Icons.minimize : Icons.maximize;
            label: @tr("Pełny ekran");
            tip: @tr("Pełny ekran (F11)");
            active: App.fullscreen;
            clicked => {
                App.cmd("fullscreen", "");
            }
        }
        BigButton {
            tip: @tr("Otwórz ustawienia programu");
            icon: Icons.settings;
            label: @tr("Ustawienia");
            clicked => {
                App.cmd("settings", "");
            }
        }
    }
}

component CustomTab inherits HorizontalLayout {
    in property <int> index;
    alignment: start;
    Group {
        title: App.custom-tabs[root.index].name;
        last: true;
        for c in App.custom-tabs[root.index].items: BigButton {
            icon: c.icon;
            label: c.label;
            tip: c.hint != "" ? c.label + " (" + c.hint + ")" : c.label;
            clicked => {
                App.cmd(c.id, "");
            }
        }
        BigButton {
            icon: Icons.plus;
            label: @tr("Dostosuj");
            tip: @tr("Nazwa i polecenia tej karty");
            clicked => {
                App.cmd("customize", root.index);
            }
        }
    }
}

/// Przycisk karty wstążki z podkreśleniem aktywnej.
component TabButton inherits Rectangle {
    in property <string> label;
    in property <int> index;
    in property <string> tip;
    width: tt.preferred-width + 22px;
    tt := Text {
        text: root.label;
        font-family: Theme.font;
        font-size: Theme.fs;
        font-weight: App.tab == root.index ? 600 : 400;
        color: App.tab == root.index ? Theme.text : tta.has-hover ? Theme.text : Theme.text-dim;
    }
    Rectangle {
        y: parent.height - 3px;
        height: 2px;
        width: App.tab == root.index ? parent.width - 14px : 0;
        border-radius: 1px;
        background: Theme.accent;
        animate width { duration: 140ms; easing: ease-out; }
    }
    tta := TipArea {
        tip: root.tip;
        clicked => {
            if (App.ribbon-collapsed && App.tab == root.index) {
                App.ribbon-peek = !App.ribbon-peek;
            } else {
                App.tab = root.index;
                App.ribbon-peek = App.ribbon-collapsed;
            }
        }
    }
}

export component RibbonTabs inherits Rectangle {
    height: 34px * Theme.scale;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 2px;
        alignment: start;
        Rectangle {
            width: ft.preferred-width + 24px;
            height: 26px * Theme.scale;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.r-small;
            background: fta.pressed ? Theme.accent.darker(0.15) : Theme.accent;
            ft := Text {
                text: @tr("Plik");
                font-family: Theme.font;
                font-size: Theme.fs;
                font-weight: 600;
                color: Theme.accent-text;
            }
            fta := TipArea {
                tip: @tr("Nowy, otwórz, zapisz, eksport, ustawienia (Alt+F)");
                clicked => {
                    App.cmd("backstage", "");
                }
            }
        }
        // Dawna karta „Projekt” (indeks 2) usunięta – pozostałe zachowują numery.
        for t[i] in [@tr("Narzędzia główne"), @tr("Wstawianie"), @tr("Układ"), @tr("Kształty tekstu"), @tr("Odwołania"), @tr("Recenzja"), @tr("Widok")]: TabButton {
            label: t;
            index: i < 2 ? i : i + 1;
            tip: [@tr("Schowek, czcionka, akapit i style"), @tr("Strony, obrazy, kształty, tabele, wykresy, tekst i nagłówki"), @tr("Marginesy, orientacja, kolumny, tło i obramowanie strony, typografia, układ obiektów"), @tr("Kształty tekstu: tekst w dowolnym konturze z węzłów, opływanie, łączenie ramek"), @tr("Spis treści, przypisy, podpisy i odsyłacze"), @tr("Pisownia, język, komentarze i statystyki"), @tr("Powiększenie, linijka, znaki formatowania i panele")][i];
        }
        // Karty skrótów (opcjonalne, do trzech) – po kartach stałych.
        for c[j] in App.custom-tabs: TabButton {
            label: c.name;
            index: 8 + j;
            tip: @tr("Karta skrótów – własny zestaw poleceń");
        }
    }
}

export component RibbonBody inherits Rectangle {
    height: Theme.ribbon-h;
    background: Theme.panel;
    // Dopasowanie do szerokości: gdy karta się nie mieści, podnosimy poziom zwężenia
    // (Theme.ribbon-level) i zapamiętujemy szerokość, jakiej potrzebował poprzedni poziom –
    // po poszerzeniu okna ponad nią wracamy poziom niżej. Gdy i poziom 3 nie wystarcza, zostaje przewijanie.
    property <length> need: hl.preferred-width;
    property <length> need0;
    property <length> need1;
    property <length> need2;
    function fit() {
        if (root.need > root.width + 1px && Theme.ribbon-level < 3) {
            if (Theme.ribbon-level == 0) {
                root.need0 = root.need;
            } else if (Theme.ribbon-level == 1) {
                root.need1 = root.need;
            } else {
                root.need2 = root.need;
            }
            Theme.ribbon-level += 1;
        } else if (Theme.ribbon-level > 0 && root.width >= (Theme.ribbon-level == 1 ? root.need0 : Theme.ribbon-level == 2 ? root.need1 : root.need2)) {
            Theme.ribbon-level -= 1;
        }
    }
    // Inna karta – inne szerokości: zaczynamy od pełnej wstążki.
    property <int> tab: App.tab;
    changed tab => {
        Theme.ribbon-level = 0;
        root.fit();
    }
    changed need => {
        root.fit();
    }
    changed width => {
        root.fit();
    }
    init => {
        root.fit();
    }
    Flickable {
        content-width: max(self.width, hl.preferred-width);
        content-height: self.height;
        hl := HorizontalLayout {
            height: Theme.ribbon-h;
            padding-left: 6px;
            // Miejsce na przycisk zwijania w prawym dolnym rogu.
            padding-right: 30px;
            alignment: start;
            if App.tab == 0: HomeTab {
                avail: root.width;
            }
            if App.tab == 1: InsertTab {}
            if App.tab == 3: LayoutTab {}
            if App.tab == 4: ShapesTab {}
            if App.tab == 5: RefsTab {}
            if App.tab == 6: ReviewTab {}
            if App.tab == 7: ViewTab {}
            if App.tab >= 8 && App.tab - 8 < App.custom-tabs.length: CustomTab {
                index: App.tab - 8;
            }
        }
    }
    // Jak w Wordzie: prawy dolny róg wstążki – zwiń, a na wysuniętej (zwiniętej) wstążce – przypnij.
    IconButton {
        x: parent.width - self.width - 6px;
        y: parent.height - self.height - 5px;
        size: 22px * Theme.scale;
        icon-size: 14px * Theme.scale;
        icon: App.ribbon-collapsed ? Icons.pin : Icons.chevron-up;
        tint: Theme.text-dim;
        tip: App.ribbon-collapsed ? @tr("Przypnij wstążkę (Ctrl+F1)") : @tr("Zwiń wstążkę (Ctrl+F1)");
        clicked => {
            App.ribbon-peek = false;
            App.cmd("ribbon-collapse", "");
        }
    }
}
