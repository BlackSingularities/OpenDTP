                tip: @tr("Wstaw metadane dokumentu jako pole – zmieniają się razem z metadanymi");
                items: [
                    { id: "title", label: @tr("Tytuł"), icon: Icons.heading },
                    { id: "author", label: @tr("Autor"), icon: Icons.pen-line },
                    { id: "subject", label: @tr("Temat"), icon: Icons.file-text },
                    { id: "keywords", label: @tr("Słowa kluczowe"), icon: Icons.hash },
                    { id: "created", label: @tr("Data utworzenia"), icon: Icons.calendar },
