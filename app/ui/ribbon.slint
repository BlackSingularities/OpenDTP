                unit: "pt";
                w: 80px;
                changed-value(v) => {
                    App.cmd("page-border-inset", v);
                }
                step(d) => {
                    App.cmd("page-border-inset-step", d);
                }
            }
        }
    }
    Group {
        title: @tr("Typografia");
