// Okno główne OpenDTP: pasek tytułu z paskiem szybkiego dostępu i paletą poleceń, wstążka,
// płótno, panele wysuwane, pasek stanu i nakładki (menu Plik, menu kontekstowe, okna).

import { ListView, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, TabV, CtxV, PageV, BoxV, NodeV, ItemV, StyleV, NavV, RecentV, ImgV, PreV, SwatchV, CommentV } from "state.slint";
import { Splitter, Tip, TipArea, IconButton, Field, Spin, Switch, MenuItem, MenuSep, Card, Segmented, Label, Dim, Button, Slider, Toggle, IconSeg, Pane, IconField, IconSpin, ColorRow, RowButton } from "widgets.slint";
import { RibbonTabs, RibbonBody, Menus, MenuButton } from "ribbon.slint";
import { Canvas } from "canvas.slint";
import { LeftPanel, RightPanel } from "panels.slint";
import { Backstage } from "backstage.slint";

export { App, Theme, Icons, Tip, TabV, CtxV, PageV, BoxV, NodeV, ItemV, StyleV, NavV, RecentV, ImgV, PreV, SwatchV, CommentV }

/// Przycisk okna (minimalizuj, maksymalizuj, zamknij) w pasku tytułu.
component WinButton inherits Rectangle {
    in property <int> kind;
    in property <string> tip;
    width: 46px;
    background: ta.pressed ? (kind == 3 ? #c42b1c : Theme.press) : ta.has-hover ? (kind == 3 ? #e81123 : Theme.hover) : transparent;
    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: ta.has-hover && root.kind == 3 ? #ffffff : Theme.text;
        stroke-width: 1px;
        fill: transparent;
        commands: root.kind == 1 ? "M 0 5 L 10 5" : root.kind == 3 ? "M 0 0 L 10 10 M 10 0 L 0 10" : App.maximized ? "M 2 0 L 10 0 L 10 8 M 0 2 L 8 2 L 8 10 L 0 10 Z" : "M 0 0 L 10 0 L 10 10 L 0 10 Z";
    }
    ta := TipArea {
        tip: root.tip;
        clicked => {
            App.win(root.kind);
        }
    }
}

component TopBar inherits Rectangle {
    // Położenie pola „Szukaj poleceń” w oknie – tu zaczepia się paleta poleceń.
    out property <length> search-x: search-box.absolute-position.x;
    out property <length> search-y: search-box.absolute-position.y + search-box.height;
    out property <length> search-w: search-box.width;
    height: 40px * Theme.scale;
    background: Theme.panel;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 2px;
        Image {
            source: @image-url("../icon.png");
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
        }
        Rectangle {
            width: 8px;
        }
        for q in App.qat: IconButton {
            icon: q.icon;
            tip: q.hint != "" ? q.label + " (" + q.hint + ")" : q.label;
            y: (parent.height - self.height) / 2;
            clicked => {
                App.cmd(q.id, "");
            }
        }
        IconButton {
            icon: Icons.chevron-down;
            size: 20px;
            icon-size: 12px;
            tip: @tr("Dostosuj pasek szybkiego dostępu");
            y: (parent.height - self.height) / 2;
            clicked => {
                App.cmd("customize", "qat");
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        App.win(0);
                    }
                }
                double-clicked => {
                    App.win(2);
                }
            }
            Text {
                text: App.doc-name + (App.dirty ? " •" : "");
                font-family: Theme.font;
                font-size: Theme.fs;
                color: Theme.text-dim;
                overflow: elide;
                width: parent.width - 20px;
                horizontal-alignment: center;
            }
        }
        search-box := Rectangle {
            width: 260px * Theme.scale;
            height: 26px * Theme.scale;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.r-small;
            background: pta.has-hover ? Theme.higher : Theme.raised;
            border-width: 1px;
            border-color: Theme.line;
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 8px;
                spacing: 8px;
                Image {
                    source: Icons.search;
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    colorize: Theme.text-faint;
                }
                Text {
                    text: @tr("Szukaj poleceń…");
                    font-family: Theme.font;
                    font-size: Theme.fs-small;
                    color: Theme.text-faint;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "Ctrl+K";
                    font-family: Theme.font;
                    font-size: 10px;
                    color: Theme.text-faint;
                    vertical-alignment: center;
                }
            }
            pta := TipArea {
                tip: @tr("Paleta poleceń – wszystkie funkcje programu (Ctrl+K)");
                clicked => {
                    App.cmd("palette", "");
                }
            }
        }
        Rectangle {
            width: 6px;
        }
        IconButton {
            icon: Icons.wand-sparkles;
            tint: Theme.accent;
            tip: @tr("Generuj dokument z AI");
            y: (parent.height - self.height) / 2;
            clicked => {
                App.cmd("ai", "");
            }
        }
        IconButton {
            icon: Theme.mode == 2 ? Icons.moon : Icons.sun;
            tip: @tr("Przełącz motyw: AMOLED / grafit / jasny");
            y: (parent.height - self.height) / 2;
            clicked => {
                App.cmd("theme", Theme.mode == 2 ? 0 : Theme.mode + 1);
            }
        }
        Rectangle {
            width: 10px;
        }
        WinButton {
            kind: 1;
            tip: @tr("Minimalizuj");
        }
        WinButton {
            kind: 2;
            tip: App.maximized ? @tr("Przywróć") : @tr("Maksymalizuj");
        }
        WinButton {
            kind: 3;
            tip: @tr("Zamknij");
        }
    }
}


component StatusBar inherits Rectangle {
    height: 26px * Theme.scale;
    background: Theme.panel;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 16px;
        Dim {
            text: App.page-info;
        }
        Dim {
            text: App.words;
            TipArea {
                tip: @tr("Statystyka dokumentu");
                clicked => {
                    App.cmd("stats", "");
                }
            }
        }
        Dim {
            text: App.spell-state;
            TipArea {
                tip: @tr("Następny błąd pisowni (F7)");
                clicked => {
                    App.cmd("spell-next", "");
                }
            }
        }
        Dim {
            text: App.status;
            horizontal-stretch: 1;
        }
        IconButton {
            icon: Icons.list-tree;
            size: 22px;
            icon-size: 13px;
            active: App.left-panel == "nav";
            tip: @tr("Nawigator");
            y: (parent.height - self.height) / 2;
            clicked => {
                App.cmd("panel", "nav");
            }
        }
        IconButton {
            icon: Icons.pilcrow;
            size: 22px;
            icon-size: 13px;
            active: App.marks;
            tip: @tr("Znaki formatowania");
            y: (parent.height - self.height) / 2;
            clicked => {
                App.cmd("marks", "");
            }
        }
        HorizontalLayout {
            spacing: 4px;
            IconButton {
                icon: Icons.minus;
                size: 22px;
                icon-size: 12px;
                tip: @tr("Pomniejsz");
                y: (parent.height - self.height) / 2;
                clicked => {
                    App.cmd("zoom-out", "");
                }
            }
            Slider {
                width: 110px;
                y: (parent.height - self.height) / 2;
                value: (App.zoom - 25) / 375;
                tip: @tr("Powiększenie");
                moved(v) => {
                    App.cmd("zoom", round(25 + v * 375));
                }
            }
            IconButton {
                icon: Icons.plus;
                size: 22px;
                icon-size: 12px;
                tip: @tr("Powiększ");
                y: (parent.height - self.height) / 2;
                clicked => {
                    App.cmd("zoom-in", "");
                }
            }
            MenuButton {
                compactable: false;
                icon: Icons.zoom-in;
                label: App.zoom + "%";
                tip: @tr("Powiększenie");
                items: Menus.zooms;
                menu-w: 160px;
                y: (parent.height - self.height) / 2;
                picked(id) => {
                    App.cmd("zoom", id);
                }
            }
        }
    }
}

component Palette inherits Rectangle {
    // Pole „Szukaj poleceń” na pasku tytułu – paleta rozwija się tuż pod nim, wyrównana do jego prawej krawędzi.
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> anchor-w;
    background: #00000033;
    TouchArea {
        clicked => {
            App.palette-open = false;
        }
    }
    Card {
        x: max(8px, min(root.anchor-x + root.anchor-w - self.width, parent.width - self.width - 8px));
        y: root.anchor-y + 4px;
        width: 560px;
        height: min(440px, vl.preferred-height);
        TouchArea {}
        vl := VerticalLayout {
            padding: 10px;
            spacing: 8px;
            q := Field {
                tip: @tr("Wpisz część nazwy polecenia; Enter uruchamia zaznaczone, Esc zamyka");
                w: 540px;
                placeholder: @tr("Wpisz polecenie, np. „kolumny”, „kształt”, „PDF”…");
                edited(t) => {
                    App.palette-query(t);
                }
                accepted(t) => {
                    if (App.palette-items.length > 0) {
                        App.palette-open = false;
                        App.cmd(App.palette-items[0].id, "");
                    }
                }
            }
            ListView {
                height: min(380px, App.palette-items.length * 30px + 4px);
                for c in App.palette-items: MenuItem {
                    label: c.label;
                    hint: c.hint;
                    icon: c.icon;
                    clicked => {
                        App.palette-open = false;
                        App.cmd(c.id, "");
                    }
                }
            }
        }
        init => {
            q.focus-input();
        }
    }
}

component ContextMenu inherits Rectangle {
    TouchArea {
        clicked => {
            App.ctx-open = false;
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                App.ctx-open = false;
            }
        }
    }
    Card {
        x: min(App.ctx-x, parent.width - self.width - 8px);
        y: max(8px, min(App.ctx-y, parent.height - self.height - 8px));
        width: 300px * Theme.scale;
        height: vl.preferred-height;
        TouchArea {}
        vl := VerticalLayout {
            padding: 5px;
            for it in App.ctx-items: Rectangle {
                height: it.kind == 1 ? 9px : it.kind == 2 ? 22px : it.kind == 3 ? 32px * Theme.scale : 28px * Theme.scale;
                if it.kind == 1: MenuSep {
                    width: parent.width;
                }
                if it.kind == 2: Text {
                    x: 10px;
                    text: it.label;
                    font-family: Theme.font;
                    font-size: Theme.fs-small;
                    font-weight: 600;
                    color: Theme.text-faint;
                    vertical-alignment: center;
                }
                // Rząd ikon: podpis po lewej, przyciski z podpowiedziami.
                if it.kind == 3: HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 2px;
                    Text {
                        width: 74px * Theme.scale;
                        text: it.label;
                        font-family: Theme.font;
                        font-size: Theme.fs-small;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    for b in it.row: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: b.icon;
                        tip: b.label;
                        active: b.checked;
                        enabled: b.id != "";
                        clicked => {
                            App.ctx-open = false;
                            App.cmd(b.id, "");
                        }
                    }
                }
                if it.kind == 0: MenuItem {
                    width: parent.width;
                    label: it.label;
                    hint: it.hint;
                    icon: it.icon;
                    checked: it.checked;
                    enabled: it.id != "";
                    clicked => {
                        App.ctx-open = false;
                        App.cmd(it.id, "");
                    }
                }
            }
        }
    }
}

component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> w: 420px;
    background: #00000080;
    TouchArea {}
    Card {
        x: (parent.width - self.width) / 2;
        y: max(40px, (parent.height - self.height) / 2.4);
        width: root.w;
        height: vl.preferred-height;
        vl := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            HorizontalLayout {
                Label {
                    text: root.title;
                    font-size: Theme.fs-big;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: Icons.x;
                    tip: @tr("Zamknij (Esc)");
                    clicked => {
                        App.dialog = "";
                    }
                }
            }
            @children
        }
    }
}

component Customize inherits Dialog {
    in property <string> target;
    w: 460px;
    title: root.target == "qat" ? @tr("Pasek szybkiego dostępu") : @tr("Karta skrótów");
    if root.target != "qat": HorizontalLayout {
        spacing: 8px;
        Label {
            text: @tr("Nazwa");
            vertical-alignment: center;
        }
        Field {
            tip: @tr("Nazwa karty widoczna na wstążce");
            w: 220px;
            text: App.custom-name;
            placeholder: @tr("Moja karta");
            edited(t) => {
                App.custom-name = t;
                App.cmd("tab-rename", t);
            }
        }
    }
    Dim {
        text: root.target == "qat" ? @tr("Zaznacz polecenia, które mają być pod ręką.") : @tr("Karta skrótów zbiera polecenia dostępne też na pozostałych kartach.");
    }
    ListView {
        height: 380px;
        for c in App.all-commands: MenuItem {
            label: c.label;
            hint: c.hint;
            checked: c.checked;
            clicked => {
                App.cmd(root.target == "qat" ? "qat-toggle" : "tab-toggle", c.id);
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        if root.target != "qat": Button {
            tip: @tr("Usuń tę kartę skrótów (polecenia zostają na pozostałych kartach)");
            label: @tr("Usuń kartę");
            clicked => {
                App.cmd("tab-remove", "");
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Button {
            tip: @tr("Przywróć domyślny zestaw poleceń");
            label: @tr("Przywróć domyślne");
            clicked => {
                App.cmd(root.target == "qat" ? "qat-reset" : "tab-reset", "");
            }
        }
        Button {
            tip: @tr("Zamknij okno – zmiany są już zapisane");
            label: @tr("Gotowe");
            primary: true;
            clicked => {
                App.dialog = "";
            }
        }
    }
}

export component AppWindow inherits Window {
    title: App.title;
    no-frame: true;
    icon: @image-url("../icon.png");
    // Przy przezroczystości tło okna przepuszcza akryl Windows (rozmycie tego, co za oknem).
    background: Theme.bg.with-alpha(1 - Theme.clear);
    preferred-width: 1440px;
    preferred-height: 920px;
    min-width: 900px;
    min-height: 560px;
    default-font-family: Theme.font;
    init => {
        App.win-h = self.height;
    }
    changed height => {
        App.win-h = self.height;
    }

    callback close-requested();

    VerticalLayout {
        top-bar := TopBar {}
        RibbonTabs {
            background: Theme.panel;
        }
        if !App.ribbon-collapsed: RibbonBody {}
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        HorizontalLayout {
            vertical-stretch: 1;
            // Paski boczne zadokowane obok strony; szerokość zmienia uchwyt przy krawędzi.
            if App.left-panel != "": LeftPanel {
                width: App.left-w;
            }
            if App.left-panel != "": Splitter {
                side: 1;
                value <=> App.left-w;
                reset: 290px;
                tip: @tr("Przeciągnij, aby zmienić szerokość panelu; dwuklik – domyślna");
            }
            Rectangle {
                horizontal-stretch: 1;
                canvas := Canvas {
                    width: parent.width;
                    height: parent.height;
                }
                if App.ribbon-collapsed && App.ribbon-peek: Rectangle {
                    y: 0;
                    height: Theme.ribbon-h + 2px;
                    background: Theme.panel;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: #00000080;
                    RibbonBody {}
                }
            }
            if App.right-panel != "": Splitter {
                side: -1;
                value <=> App.right-w;
                reset: 330px;
                tip: @tr("Przeciągnij, aby zmienić szerokość panelu; dwuklik – domyślna");
            }
            if App.right-panel != "": RightPanel {
                width: App.right-w;
            }
        }
        StatusBar {}
    }

    if App.backstage: Backstage {
        width: parent.width;
        height: parent.height;
    }
    if App.ctx-open: ContextMenu {
        width: parent.width;
        height: parent.height;
    }
    if App.palette-open: Palette {
        anchor-x: top-bar.search-x;
        anchor-y: top-bar.search-y;
        anchor-w: top-bar.search-w;
        width: parent.width;
        height: parent.height;
    }
    if App.dialog == "link": Dialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Hiperłącze");
        lf := Field {
            tip: @tr("Adres strony (https://…) lub e-mail (mailto:…)");
            w: 384px;
            text <=> App.link-url;
            placeholder: "https://";
            accepted(t) => {
                App.cmd("link-apply", t);
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                tip: @tr("Usuń łącze, zostawiając sam tekst");
                label: @tr("Usuń łącze");
                clicked => {
                    App.cmd("link-apply", "");
                }
            }
            Button {
                tip: @tr("Wstaw łącze w zaznaczony tekst");
                label: @tr("Wstaw");
                primary: true;
                clicked => {
                    App.cmd("link-apply", App.link-url);
                }
            }
        }
        init => {
            lf.focus-input();
        }
    }
    if App.dialog == "code": Dialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Kod QR lub kreskowy");
        Segmented {
            tip: @tr("Rodzaj kodu");
            items: [@tr("Kod QR"), @tr("Kod kreskowy (Code 128)")];
            current: App.code-kind;
            picked(i) => {
                App.code-kind = i;
            }
        }
        code-field := Field {
            tip: App.code-kind == 0 ? @tr("Adres strony, tekst, numer telefonu…") : @tr("Litery bez polskich znaków, cyfry i interpunkcja");
            w: 384px;
            text <=> App.code-text;
            placeholder: App.code-kind == 0 ? "https://" : "OPENDTP-0001";
            accepted(t) => {
                App.cmd("code-insert", "");
            }
        }
        HorizontalLayout {
            alignment: end;
            Button {
                tip: @tr("Wstaw kod jako obraz wektorowy");
                label: @tr("Wstaw");
                icon: Icons.check;
                primary: true;
                clicked => {
                    App.cmd("code-insert", "");
                }
            }
        }
        init => {
            code-field.focus-input();
        }
    }
    if App.dialog == "cite": Dialog {
        width: parent.width;
        height: parent.height;
        w: 560px;
        title: @tr("Cytowania i źródła");
        Segmented {
            tip: @tr("Styl cytowań i bibliografii – zmiana przelicza wszystkie cytowania");
            items: ["APA 7", "MLA 9", "Chicago", "IEEE"];
            current: App.cite-style;
            picked(i) => {
                App.cmd("cite-style", i);
            }
        }
        Dim {
            text: App.cite-sources.length == 0 ? @tr("Brak źródeł – dodaj je poniżej albo zaimportuj z BibTeX lub RIS (Zotero, Mendeley, Google Scholar).") : @tr("Kliknij źródło, aby wstawić cytowanie w miejscu kursora.");
            wrap: word-wrap;
        }
        if App.cite-sources.length > 0: Rectangle {
            height: min(200px, App.cite-sources.length * 26px + 8px);
            border-radius: Theme.r-small;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line;
            ScrollView {
                VerticalLayout {
                    padding: 4px;
                    for s in App.cite-sources: RowButton {
                        icon: s.icon;
                        label: s.label;
                        compactable: false;
                        tip: @tr("Wstaw cytowanie tego źródła");
                        clicked => {
                            App.cmd("cite-insert", s.id);
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 120px;
            border-radius: Theme.r-small;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line-strong;
            TextEdit {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                text <=> App.cite-new;
                font-size: 12px;
                placeholder-text: @tr("Rodzaj: książka / artykuł / rozdział / strona\nAutorzy: Kowalski, Jan; Nowak, Anna\nTytuł: …\nRok: 2024\nWydawca: …   Miejsce: …\nCzasopismo: …   Tom: …   Numer: …   Strony: …\nURL: …   DOI: …");
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                tip: @tr("Plik .bib albo .ris z Zotero, Mendeleya, JabRef lub Google Scholar");
                label: @tr("Importuj…");
                icon: Icons.file-input;
                clicked => {
                    App.cmd("cite-import", "");
                }
            }
            Button {
                tip: @tr("Wstaw albo odśwież bibliografię w miejscu kursora");
                label: @tr("Bibliografia");
                icon: Icons.book-a;
                clicked => {
                    App.cmd("bibliography", "");
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                tip: @tr("Dodaj źródło z formularza powyżej");
                label: @tr("Dodaj źródło");
                icon: Icons.plus;
                primary: true;
                clicked => {
                    App.cmd("cite-add", App.cite-new);
                }
            }
        }
    }
    if App.dialog == "comment": Dialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Nowy komentarz");
        cf := Field {
            tip: @tr("Treść komentarza – Enter dodaje");
            w: 420px;
            text <=> App.comment-text;
            placeholder: @tr("Uwaga do zaznaczonego miejsca…");
            accepted(t) => {
                App.cmd("comment-apply", t);
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                tip: @tr("Zamknij bez dodawania");
                label: @tr("Anuluj");
                clicked => {
                    App.dialog = "";
                }
            }
            Button {
                tip: @tr("Dodaj komentarz w miejscu kursora");
                label: @tr("Dodaj");
                primary: true;
                clicked => {
                    App.cmd("comment-apply", App.comment-text);
                }
            }
        }
        init => {
            cf.focus-input();
        }
    }
    if App.dialog == "version": Dialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Zapisz wersję");
        vf := Field {
            tip: @tr("Nazwa wersji, np. „Po korekcie”");
            w: 384px;
            text <=> App.ver-name;
            accepted(t) => {
                App.cmd("version-save-apply", t);
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                tip: @tr("Zamknij bez zapisywania");
                label: @tr("Anuluj");
                clicked => {
                    App.dialog = "";
                }
            }
            Button {
                tip: @tr("Zapamiętaj obecną treść jako wersję (w pliku .odtp)");
                label: @tr("Zapisz");
                primary: true;
                clicked => {
                    App.cmd("version-save-apply", App.ver-name);
                }
            }
        }
        init => {
            vf.focus-input();
        }
    }
    if App.dialog == "lib-save": Dialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Zapisz w bibliotece");
        lnf := Field {
            tip: @tr("Nazwa elementu w bibliotece");
            w: 384px;
            text <=> App.lib-name;
            placeholder: @tr("Nazwa");
            accepted(t) => {
                App.cmd("lib-save-apply", t);
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                tip: @tr("Zamknij bez zapisywania");
                label: @tr("Anuluj");
                clicked => {
                    App.dialog = "";
                }
            }
            Button {
                tip: @tr("Zapisz zaznaczony tekst albo obiekty do ponownego użycia w innych dokumentach");
                label: @tr("Zapisz");
                primary: true;
                clicked => {
                    App.cmd("lib-save-apply", App.lib-name);
                }
            }
        }
        init => {
            lnf.focus-input();
        }
    }
    if App.dialog == "ai": Dialog {
        width: parent.width;
        height: parent.height;
        w: 620px;
        title: @tr("Generuj dokument z AI");
        Dim {
            text: @tr("Opisz, jaki dokument ma powstać – temat, odbiorców, układ, ton. AI napisze treść i złoży ją z formatowaniem: nagłówki, listy, wykresy, kształty tekstu, kolumny.");
            wrap: word-wrap;
            height: 34px;
        }
        Rectangle {
            height: 172px;
            border-radius: Theme.r-small;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line-strong;
            TextEdit {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                text <=> App.ai-prompt;
                font-size: 13px;
                enabled: !App.ai-busy;
                placeholder-text: @tr("np. Ulotka na otwarcie kawiarni „Pod Lipą”: menu śniadaniowe, godziny, rabat na start, ciepłe kolory");
            }
        }
        HorizontalLayout {
            spacing: 12px;
            Segmented {
                items: [@tr("Krótki"), @tr("Średni"), @tr("Obszerny")];
                current: App.ai-length;
                tip: @tr("Długość dokumentu");
                picked(i) => {
                    App.ai-length = i;
                }
            }
            Segmented {
                items: [@tr("Nowy dokument"), @tr("Wstaw w miejscu kursora")];
                current: App.ai-insert ? 1 : 0;
                tip: @tr("Gdzie umieścić wynik");
                picked(i) => {
                    App.ai-insert = i == 1;
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            for ex in [@tr("Raport kwartalny firmy z wykresami"), @tr("Ulotka na otwarcie kawiarni"), @tr("Gazetka szkolna w trzech kolumnach")]: Rectangle {
                width: ext.preferred-width + 18px;
                height: 24px;
                border-radius: 12px;
                background: exa.has-hover ? Theme.hover : Theme.raised;
                border-width: 1px;
                border-color: Theme.line;
                ext := Text {
                    text: ex;
                    font-size: Theme.fs-small;
                    color: Theme.text-dim;
                }
                exa := TipArea {
                    tip: @tr("Wstaw przykład");
                    clicked => {
                        App.ai-prompt = ex;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Dim {
                text: App.ai-busy ? @tr("Generowanie… to może potrwać do minuty") : App.ai-status;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            Button {
                tip: @tr("Dostawca, klucz API i model AI");
                label: @tr("Ustawienia AI");
                icon: Icons.settings;
                clicked => {
                    App.dialog = "";
                    App.cmd("settings", "");
                }
            }
            Button {
                tip: @tr("Wygeneruj dokument według opisu");
                label: App.ai-busy ? @tr("Generowanie…") : @tr("Generuj");
                icon: Icons.wand-sparkles;
                primary: true;
                enabled: !App.ai-busy && App.ai-prompt != "";
                clicked => {
                    App.cmd("ai-generate", "");
                }
            }
        }
    }
    if App.dialog == "font": Dialog {
        width: parent.width;
        height: parent.height;
        w: 720px;
        title: @tr("Czcionka");
        // Podgląd na górze – od razu widać efekt.
        Rectangle {
            height: 74px;
            border-radius: Theme.r;
            background: #ffffff;
            clip: true;
            Text {
                text: App.f-caps == 1 ? "ZAŻÓŁĆ GĘŚLĄ JAŹŃ 0123456789 ½" : "Zażółć gęślą jaźń 0123456789 ½";
                font-family: App.f-font;
                font-size: 26px;
                font-weight: App.f-bold ? 700 : 400;
                font-italic: App.f-italic;
                letter-spacing: (App.f-tracking.to-float() * 1.33) * 1px;
                color: #1a1a1a;
            }
            Rectangle {
                x: 10px;
                y: parent.height - 22px;
                height: 16px;
                width: pl.preferred-width + 12px;
                border-radius: 8px;
                background: #00000010;
                pl := Text {
                    text: App.f-font + " · " + App.f-size + " pt";
                    font-size: 10px;
                    color: #00000080;
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            IconField {
                icon: Icons.type;
                w: 250px;
                text <=> App.f-font;
                placeholder: @tr("Czcionka");
                tip: @tr("Nazwa kroju");
            }
            IconField {
                icon: Icons.a-large-small;
                w: 84px;
                text <=> App.f-size;
                placeholder: "pt";
                tip: @tr("Rozmiar (pt)");
            }
            Rectangle {
                width: 6px;
            }
            Toggle {
                icon: Icons.bold;
                on: App.f-bold;
                tip: @tr("Pogrubienie");
                toggled => {
                    App.f-bold = !App.f-bold;
                }
            }
            Toggle {
                icon: Icons.italic;
                on: App.f-italic;
                tip: @tr("Kursywa");
                toggled => {
                    App.f-italic = !App.f-italic;
                }
            }
            Toggle {
                icon: Icons.strikethrough;
                on: App.f-strike;
                tip: @tr("Przekreślenie");
                toggled => {
                    App.f-strike = !App.f-strike;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            IconSeg {
                icons: [];
                glyphs: ["PL", "EN"];
                tips: ["Polski", "English"];
                current: App.f-lang;
                picked(i) => {
                    App.f-lang = i;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Pane {
                title: @tr("KRÓJ I POŁOŻENIE");
                icon: Icons.underline;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    IconSeg {
                        icons: [Icons.x, Icons.underline];
                        glyphs: ["", "", "═", "┈", "∿"];
                        tips: [@tr("Bez podkreślenia"), @tr("Pojedyncze"), @tr("Podwójne"), @tr("Kropki"), @tr("Fala")];
                        current: App.f-underline;
                        picked(i) => {
                            App.f-underline = i;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    IconSeg {
                        icons: [Icons.case-sensitive, Icons.case-upper, Icons.a-large-small];
                        tips: [@tr("Jak w tekście"), @tr("WERSALIKI"), @tr("Kapitaliki")];
                        current: App.f-caps;
                        picked(i) => {
                            App.f-caps = i;
                        }
                    }
                    IconSeg {
                        icons: [Icons.type, Icons.superscript, Icons.subscript];
                        tips: [@tr("Zwykły"), @tr("Indeks górny"), @tr("Indeks dolny")];
                        current: App.f-script;
                        picked(i) => {
                            App.f-script = i;
                        }
                    }
                }
            }
            Pane {
                title: @tr("ODSTĘPY I SKALA");
                icon: Icons.move-horizontal;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    IconSpin {
                        icon: Icons.unfold-horizontal;
                        tip: @tr("Światło (odstęp między literami)");
                        value: App.f-tracking;
                        unit: "pt";
                        changed-value(v) => {
                            App.f-tracking = v;
                        }
                        step(d) => {
                            App.cmd("f-step", "tracking;" + d);
                        }
                    }
                    IconSpin {
                        icon: Icons.scaling;
                        tip: @tr("Szerokość znaków");
                        value: App.f-scale;
                        unit: "%";
                        changed-value(v) => {
                            App.f-scale = v;
                        }
                        step(d) => {
                            App.cmd("f-step", "scale;" + d);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    IconSpin {
                        icon: Icons.baseline;
                        tip: @tr("Przesunięcie linii bazowej");
                        value: App.f-baseline;
                        unit: "pt";
                        changed-value(v) => {
                            App.f-baseline = v;
                        }
                        step(d) => {
                            App.cmd("f-step", "baseline;" + d);
                        }
                    }
                }
            }
        }
        Pane {
            title: @tr("KOLORY");
            icon: Icons.palette;
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    width: 18px;
                    Image {
                        source: Icons.type;
                        width: 15px;
                        height: 15px;
                        colorize: Theme.text-dim;
                    }
                }
                ColorRow {
                    value <=> App.f-color;
                    tip: @tr("Kolor tekstu (szesnastkowo)");
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    width: 18px;
                    Image {
                        source: Icons.highlighter;
                        width: 15px;
                        height: 15px;
                        colorize: Theme.text-dim;
                    }
                }
                ColorRow {
                    value <=> App.f-highlight;
                    allow-none: true;
                    placeholder: @tr("brak");
                    tip: @tr("Kolor wyróżnienia (pusto – brak)");
                }
            }
        }
        Pane {
            title: @tr("FUNKCJE OPENTYPE (o ile czcionka je ma)");
            icon: Icons.sparkles;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Switch {
                    tip: @tr("Kerning – dopasowanie odstępów między parami liter (np. AV)");
                    icon: Icons.unfold-horizontal;
                    label: @tr("Kerning");
                    on: App.f-kerning;
                    toggled => {
                        App.f-kerning = !App.f-kerning;
                    }
                }
                Switch {
                    tip: @tr("Ligatury – połączone znaki, np. fi, fl");
                    icon: Icons.link;
                    label: @tr("Ligatury");
                    on: App.f-ligatures;
                    toggled => {
                        App.f-ligatures = !App.f-ligatures;
                    }
                }
                Switch {
                    tip: @tr("Kapitaliki z czcionki OpenType (prawdziwe, nie pomniejszone wersaliki)");
                    icon: Icons.a-large-small;
                    label: @tr("Kapitaliki OT");
                    on: App.f-smcp;
                    toggled => {
                        App.f-smcp = !App.f-smcp;
                    }
                }
                Switch {
                    tip: @tr("Ułamki – 1/2 jako jeden znak ułamka");
                    icon: Icons.divide;
                    label: @tr("Ułamki");
                    on: App.f-frac;
                    toggled => {
                        App.f-frac = !App.f-frac;
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Switch {
                    tip: @tr("Cyfry nautyczne – z wydłużeniami górnymi i dolnymi, dopasowane do tekstu");
                    icon: Icons.chart-line;
                    label: @tr("Cyfry nautyczne");
                    on: App.f-onum;
                    toggled => {
                        App.f-onum = !App.f-onum;
                    }
                }
                Switch {
                    tip: @tr("Cyfry równej wysokości – jak wersaliki");
                    icon: Icons.baseline;
                    label: @tr("Cyfry równej wysokości");
                    on: App.f-lnum;
                    toggled => {
                        App.f-lnum = !App.f-lnum;
                    }
                }
                Switch {
                    tip: @tr("Cyfry tabelaryczne – jednakowej szerokości, równe kolumny liczb");
                    icon: Icons.grid-3x3;
                    label: @tr("Cyfry tabelaryczne");
                    on: App.f-tnum;
                    toggled => {
                        App.f-tnum = !App.f-tnum;
                    }
                }
                IconField {
                    icon: Icons.wand-sparkles;
                    w: 120px;
                    text <=> App.f-ss;
                    placeholder: "ss01, swsh";
                    tip: @tr("Dodatkowe funkcje: zestawy stylistyczne ss01–ss20, swsh, salt…");
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                tip: @tr("Zamknij bez zmian");
                label: @tr("Anuluj");
                clicked => {
                    App.dialog = "";
                }
            }
            Button {
                tip: @tr("Zastosuj ustawienia do zaznaczenia");
                label: @tr("Zastosuj");
                icon: Icons.check;
                primary: true;
                clicked => {
                    App.cmd("font-apply", "");
                }
            }
        }
    }
    if App.dialog == "para": Dialog {
        width: parent.width;
        height: parent.height;
        w: 720px;
        title: @tr("Akapit");
        HorizontalLayout {
            spacing: 10px;
            Pane {
                title: @tr("WYRÓWNANIE I WCIĘCIA");
                icon: Icons.align-left;
                horizontal-stretch: 1;
                IconSeg {
                    icons: [Icons.align-left, Icons.align-center, Icons.align-right, Icons.align-justify];
                    tips: [@tr("Do lewej"), @tr("Wyśrodkuj"), @tr("Do prawej"), @tr("Wyjustuj")];
                    current: App.p-align;
                    picked(i) => {
                        App.p-align = i;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    IconSpin {
                        icon: Icons.arrow-right-from-line;
                        tip: @tr("Wcięcie z lewej");
                        value: App.p-left;
                        unit: App.unit;
                        changed-value(v) => {
                            App.p-left = v;
                        }
                        step(d) => {
                            App.cmd("p-step", "left;" + d);
                        }
                    }
                    IconSpin {
                        icon: Icons.arrow-left-to-line;
                        tip: @tr("Wcięcie z prawej");
                        value: App.p-right;
                        unit: App.unit;
                        changed-value(v) => {
                            App.p-right = v;
                        }
                        step(d) => {
                            App.cmd("p-step", "right;" + d);
                        }
                    }
                }
                IconSpin {
                    icon: Icons.pilcrow;
                    tip: @tr("Wcięcie pierwszego wiersza (ujemne – wysunięcie)");
                    value: App.p-first;
                    unit: App.unit;
                    changed-value(v) => {
                        App.p-first = v;
                    }
                    step(d) => {
                        App.cmd("p-step", "first;" + d);
                    }
                }
            }
            Pane {
                title: @tr("ODSTĘPY");
                icon: Icons.move-vertical;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    IconSpin {
                        icon: Icons.arrow-up-from-line;
                        tip: @tr("Odstęp przed akapitem");
                        value: App.p-before;
                        unit: "pt";
                        changed-value(v) => {
                            App.p-before = v;
                        }
                        step(d) => {
                            App.cmd("p-step", "before;" + d);
                        }
                    }
                    IconSpin {
                        icon: Icons.arrow-down-to-line;
                        tip: @tr("Odstęp po akapicie");
                        value: App.p-after;
                        unit: "pt";
                        changed-value(v) => {
                            App.p-after = v;
                        }
                        step(d) => {
                            App.cmd("p-step", "after;" + d);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    IconSeg {
                        icons: [Icons.rows-3, Icons.ruler, Icons.arrow-up-from-line];
                        tips: [@tr("Interlinia wielokrotna"), @tr("Interlinia dokładnie (pt)"), @tr("Interlinia co najmniej (pt)")];
                        current: App.p-line-kind;
                        picked(i) => {
                            App.p-line-kind = i;
                        }
                    }
                    IconField {
                        icon: Icons.move-vertical;
                        w: 92px;
                        text <=> App.p-line;
                        tip: @tr("Wartość interlinii (wielokrotność albo pt)");
                    }
                }
            }
        }
        Pane {
            title: @tr("PRZEPŁYW TEKSTU");
            icon: Icons.wrap-text;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Switch {
                    tip: @tr("Nie oddzielaj akapitu od następnego (np. nagłówka od treści)");
                    icon: Icons.link-2;
                    label: @tr("Razem z następnym");
                    on: App.p-keep-next;
                    toggled => {
                        App.p-keep-next = !App.p-keep-next;
                    }
                }
                Switch {
                    tip: @tr("Nie dziel akapitu między strony lub kolumny");
                    icon: Icons.fold-vertical;
                    label: @tr("Wiersze razem");
                    on: App.p-keep-lines;
                    toggled => {
                        App.p-keep-lines = !App.p-keep-lines;
                    }
                }
                Switch {
                    tip: @tr("Nie zostawiaj pojedynczego wiersza akapitu na górze lub dole strony");
                    icon: Icons.between-horizontal-start;
                    label: @tr("Wdowy i sieroty");
                    on: App.p-widows;
                    toggled => {
                        App.p-widows = !App.p-widows;
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Switch {
                    tip: @tr("Zaczynaj akapit zawsze od nowej strony");
                    icon: Icons.file-plus;
                    label: @tr("Od nowej strony");
                    on: App.p-page-before;
                    toggled => {
                        App.p-page-before = !App.p-page-before;
                    }
                }
                Switch {
                    tip: @tr("Dziel długie wyrazy na końcu wiersza według reguł języka");
                    icon: Icons.scissors;
                    label: @tr("Dzielenie wyrazów");
                    on: App.p-hyphen;
                    toggled => {
                        App.p-hyphen = !App.p-hyphen;
                    }
                }
                IconSpin {
                    icon: Icons.letter-text;
                    tip: @tr("Inicjał (wiersze)");
                    value: App.p-dropcap;
                    w: 84px;
                    changed-value(v) => {
                        App.cmd("p-step", "dropcap-set;" + v);
                    }
                    step(d) => {
                        App.cmd("p-step", "dropcap;" + d);
                    }
                }
            }
        }
        Pane {
            title: @tr("TŁO I RAMKA");
            icon: Icons.paint-roller;
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    width: 18px;
                    Image {
                        source: Icons.paint-bucket;
                        width: 15px;
                        height: 15px;
                        colorize: Theme.text-dim;
                    }
                }
                ColorRow {
                    value <=> App.p-shading;
                    allow-none: true;
                    placeholder: @tr("brak");
                    tip: @tr("Cieniowanie akapitu (pusto – brak)");
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    width: 18px;
                    Image {
                        source: Icons.square;
                        width: 15px;
                        height: 15px;
                        colorize: Theme.text-dim;
                    }
                }
                ColorRow {
                    value <=> App.p-border-color;
                    tip: @tr("Kolor ramki");
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                IconField {
                    icon: Icons.square-dashed;
                    w: 96px;
                    text <=> App.p-border-w;
                    placeholder: "0";
                    tip: @tr("Grubość ramki (pt, 0 – bez ramki)");
                }
                IconField {
                    icon: Icons.radius;
                    w: 96px;
                    text <=> App.p-radius;
                    placeholder: "0";
                    tip: @tr("Zaokrąglenie (pt)");
                }
                IconField {
                    icon: Icons.scan;
                    w: 96px;
                    text <=> App.p-padding;
                    placeholder: "4";
                    tip: @tr("Odstęp tekstu od ramki (pt)");
                }
            }
        }
        Pane {
            title: @tr("TABULATORY");
            icon: Icons.ruler;
            IconField {
                icon: Icons.space;
                w: 660px;
                text <=> App.p-tabs;
                placeholder: @tr("np. 36; 72; -1 (−1 – do prawej z kropkami)");
                tip: @tr("Położenia tabulatorów w pt od lewej krawędzi tekstu");
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                tip: @tr("Zamknij bez zmian");
                label: @tr("Anuluj");
                clicked => {
                    App.dialog = "";
                }
            }
            Button {
                tip: @tr("Zastosuj ustawienia do zaznaczonych akapitów");
                label: @tr("Zastosuj");
                icon: Icons.check;
                primary: true;
                clicked => {
                    App.cmd("para-apply", "");
                }
            }
        }
    }
    if App.dialog == "page": Dialog {
        width: parent.width;
        height: parent.height;
        w: 640px;
        title: @tr("Ustawienia strony");
        // Zmiany działają od razu (jak pola na wstążce) – wystarczy zamknąć okno.
        HorizontalLayout {
            spacing: 10px;
            Pane {
                title: @tr("PAPIER");
                icon: Icons.file;
                horizontal-stretch: 1;
                MenuButton {
                    compactable: false;
                    icon: Icons.file;
                    label: App.page-size;
                    tip: @tr("Rozmiar strony");
                    items: Menus.page-sizes;
                    current: App.page-size;
                    menu-w: 230px;
                    picked(id) => {
                        App.cmd("page-size", id);
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    IconSpin {
                        icon: Icons.move-horizontal;
                        tip: @tr("Szerokość strony");
                        value: App.page-w;
                        unit: App.unit;
                        changed-value(v) => {
                            App.cmd("page-w", v);
                        }
                        step(d) => {
                            App.cmd("page-w-step", d);
                        }
                    }
                    IconSpin {
                        icon: Icons.move-vertical;
                        tip: @tr("Wysokość strony");
                        value: App.page-h;
                        unit: App.unit;
                        changed-value(v) => {
                            App.cmd("page-h", v);
                        }
                        step(d) => {
                            App.cmd("page-h-step", d);
                        }
                    }
                }
                Segmented {
                    tip: @tr("Orientacja strony");
                    items: [@tr("Pionowa"), @tr("Pozioma")];
                    current: App.landscape ? 1 : 0;
                    picked(i) => {
                        if ((i == 1) != App.landscape) {
                            App.cmd("orientation", "");
                        }
                    }
                }
            }
            Pane {
                title: @tr("MARGINESY");
                icon: Icons.square-dashed;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    IconSpin {
                        icon: Icons.arrow-up-from-line;
                        tip: @tr("Margines górny");
                        value: App.m-top;
                        unit: App.unit;
                        changed-value(v) => {
                            App.cmd("m-top", v);
                        }
                        step(d) => {
                            App.cmd("m-top-step", d);
                        }
                    }
                    IconSpin {
                        icon: Icons.arrow-down-to-line;
                        tip: @tr("Margines dolny");
                        value: App.m-bottom;
                        unit: App.unit;
                        changed-value(v) => {
                            App.cmd("m-bottom", v);
                        }
                        step(d) => {
                            App.cmd("m-bottom-step", d);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    IconSpin {
                        icon: Icons.arrow-right-from-line;
                        tip: @tr("Margines lewy");
                        value: App.m-left;
                        unit: App.unit;
                        changed-value(v) => {
                            App.cmd("m-left", v);
                        }
                        step(d) => {
                            App.cmd("m-left-step", d);
                        }
                    }
                    IconSpin {
                        icon: Icons.arrow-left-to-line;
                        tip: @tr("Margines prawy");
                        value: App.m-right;
                        unit: App.unit;
                        changed-value(v) => {
                            App.cmd("m-right", v);
                        }
                        step(d) => {
                            App.cmd("m-right-step", d);
                        }
                    }
                }
                MenuButton {
                    compactable: false;
                    icon: Icons.square-dashed;
                    label: @tr("Gotowe marginesy");
                    tip: @tr("Gotowe zestawy marginesów");
                    items: Menus.margins;
                    menu-w: 230px;
                    picked(id) => {
                        App.cmd("margins", id);
                    }
                }
            }
        }
        Pane {
            title: App.in-section ? @tr("KOLUMNY SEKCJI") : @tr("KOLUMNY");
            icon: Icons.columns-2;
            HorizontalLayout {
                spacing: 8px;
                Segmented {
                    tip: @tr("Liczba kolumn");
                    items: ["1", "2", "3", "4"];
                    current: App.columns - 1;
                    picked(i) => {
                        App.cmd("columns", i + 1);
                    }
                }
                IconSpin {
                    icon: Icons.columns-2;
                    tip: @tr("Odstęp między kolumnami");
                    value: App.col-gap;
                    unit: App.unit;
                    changed-value(v) => {
                        App.cmd("col-gap", v);
                    }
                    step(d) => {
                        App.cmd("col-gap-step", d);
                    }
                }
                Switch {
                    label: @tr("Linia między kolumnami");
                    on: App.col-rule;
                    tip: @tr("Pionowa linia między kolumnami");
                    toggled => {
                        App.cmd("col-rule", "");
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            Button {
                tip: @tr("Zamknij okno");
                label: @tr("Gotowe");
                icon: Icons.check;
                primary: true;
                clicked => {
                    App.dialog = "";
                }
            }
        }
    }
    if App.dialog == "stats": Dialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Statystyka");
        Label {
            text: App.stats-text;
            wrap: word-wrap;
            height: 150px;
            vertical-alignment: top;
        }
        HorizontalLayout {
            alignment: end;
            Button {
                tip: @tr("Zamknij okno");
                label: @tr("Zamknij");
                primary: true;
                clicked => {
                    App.dialog = "";
                }
            }
        }
    }
    if App.dialog == "confirm": Dialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Niezapisane zmiany");
        Label {
            text: App.confirm-text;
            wrap: word-wrap;
            height: 40px;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                tip: @tr("Wróć do dokumentu");
                label: @tr("Anuluj");
                clicked => {
                    App.dialog = "";
                }
            }
            Button {
                tip: @tr("Zamknij bez zapisywania zmian");
                label: @tr("Nie zapisuj");
                clicked => {
                    App.dialog = "";
                    App.cmd("confirm-discard", App.confirm-id);
                }
            }
            Button {
                tip: @tr("Zapisz zmiany i zamknij");
                label: @tr("Zapisz");
                primary: true;
                clicked => {
                    App.dialog = "";
                    App.cmd("confirm-save", App.confirm-id);
                }
            }
        }
    }
    if App.dialog == "customize-qat": Customize {
        width: parent.width;
        height: parent.height;
        target: "qat";
    }
    if App.dialog == "customize-tab": Customize {
        width: parent.width;
        height: parent.height;
        target: "tab";
    }

    // Zmiana rozmiaru okna bez ramki – cienkie pasy przy krawędziach i rogach.
    if !App.maximized && !App.fullscreen: Rectangle {
        width: parent.width;
        height: parent.height;
        for e in [
            { d: 11, x: 8px, y: 0, w: root.width - 16px, h: 4px, c: 0 },
            { d: 12, x: 8px, y: root.height - 4px, w: root.width - 16px, h: 4px, c: 0 },
            { d: 13, x: 0, y: 8px, w: 4px, h: root.height - 16px, c: 1 },
            { d: 14, x: root.width - 4px, y: 8px, w: 4px, h: root.height - 16px, c: 1 },
            { d: 15, x: 0, y: 0, w: 8px, h: 8px, c: 2 },
            { d: 16, x: root.width - 8px, y: 0, w: 8px, h: 8px, c: 3 },
            { d: 17, x: 0, y: root.height - 8px, w: 8px, h: 8px, c: 3 },
            { d: 18, x: root.width - 8px, y: root.height - 8px, w: 8px, h: 8px, c: 2 },
        ]: TouchArea {
            x: e.x;
            y: e.y;
            width: e.w;
            height: e.h;
            mouse-cursor: e.c == 0 ? MouseCursor.ns-resize : e.c == 1 ? MouseCursor.ew-resize : e.c == 2 ? MouseCursor.nwse-resize : MouseCursor.nesw-resize;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    App.win(e.d);
                }
            }
        }
    }

    // Powiadomienie u dołu okna.
    property <int> toast-seen: -1;
    toast-timer := Timer {
        interval: 3200ms;
        running: App.toast != "" && root.toast-seen != App.toast-serial;
        triggered => {
            root.toast-seen = App.toast-serial;
        }
    }
    if App.toast != "" && root.toast-seen != App.toast-serial: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 44px;
        width: tt.preferred-width + 32px;
        height: 36px;
        border-radius: 18px;
        background: Theme.popup;
        border-width: 1px;
        border-color: Theme.line-strong;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000080;
        tt := Text {
            text: App.toast;
            font-family: Theme.font;
            font-size: Theme.fs;
            color: Theme.text;
        }
    }

    // Dymek podpowiedzi po krótkim zatrzymaniu wskaźnika.
    // Pokazujemy dopiero, gdy przez cały takt wskaźnik się nie ruszył (numer bez zmian).
    property <int> tip-seen: -1;
    tip-timer := Timer {
        interval: 300ms;
        running: Tip.text != "" && Tip.shown != Tip.serial;
        triggered => {
            if (root.tip-seen == Tip.serial) {
                Tip.shown = Tip.serial;
            } else {
                root.tip-seen = Tip.serial;
            }
        }
    }
    if Tip.text != "" && Tip.shown == Tip.serial: Rectangle {
        property <length> below: Tip.y + 22px;
        x: max(8px, min(Tip.x - 8px, root.width - self.width - 8px));
        y: self.below + self.height > root.height - 8px ? Tip.y - self.height - 10px : self.below;
        width: min(tt2.preferred-width, 380px) + 20px;
        height: tt2.preferred-height + 12px;
        border-radius: Theme.r-small;
        background: Theme.popup;
        border-width: 1px;
        border-color: Theme.line-strong;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000066;
        tt2 := Text {
            x: 10px;
            y: 6px;
            width: min(self.preferred-width, 380px);
            text: Tip.text;
            wrap: word-wrap;
            font-family: Theme.font;
            font-size: Theme.fs-small;
            color: Theme.text;
        }
    }
}
