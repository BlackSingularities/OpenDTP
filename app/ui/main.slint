// Okno główne OpenDTP: pasek tytułu z paskiem szybkiego dostępu i paletą poleceń, wstążka,
// płótno, panele wysuwane, pasek stanu i nakładki (menu Plik, menu kontekstowe, okna).

import { ListView, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, PageV, BoxV, NodeV, ItemV, StyleV, NavV, RecentV } from "state.slint";
import { Tip, TipArea, IconButton, Field, Spin, Switch, MenuItem, MenuSep, Card, Segmented, Label, Dim, Button, Slider } from "widgets.slint";
import { RibbonTabs, RibbonBody, Menus, MenuButton } from "ribbon.slint";
import { Canvas } from "canvas.slint";
import { LeftPanel, RightPanel } from "panels.slint";
import { Backstage } from "backstage.slint";

export { App, Theme, Icons, Tip, PageV, BoxV, NodeV, ItemV, StyleV, NavV, RecentV }

/// Przycisk okna (minimalizuj, maksymalizuj, zamknij) w pasku tytułu.
component WinButton inherits Rectangle {
    in property <int> kind;
    in property <string> tip;
    width: 46px;
    background: ta.pressed ? (kind == 3 ? #c42b1c : Theme.press) : ta.has-hover ? (kind == 3 ? #e81123 : Theme.hover) : transparent;
    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: ta.has-hover && root.kind == 3 ? #ffffff : Theme.text;
        stroke-width: 1px;
        fill: transparent;
        commands: root.kind == 1 ? "M 0 5 L 10 5" : root.kind == 3 ? "M 0 0 L 10 10 M 10 0 L 0 10" : App.maximized ? "M 2 0 L 10 0 L 10 8 M 0 2 L 8 2 L 8 10 L 0 10 Z" : "M 0 0 L 10 0 L 10 10 L 0 10 Z";
    }
    ta := TipArea {
        tip: root.tip;
        clicked => {
            App.win(root.kind);
        }
    }
}

component TopBar inherits Rectangle {
    height: 40px * Theme.scale;
    background: Theme.panel;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 2px;
        Image {
            source: @image-url("../icon.png");
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
        }
        Rectangle {
            width: 8px;
        }
        for q in App.qat: IconButton {
            icon: q.icon;
            tip: q.hint != "" ? q.label + " (" + q.hint + ")" : q.label;
            y: (parent.height - self.height) / 2;
            clicked => {
                App.cmd(q.id, "");
            }
        }
        IconButton {
            icon: Icons.chevron-down;
            size: 20px;
            icon-size: 12px;
            tip: @tr("Dostosuj pasek szybkiego dostępu");
            y: (parent.height - self.height) / 2;
            clicked => {
                App.cmd("customize", "qat");
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        App.win(0);
                    }
                }
                double-clicked => {
                    App.win(2);
                }
            }
            Text {
                text: App.doc-name + (App.dirty ? " •" : "");
                font-family: Theme.font;
                font-size: Theme.fs;
                color: Theme.text-dim;
                overflow: elide;
                width: parent.width - 20px;
                horizontal-alignment: center;
            }
        }
        Rectangle {
            width: 260px * Theme.scale;
            height: 26px * Theme.scale;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.r-small;
            background: pta.has-hover ? Theme.higher : Theme.raised;
            border-width: 1px;
            border-color: Theme.line;
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 8px;
                spacing: 8px;
                Image {
                    source: Icons.search;
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    colorize: Theme.text-faint;
                }
                Text {
                    text: @tr("Szukaj poleceń…");
                    font-family: Theme.font;
                    font-size: Theme.fs-small;
                    color: Theme.text-faint;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "Ctrl+K";
                    font-family: Theme.font;
                    font-size: 10px;
                    color: Theme.text-faint;
                    vertical-alignment: center;
                }
            }
            pta := TipArea {
                tip: @tr("Paleta poleceń – wszystkie funkcje programu (Ctrl+K)");
                clicked => {
                    App.cmd("palette", "");
                }
            }
        }
        Rectangle {
            width: 6px;
        }
        IconButton {
            icon: Icons.wand-sparkles;
            tint: Theme.accent;
            tip: @tr("Generuj dokument z AI");
            y: (parent.height - self.height) / 2;
            clicked => {
                App.cmd("ai", "");
            }
        }
        IconButton {
            icon: Theme.mode == 2 ? Icons.moon : Icons.sun;
            tip: @tr("Przełącz motyw: AMOLED / grafit / jasny");
            y: (parent.height - self.height) / 2;
            clicked => {
                App.cmd("theme", Theme.mode == 2 ? 0 : Theme.mode + 1);
            }
        }
        IconButton {
            icon: App.ribbon-collapsed ? Icons.chevron-down : Icons.chevron-up;
            tip: App.ribbon-collapsed ? @tr("Rozwiń wstążkę (Ctrl+F1)") : @tr("Zwiń wstążkę (Ctrl+F1)");
            y: (parent.height - self.height) / 2;
            clicked => {
                App.cmd("ribbon-collapse", "");
            }
        }
        Rectangle {
            width: 10px;
        }
        WinButton {
            kind: 1;
            tip: @tr("Minimalizuj");
        }
        WinButton {
            kind: 2;
            tip: App.maximized ? @tr("Przywróć") : @tr("Maksymalizuj");
        }
        WinButton {
            kind: 3;
            tip: @tr("Zamknij");
        }
    }
}


component StatusBar inherits Rectangle {
    height: 26px * Theme.scale;
    background: Theme.panel;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 16px;
        Dim {
            text: App.page-info;
        }
        Dim {
            text: App.words;
            TipArea {
                tip: @tr("Statystyka dokumentu");
                clicked => {
                    App.cmd("stats", "");
                }
            }
        }
        Dim {
            text: App.spell-state;
            TipArea {
                tip: @tr("Następny błąd pisowni (F7)");
                clicked => {
                    App.cmd("spell-next", "");
                }
            }
        }
        Dim {
            text: App.status;
            horizontal-stretch: 1;
        }
        IconButton {
            icon: Icons.list-tree;
            size: 22px;
            icon-size: 13px;
            active: App.left-panel == "nav";
            tip: @tr("Nawigator");
            y: (parent.height - self.height) / 2;
            clicked => {
                App.cmd("panel", "nav");
            }
        }
        IconButton {
            icon: Icons.pilcrow;
            size: 22px;
            icon-size: 13px;
            active: App.marks;
            tip: @tr("Znaki formatowania");
            y: (parent.height - self.height) / 2;
            clicked => {
                App.cmd("marks", "");
            }
        }
        HorizontalLayout {
            spacing: 4px;
            IconButton {
                icon: Icons.minus;
                size: 22px;
                icon-size: 12px;
                tip: @tr("Pomniejsz");
                y: (parent.height - self.height) / 2;
                clicked => {
                    App.cmd("zoom-out", "");
                }
            }
            Slider {
                width: 110px;
                y: (parent.height - self.height) / 2;
                value: (App.zoom - 25) / 375;
                tip: @tr("Powiększenie");
                moved(v) => {
                    App.cmd("zoom", round(25 + v * 375));
                }
            }
            IconButton {
                icon: Icons.plus;
                size: 22px;
                icon-size: 12px;
                tip: @tr("Powiększ");
                y: (parent.height - self.height) / 2;
                clicked => {
                    App.cmd("zoom-in", "");
                }
            }
            MenuButton {
                icon: Icons.zoom-in;
                label: App.zoom + "%";
                tip: @tr("Powiększenie");
                items: Menus.zooms;
                menu-w: 160px;
                y: (parent.height - self.height) / 2;
                picked(id) => {
                    App.cmd("zoom", id);
                }
            }
        }
    }
}

component Palette inherits Rectangle {
    background: #00000066;
    TouchArea {
        clicked => {
            App.palette-open = false;
        }
    }
    Card {
        x: (parent.width - self.width) / 2;
        y: 70px;
        width: 560px;
        height: min(440px, vl.preferred-height);
        TouchArea {}
        vl := VerticalLayout {
            padding: 10px;
            spacing: 8px;
            q := Field {
                w: 540px;
                placeholder: @tr("Wpisz polecenie, np. „kolumny”, „kształt”, „PDF”…");
                edited(t) => {
                    App.palette-query(t);
                }
                accepted(t) => {
                    if (App.palette-items.length > 0) {
                        App.palette-open = false;
                        App.cmd(App.palette-items[0].id, "");
                    }
                }
            }
            ListView {
                height: min(380px, App.palette-items.length * 30px + 4px);
                for c in App.palette-items: MenuItem {
                    label: c.label;
                    hint: c.hint;
                    icon: c.icon;
                    clicked => {
                        App.palette-open = false;
                        App.cmd(c.id, "");
                    }
                }
            }
        }
        init => {
            q.focus-input();
        }
    }
}

component ContextMenu inherits Rectangle {
    TouchArea {
        clicked => {
            App.ctx-open = false;
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                App.ctx-open = false;
            }
        }
    }
    Card {
        x: min(App.ctx-x, parent.width - self.width - 8px);
        y: min(App.ctx-y, parent.height - self.height - 8px);
        width: 250px;
        height: vl.preferred-height;
        TouchArea {}
        vl := VerticalLayout {
            padding: 5px;
            for it in App.ctx-items: Rectangle {
                height: it.id == "-" ? 9px : 28px * Theme.scale;
                if it.id == "-": MenuSep {
                    width: parent.width;
                }
                if it.id != "-": MenuItem {
                    width: parent.width;
                    label: it.label;
                    hint: it.hint;
                    icon: it.icon;
                    checked: it.checked;
                    font-family: it.font != "" ? it.font : Theme.font;
                    enabled: it.id != "";
                    clicked => {
                        App.ctx-open = false;
                        App.cmd(it.id, "");
                    }
                }
            }
        }
    }
}

component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> w: 420px;
    background: #00000080;
    TouchArea {}
    Card {
        x: (parent.width - self.width) / 2;
        y: max(40px, (parent.height - self.height) / 2.4);
        width: root.w;
        height: vl.preferred-height;
        vl := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            HorizontalLayout {
                Label {
                    text: root.title;
                    font-size: Theme.fs-big;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: Icons.x;
                    tip: @tr("Zamknij (Esc)");
                    clicked => {
                        App.dialog = "";
                    }
                }
            }
            @children
        }
    }
}

component Customize inherits Dialog {
    in property <string> target;
    w: 460px;
    title: root.target == "qat" ? @tr("Pasek szybkiego dostępu") : @tr("Moja karta");
    Dim {
        text: @tr("Zaznacz polecenia, które mają być pod ręką.");
    }
    ListView {
        height: 380px;
        for c in App.all-commands: MenuItem {
            label: c.label;
            hint: c.hint;
            checked: c.checked;
            clicked => {
                App.cmd(root.target == "qat" ? "qat-toggle" : "tab-toggle", c.id);
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button {
            label: @tr("Przywróć domyślne");
            clicked => {
                App.cmd(root.target == "qat" ? "qat-reset" : "tab-reset", "");
            }
        }
        Button {
            label: @tr("Gotowe");
            primary: true;
            clicked => {
                App.dialog = "";
            }
        }
    }
}

export component AppWindow inherits Window {
    title: App.title;
    no-frame: true;
    icon: @image-url("../icon.png");
    background: Theme.bg;
    preferred-width: 1440px;
    preferred-height: 920px;
    min-width: 900px;
    min-height: 560px;
    default-font-family: Theme.font;
    property <int> tip-shown: -1;
    init => {
        App.win-h = self.height;
    }
    changed height => {
        App.win-h = self.height;
    }

    callback close-requested();

    VerticalLayout {
        TopBar {}
        RibbonTabs {
            background: Theme.panel;
        }
        if !App.ribbon-collapsed: RibbonBody {}
        Rectangle {
            height: 1px;
            background: Theme.line;
        }
        Rectangle {
            vertical-stretch: 1;
            canvas := Canvas {
                width: parent.width;
                height: parent.height;
            }
            if App.ribbon-collapsed && App.ribbon-peek: Rectangle {
                y: 0;
                height: Theme.ribbon-h + 2px;
                background: Theme.panel;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000080;
                RibbonBody {}
            }
            if App.left-panel != "": LeftPanel {
                x: 10px;
                y: 10px;
                height: parent.height - 20px;
            }
            if App.right-panel != "": RightPanel {
                x: parent.width - self.width - 10px;
                y: 10px;
                height: parent.height - 20px;
            }
        }
        StatusBar {}
    }

    if App.backstage: Backstage {
        width: parent.width;
        height: parent.height;
    }
    if App.ctx-open: ContextMenu {
        width: parent.width;
        height: parent.height;
    }
    if App.palette-open: Palette {
        width: parent.width;
        height: parent.height;
    }
    if App.dialog == "link": Dialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Hiperłącze");
        lf := Field {
            w: 384px;
            text <=> App.link-url;
            placeholder: "https://";
            accepted(t) => {
                App.cmd("link-apply", t);
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                label: @tr("Usuń łącze");
                clicked => {
                    App.cmd("link-apply", "");
                }
            }
            Button {
                label: @tr("Wstaw");
                primary: true;
                clicked => {
                    App.cmd("link-apply", App.link-url);
                }
            }
        }
        init => {
            lf.focus-input();
        }
    }
    if App.dialog == "ai": Dialog {
        width: parent.width;
        height: parent.height;
        w: 620px;
        title: @tr("Generuj dokument z AI");
        Dim {
            text: @tr("Opisz, jaki dokument ma powstać – temat, odbiorców, układ, ton. AI napisze treść i złoży ją z formatowaniem: nagłówki, listy, wykresy, kształty tekstu, kolumny.");
            wrap: word-wrap;
            height: 34px;
        }
        Rectangle {
            height: 172px;
            border-radius: Theme.r-small;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line-strong;
            TextEdit {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                text <=> App.ai-prompt;
                font-size: 13px;
                enabled: !App.ai-busy;
                placeholder-text: @tr("np. Ulotka na otwarcie kawiarni „Pod Lipą”: menu śniadaniowe, godziny, rabat na start, ciepłe kolory");
            }
        }
        HorizontalLayout {
            spacing: 12px;
            Segmented {
                items: [@tr("Krótki"), @tr("Średni"), @tr("Obszerny")];
                current: App.ai-length;
                tip: @tr("Długość dokumentu");
                picked(i) => {
                    App.ai-length = i;
                }
            }
            Segmented {
                items: [@tr("Nowy dokument"), @tr("Wstaw w miejscu kursora")];
                current: App.ai-insert ? 1 : 0;
                tip: @tr("Gdzie umieścić wynik");
                picked(i) => {
                    App.ai-insert = i == 1;
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            for ex in [@tr("Raport kwartalny firmy z wykresami"), @tr("Ulotka na otwarcie kawiarni"), @tr("Gazetka szkolna w trzech kolumnach")]: Rectangle {
                width: ext.preferred-width + 18px;
                height: 24px;
                border-radius: 12px;
                background: exa.has-hover ? Theme.hover : Theme.raised;
                border-width: 1px;
                border-color: Theme.line;
                ext := Text {
                    text: ex;
                    font-size: Theme.fs-small;
                    color: Theme.text-dim;
                }
                exa := TipArea {
                    tip: @tr("Wstaw przykład");
                    clicked => {
                        App.ai-prompt = ex;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Dim {
                text: App.ai-busy ? @tr("Generowanie… to może potrwać do minuty") : App.ai-status;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            Button {
                label: @tr("Ustawienia AI");
                icon: Icons.settings;
                clicked => {
                    App.dialog = "";
                    App.cmd("settings", "");
                }
            }
            Button {
                label: App.ai-busy ? @tr("Generowanie…") : @tr("Generuj");
                icon: Icons.wand-sparkles;
                primary: true;
                enabled: !App.ai-busy && App.ai-prompt != "";
                clicked => {
                    App.cmd("ai-generate", "");
                }
            }
        }
    }
    if App.dialog == "font": Dialog {
        width: parent.width;
        height: parent.height;
        w: 640px;
        title: @tr("Czcionka");
        HorizontalLayout {
            spacing: 10px;
            Field {
                w: 260px;
                text <=> App.f-font;
                placeholder: @tr("Czcionka");
                tip: @tr("Nazwa kroju");
            }
            Field {
                w: 70px;
                text <=> App.f-size;
                placeholder: "pt";
                tip: @tr("Rozmiar (pt)");
            }
            Switch {
                label: @tr("Pogrubienie");
                on: App.f-bold;
                toggled => {
                    App.f-bold = !App.f-bold;
                }
            }
            Switch {
                label: @tr("Kursywa");
                on: App.f-italic;
                toggled => {
                    App.f-italic = !App.f-italic;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Dim {
                text: @tr("Podkreślenie");
                width: 90px;
            }
            Segmented {
                items: [@tr("Brak"), @tr("Pojedyncze"), @tr("Podwójne"), @tr("Kropki"), @tr("Fala")];
                current: App.f-underline;
                picked(i) => {
                    App.f-underline = i;
                }
            }
            Switch {
                label: @tr("Przekreślenie");
                on: App.f-strike;
                toggled => {
                    App.f-strike = !App.f-strike;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Dim {
                text: @tr("Wielkość liter");
                width: 90px;
            }
            Segmented {
                items: [@tr("Jak w tekście"), @tr("WERSALIKI"), @tr("Kapitaliki")];
                current: App.f-caps;
                picked(i) => {
                    App.f-caps = i;
                }
            }
            Segmented {
                items: [@tr("Zwykły"), @tr("Indeks górny"), @tr("Indeks dolny")];
                current: App.f-script;
                picked(i) => {
                    App.f-script = i;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Field {
                w: 110px;
                text <=> App.f-color;
                placeholder: "#000000";
                tip: @tr("Kolor tekstu (szesnastkowo)");
            }
            Field {
                w: 110px;
                text <=> App.f-highlight;
                placeholder: @tr("wyróżnienie");
                tip: @tr("Kolor wyróżnienia (pusto – brak)");
            }
            Spin {
                label: @tr("Światło");
                value: App.f-tracking;
                unit: "pt";
                w: 80px;
                changed-value(v) => {
                    App.f-tracking = v;
                }
                step(d) => {
                    App.cmd("f-step", "tracking;" + d);
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Spin {
                label: @tr("Szerokość");
                value: App.f-scale;
                unit: "%";
                w: 80px;
                changed-value(v) => {
                    App.f-scale = v;
                }
                step(d) => {
                    App.cmd("f-step", "scale;" + d);
                }
            }
            Spin {
                label: @tr("Linia bazowa");
                value: App.f-baseline;
                unit: "pt";
                w: 80px;
                changed-value(v) => {
                    App.f-baseline = v;
                }
                step(d) => {
                    App.cmd("f-step", "baseline;" + d);
                }
            }
            Segmented {
                items: ["Polski", "English"];
                current: App.f-lang;
                tip: @tr("Język tekstu (pisownia, dzielenie wyrazów)");
                picked(i) => {
                    App.f-lang = i;
                }
            }
        }
        Dim {
            text: @tr("FUNKCJE OPENTYPE (o ile czcionka je ma)");
        }
        HorizontalLayout {
            spacing: 12px;
            Switch {
                label: @tr("Kerning");
                on: App.f-kerning;
                toggled => {
                    App.f-kerning = !App.f-kerning;
                }
            }
            Switch {
                label: @tr("Ligatury");
                on: App.f-ligatures;
                toggled => {
                    App.f-ligatures = !App.f-ligatures;
                }
            }
            Switch {
                label: @tr("Kapitaliki OT");
                on: App.f-smcp;
                toggled => {
                    App.f-smcp = !App.f-smcp;
                }
            }
            Switch {
                label: @tr("Ułamki");
                on: App.f-frac;
                toggled => {
                    App.f-frac = !App.f-frac;
                }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            Switch {
                label: @tr("Cyfry nautyczne");
                on: App.f-onum;
                toggled => {
                    App.f-onum = !App.f-onum;
                }
            }
            Switch {
                label: @tr("Cyfry równej wysokości");
                on: App.f-lnum;
                toggled => {
                    App.f-lnum = !App.f-lnum;
                }
            }
            Switch {
                label: @tr("Cyfry tabelaryczne");
                on: App.f-tnum;
                toggled => {
                    App.f-tnum = !App.f-tnum;
                }
            }
            Field {
                w: 100px;
                text <=> App.f-ss;
                placeholder: "ss01, swsh";
                tip: @tr("Dodatkowe funkcje: zestawy stylistyczne ss01–ss20, swsh, salt…");
            }
        }
        Rectangle {
            height: 56px;
            border-radius: Theme.r-small;
            background: #ffffff;
            Text {
                text: "Zażółć gęślą jaźń 0123456789 ½ – AaBbŁł";
                font-family: App.f-font;
                font-size: 20px;
                font-weight: App.f-bold ? 700 : 400;
                font-italic: App.f-italic;
                color: #1a1a1a;
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                label: @tr("Anuluj");
                clicked => {
                    App.dialog = "";
                }
            }
            Button {
                label: @tr("Zastosuj");
                primary: true;
                clicked => {
                    App.cmd("font-apply", "");
                }
            }
        }
    }
    if App.dialog == "para": Dialog {
        width: parent.width;
        height: parent.height;
        w: 640px;
        title: @tr("Akapit");
        HorizontalLayout {
            spacing: 10px;
            Dim {
                text: @tr("Wyrównanie");
                width: 90px;
            }
            Segmented {
                items: [@tr("Do lewej"), @tr("Wyśrodkuj"), @tr("Do prawej"), @tr("Wyjustuj")];
                current: App.p-align;
                picked(i) => {
                    App.p-align = i;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Spin {
                label: @tr("Wcięcie ←");
                value: App.p-left;
                unit: App.unit;
                w: 84px;
                changed-value(v) => {
                    App.p-left = v;
                }
                step(d) => {
                    App.cmd("p-step", "left;" + d);
                }
            }
            Spin {
                label: @tr("Wcięcie →");
                value: App.p-right;
                unit: App.unit;
                w: 84px;
                changed-value(v) => {
                    App.p-right = v;
                }
                step(d) => {
                    App.cmd("p-step", "right;" + d);
                }
            }
            Spin {
                label: @tr("1. wiersz");
                value: App.p-first;
                unit: App.unit;
                w: 84px;
                tip: @tr("Ujemne – wysunięcie");
                changed-value(v) => {
                    App.p-first = v;
                }
                step(d) => {
                    App.cmd("p-step", "first;" + d);
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Spin {
                label: @tr("Przed");
                value: App.p-before;
                unit: "pt";
                w: 80px;
                changed-value(v) => {
                    App.p-before = v;
                }
                step(d) => {
                    App.cmd("p-step", "before;" + d);
                }
            }
            Spin {
                label: @tr("Po");
                value: App.p-after;
                unit: "pt";
                w: 80px;
                changed-value(v) => {
                    App.p-after = v;
                }
                step(d) => {
                    App.cmd("p-step", "after;" + d);
                }
            }
            Segmented {
                items: [@tr("Wielokrotna"), @tr("Dokładnie"), @tr("Co najmniej")];
                current: App.p-line-kind;
                tip: @tr("Interlinia");
                picked(i) => {
                    App.p-line-kind = i;
                }
            }
            Field {
                w: 60px;
                text <=> App.p-line;
                tip: @tr("Wartość interlinii (wielokrotność albo pt)");
            }
        }
        Dim {
            text: @tr("PRZEPŁYW TEKSTU");
        }
        HorizontalLayout {
            spacing: 12px;
            Switch {
                label: @tr("Razem z następnym");
                on: App.p-keep-next;
                toggled => {
                    App.p-keep-next = !App.p-keep-next;
                }
            }
            Switch {
                label: @tr("Wiersze razem");
                on: App.p-keep-lines;
                toggled => {
                    App.p-keep-lines = !App.p-keep-lines;
                }
            }
            Switch {
                label: @tr("Wdowy i sieroty");
                on: App.p-widows;
                toggled => {
                    App.p-widows = !App.p-widows;
                }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            Switch {
                label: @tr("Od nowej strony");
                on: App.p-page-before;
                toggled => {
                    App.p-page-before = !App.p-page-before;
                }
            }
            Switch {
                label: @tr("Dzielenie wyrazów");
                on: App.p-hyphen;
                toggled => {
                    App.p-hyphen = !App.p-hyphen;
                }
            }
            Spin {
                label: @tr("Inicjał (wiersze)");
                value: App.p-dropcap;
                w: 70px;
                changed-value(v) => {
                    App.cmd("p-step", "dropcap-set;" + v);
                }
                step(d) => {
                    App.cmd("p-step", "dropcap;" + d);
                }
            }
        }
        Dim {
            text: @tr("TŁO I RAMKA");
        }
        HorizontalLayout {
            spacing: 10px;
            Field {
                w: 100px;
                text <=> App.p-shading;
                placeholder: @tr("tło #rrggbb");
                tip: @tr("Cieniowanie akapitu (pusto – brak)");
            }
            Field {
                w: 60px;
                text <=> App.p-border-w;
                placeholder: "0";
                tip: @tr("Grubość ramki (pt, 0 – bez ramki)");
            }
            Field {
                w: 100px;
                text <=> App.p-border-color;
                placeholder: @tr("ramka #rrggbb");
                tip: @tr("Kolor ramki");
            }
            Field {
                w: 60px;
                text <=> App.p-radius;
                placeholder: "0";
                tip: @tr("Zaokrąglenie (pt)");
            }
            Field {
                w: 60px;
                text <=> App.p-padding;
                placeholder: "4";
                tip: @tr("Odstęp tekstu od ramki (pt)");
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Dim {
                text: @tr("Tabulatory");
                width: 90px;
            }
            Field {
                w: 420px;
                text <=> App.p-tabs;
                placeholder: @tr("np. 36; 72; -1 (−1 – do prawej z kropkami)");
                tip: @tr("Położenia tabulatorów w pt od lewej krawędzi tekstu");
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                label: @tr("Anuluj");
                clicked => {
                    App.dialog = "";
                }
            }
            Button {
                label: @tr("Zastosuj");
                primary: true;
                clicked => {
                    App.cmd("para-apply", "");
                }
            }
        }
    }
    if App.dialog == "stats": Dialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Statystyka");
        Label {
            text: App.stats-text;
            wrap: word-wrap;
            height: 150px;
            vertical-alignment: top;
        }
        HorizontalLayout {
            alignment: end;
            Button {
                label: @tr("Zamknij");
                primary: true;
                clicked => {
                    App.dialog = "";
                }
            }
        }
    }
    if App.dialog == "confirm": Dialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Niezapisane zmiany");
        Label {
            text: App.confirm-text;
            wrap: word-wrap;
            height: 40px;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                label: @tr("Anuluj");
                clicked => {
                    App.dialog = "";
                }
            }
            Button {
                label: @tr("Nie zapisuj");
                clicked => {
                    App.dialog = "";
                    App.cmd("confirm-discard", App.confirm-id);
                }
            }
            Button {
                label: @tr("Zapisz");
                primary: true;
                clicked => {
                    App.dialog = "";
                    App.cmd("confirm-save", App.confirm-id);
                }
            }
        }
    }
    if App.dialog == "customize-qat": Customize {
        width: parent.width;
        height: parent.height;
        target: "qat";
    }
    if App.dialog == "customize-tab": Customize {
        width: parent.width;
        height: parent.height;
        target: "tab";
    }

    // Zmiana rozmiaru okna bez ramki – cienkie pasy przy krawędziach i rogach.
    if !App.maximized && !App.fullscreen: Rectangle {
        width: parent.width;
        height: parent.height;
        for e in [
            { d: 11, x: 8px, y: 0, w: root.width - 16px, h: 4px, c: 0 },
            { d: 12, x: 8px, y: root.height - 4px, w: root.width - 16px, h: 4px, c: 0 },
            { d: 13, x: 0, y: 8px, w: 4px, h: root.height - 16px, c: 1 },
            { d: 14, x: root.width - 4px, y: 8px, w: 4px, h: root.height - 16px, c: 1 },
            { d: 15, x: 0, y: 0, w: 8px, h: 8px, c: 2 },
            { d: 16, x: root.width - 8px, y: 0, w: 8px, h: 8px, c: 3 },
            { d: 17, x: 0, y: root.height - 8px, w: 8px, h: 8px, c: 3 },
            { d: 18, x: root.width - 8px, y: root.height - 8px, w: 8px, h: 8px, c: 2 },
        ]: TouchArea {
            x: e.x;
            y: e.y;
            width: e.w;
            height: e.h;
            mouse-cursor: e.c == 0 ? MouseCursor.ns-resize : e.c == 1 ? MouseCursor.ew-resize : e.c == 2 ? MouseCursor.nwse-resize : MouseCursor.nesw-resize;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    App.win(e.d);
                }
            }
        }
    }

    // Powiadomienie u dołu okna.
    property <int> toast-seen: -1;
    toast-timer := Timer {
        interval: 3200ms;
        running: App.toast != "" && root.toast-seen != App.toast-serial;
        triggered => {
            root.toast-seen = App.toast-serial;
        }
    }
    if App.toast != "" && root.toast-seen != App.toast-serial: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 44px;
        width: tt.preferred-width + 32px;
        height: 36px;
        border-radius: 18px;
        background: Theme.higher;
        border-width: 1px;
        border-color: Theme.line-strong;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000080;
        tt := Text {
            text: App.toast;
            font-family: Theme.font;
            font-size: Theme.fs;
            color: Theme.text;
        }
    }

    // Dymek podpowiedzi po krótkim zatrzymaniu wskaźnika.
    tip-timer := Timer {
        interval: 550ms;
        running: Tip.text != "" && root.tip-shown != Tip.serial;
        triggered => {
            root.tip-shown = Tip.serial;
        }
    }
    if Tip.text != "" && root.tip-shown == Tip.serial: Rectangle {
        property <length> below: Tip.y + 22px;
        x: max(8px, min(Tip.x - 8px, root.width - self.width - 8px));
        y: self.below + self.height > root.height - 8px ? Tip.y - self.height - 10px : self.below;
        width: min(tt2.preferred-width, 380px) + 20px;
        height: tt2.preferred-height + 12px;
        border-radius: Theme.r-small;
        background: Theme.higher;
        border-width: 1px;
        border-color: Theme.line-strong;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000066;
        tt2 := Text {
            x: 10px;
            y: 6px;
            width: min(self.preferred-width, 380px);
            text: Tip.text;
            wrap: word-wrap;
            font-family: Theme.font;
            font-size: Theme.fs-small;
            color: Theme.text;
        }
    }
}
