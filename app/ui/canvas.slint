// Płótno dokumentu: strony wyrenderowane w Ruście, nad nimi nakładki rysowane w Slint
// (kursor, zaznaczenie, ramka obiektu z uchwytami, węzły kształtu, podgląd rysowania).

import { Theme } from "theme.slint";
import { App, PageV, BoxV, NodeV } from "state.slint";

component Handle inherits Rectangle {
    in property <string> id;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: #ffffff;
    border-width: 1.5px;
    border-color: Theme.accent;
}

export component Canvas inherits Rectangle {
    background: Theme.desk;
    property <int> fserial: App.focus-serial;
    changed fserial => {
        fs.focus();
    }
    changed width => {
        App.viewport(-fl.viewport-x, -fl.viewport-y, self.width, self.height);
    }
    changed height => {
        App.viewport(-fl.viewport-x, -fl.viewport-y, self.width, self.height);
    }
    fs := FocusScope {
        key-pressed(e) => {
            if (App.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt)) {
                return accept;
            }
            return reject;
        }
        fl := Flickable {
            viewport-width: App.content-w;
            viewport-height: App.content-h;
            viewport-x <=> App.view-x;
            viewport-y <=> App.view-y;
            changed viewport-y => {
                App.viewport(-self.viewport-x, -self.viewport-y, self.width, self.height);
            }
            changed viewport-x => {
                App.viewport(-self.viewport-x, -self.viewport-y, self.width, self.height);
            }
            Rectangle {
                width: App.content-w;
                height: App.content-h;
                for p in App.pages: Rectangle {
                    x: p.x;
                    y: p.y;
                    width: p.w;
                    height: p.h;
                    background: #ffffff;
                    drop-shadow-blur: 18px;
                    drop-shadow-color: Theme.dark ? #00000000 : #00000030;
                    drop-shadow-offset-y: 2px;
                    border-width: Theme.mode == 0 ? 1px : 0;
                    border-color: #ffffff14;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: p.img;
                        image-fit: fill;
                        image-rendering: smooth;
                    }
                }
                for r in App.find-rects: Rectangle {
                    x: r.x;
                    y: r.y;
                    width: r.w;
                    height: r.h;
                    background: #ffd60a66;
                    border-radius: 2px;
                }
                for r in App.sel-rects: Rectangle {
                    x: r.x;
                    y: r.y;
                    width: r.w;
                    height: r.h;
                    background: Theme.accent.with-alpha(0.3);
                }
                // Zaznaczony obiekt: kontur kształtu, ramka i uchwyty.
                if App.obj-sel && App.obj-path != "": Path {
                    x: 0;
                    y: 0;
                    width: App.content-w;
                    height: App.content-h;
                    viewbox-width: App.content-w / 1px;
                    viewbox-height: App.content-h / 1px;
                    commands: App.obj-path;
                    stroke: Theme.accent;
                    stroke-width: 1.2px;
                    fill: transparent;
                }
                for b in App.multi-boxes: Rectangle {
                    x: b.x;
                    y: b.y;
                    width: b.w;
                    height: b.h;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.7);
                }
                if App.obj-sel && !App.node-mode: Rectangle {
                    x: App.obj-box.x;
                    y: App.obj-box.y;
                    width: App.obj-box.w;
                    height: App.obj-box.h;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.55);
                    if !App.obj-locked: Handle {
                        x: -5px;
                        y: -5px;
                    }
                    if !App.obj-locked: Handle {
                        x: (parent.width - self.width) / 2;
                        y: -5px;
                    }
                    if !App.obj-locked: Handle {
                        x: parent.width - 4px;
                        y: -5px;
                    }
                    if !App.obj-locked: Handle {
                        x: -5px;
                        y: (parent.height - self.height) / 2;
                    }
                    if !App.obj-locked: Handle {
                        x: parent.width - 4px;
                        y: (parent.height - self.height) / 2;
                    }
                    if !App.obj-locked: Handle {
                        x: -5px;
                        y: parent.height - 4px;
                    }
                    if !App.obj-locked: Handle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - 4px;
                    }
                    if !App.obj-locked: Handle {
                        x: parent.width - 4px;
                        y: parent.height - 4px;
                    }
                }
                if App.node-mode && App.node-lines != "": Path {
                    x: 0;
                    y: 0;
                    width: App.content-w;
                    height: App.content-h;
                    viewbox-width: App.content-w / 1px;
                    viewbox-height: App.content-h / 1px;
                    commands: App.node-lines;
                    stroke: Theme.accent.with-alpha(0.7);
                    stroke-width: 1px;
                    fill: transparent;
                }
                for n in App.nodes: Rectangle {
                    x: n.x - self.width / 2;
                    y: n.y - self.height / 2;
                    width: n.kind == 2 ? 8px : 10px;
                    height: self.width;
                    border-radius: n.kind == 0 ? 1px : self.width / 2;
                    background: n.sel ? Theme.accent : #ffffff;
                    border-width: 1.5px;
                    border-color: Theme.accent;
                }
                if App.preview-path != "": Path {
                    x: 0;
                    y: 0;
                    width: App.content-w;
                    height: App.content-h;
                    viewbox-width: App.content-w / 1px;
                    viewbox-height: App.content-h / 1px;
                    commands: App.preview-path;
                    stroke: Theme.accent;
                    stroke-width: 1.5px;
                    fill: Theme.accent.with-alpha(0.08);
                }
                if App.snap-lines != "": Path {
                    x: 0;
                    y: 0;
                    width: App.content-w;
                    height: App.content-h;
                    viewbox-width: App.content-w / 1px;
                    viewbox-height: App.content-h / 1px;
                    commands: App.snap-lines;
                    stroke: #ff3ea5;
                    stroke-width: 1px;
                }
                if App.drag-box-on: Rectangle {
                    x: App.drag-box.x;
                    y: App.drag-box.y;
                    width: App.drag-box.w;
                    height: App.drag-box.h;
                    border-width: 1px;
                    border-color: Theme.accent;
                    background: Theme.accent.with-alpha(0.08);
                }
                if App.caret-on && App.caret-blink: Rectangle {
                    x: App.caret.x;
                    y: App.caret.y;
                    width: max(1.5px, App.caret.w);
                    height: App.caret.h;
                    background: #101010;
                }
                ta := TouchArea {
                    mouse-cursor: App.cursor == "move" ? MouseCursor.move : App.cursor == "arrow" ? MouseCursor.default : App.cursor == "cross" ? MouseCursor.crosshair : App.cursor == "nwse" ? MouseCursor.nwse-resize : App.cursor == "nesw" ? MouseCursor.nesw-resize : App.cursor == "ew" ? MouseCursor.ew-resize : App.cursor == "ns" ? MouseCursor.ns-resize : App.cursor == "pointer" ? MouseCursor.pointer : App.cursor == "copy" ? MouseCursor.copy : MouseCursor.text;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            fs.focus();
                            App.ctx-x = self.absolute-position.x + self.mouse-x;
                            App.ctx-y = self.absolute-position.y + self.mouse-y;
                            App.pointer(0, self.mouse-x, self.mouse-y, e.button == PointerEventButton.right ? 1 : 0, e.modifiers.shift, e.modifiers.control, e.modifiers.alt);
                        } else if (e.kind == PointerEventKind.up) {
                            App.pointer(2, self.mouse-x, self.mouse-y, e.button == PointerEventButton.right ? 1 : 0, e.modifiers.shift, e.modifiers.control, e.modifiers.alt);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            App.pointer(1, self.mouse-x, self.mouse-y, 0, false, false, false);
                        } else {
                            App.hover(self.mouse-x, self.mouse-y);
                        }
                    }
                    changed has-hover => {
                        if (self.has-hover) {
                            App.hover(self.mouse-x, self.mouse-y);
                        }
                    }
                    scroll-event(e) => {
                        if (e.modifiers.control) {
                            App.wheel-zoom(e.delta-y / 1px, self.mouse-x, self.mouse-y);
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }
    }
    public function focus-canvas() {
        fs.focus();
    }
}
