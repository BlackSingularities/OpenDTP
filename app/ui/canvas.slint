// Płótno dokumentu: strony wyrenderowane w Ruście, nad nimi nakładki rysowane w Slint
// (kursor, zaznaczenie, ramka obiektu z uchwytami, węzły kształtu, podgląd rysowania).

import { Theme } from "theme.slint";
import { App, PageV, BoxV, NodeV } from "state.slint";
import { TipArea } from "widgets.slint";

component Handle inherits Rectangle {
    in property <string> id;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: #ffffff;
    border-width: 1.5px;
    border-color: Theme.accent;
}

/// Suwak linijki (wcięcie albo tabulator) – przeciąganie zmienia położenie w punktach.
component RulerMark inherits Rectangle {
    in property <length> at;
    in property <int> kind;
    in property <float> value;
    in property <string> tip;
    callback done(float, bool);
    property <length> dx;
    x: root.at + root.dx - 6px;
    width: 12px;
    height: 12px;
    Path {
        width: 10px;
        height: 8px;
        x: 1px;
        y: root.kind == 1 ? 0px : 4px;
        viewbox-width: 10;
        viewbox-height: 8;
        fill: root.kind == 3 ? transparent : ma.pressed ? Theme.accent : Theme.text;
        stroke: Theme.text;
        stroke-width: root.kind == 3 ? 1.6px : 0px;
        commands: root.kind == 1 ? "M 0 0 L 10 0 L 5 7 Z" : root.kind == 3 ? "M 2 0 L 2 7 L 9 7" : "M 5 0 L 10 7 L 0 7 Z";
    }
    ma := TouchArea {
        mouse-cursor: MouseCursor.ew-resize;
        property <length> grab;
        property <length> dy;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.grab = self.mouse-x;
            } else if (e.kind == PointerEventKind.up) {
                root.done(root.value + root.dx / (App.ruler-k * 1px), abs(self.dy) > 18px);
                root.dx = 0;
                self.dy = 0;
            }
        }
        moved => {
            if (self.pressed) {
                root.dx += self.mouse-x - self.grab;
                self.dy = self.mouse-y - 6px;
            }
        }
    }
    TipArea {
        x: 0;
        width: 0;
        tip: root.tip;
    }
}

/// Linijka pionowa: wysokość strony z kursorem, obszar tekstu między marginesami górnym i dolnym.
component VRuler inherits Rectangle {
    width: 22px;
    background: Theme.panel;
    // Początek płótna (pod linijką poziomą) + położenie strony w przewijanym widoku.
    in property <length> top;
    property <length> oy: root.top + App.ruler-page-y + App.view-y - self.y;
    property <length> k: App.ruler-k * 1px;
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.line;
    }
    Rectangle {
        y: root.oy + App.ruler-v-c0 * root.k;
        x: 4px;
        height: max(0, (App.ruler-v-c1 - App.ruler-v-c0) * root.k);
        width: 14px;
        background: Theme.raised;
        border-radius: 2px;
    }
    for t[i] in 90: Rectangle {
        property <float> pt: i * App.ruler-tick / 2;
        y: root.oy + self.pt * root.k;
        x: mod(i, 2) == 0 ? 12px : 15px;
        height: 1px;
        width: mod(i, 2) == 0 ? 6px : 3px;
        background: Theme.text-faint;
        visible: self.y > 0 && self.y < root.height && self.pt <= App.ruler-page-h;
    }
    for t[i] in 45: Text {
        y: root.oy + i * App.ruler-tick * root.k - 6px;
        x: 0;
        width: 12px;
        height: 12px;
        text: i == 0 ? "" : i;
        font-size: 9px;
        color: Theme.text-faint;
        horizontal-alignment: center;
        vertical-alignment: center;
        visible: self.y > 0 && self.y < root.height && i * App.ruler-tick <= App.ruler-page-h;
    }
}

component Ruler inherits Rectangle {
    height: 22px;
    background: Theme.panel;
    property <length> ox: App.ruler-page-x + App.view-x;
    property <length> k: App.ruler-k * 1px;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
    // Obszar tekstu (kolumna) jaśniejszy.
    Rectangle {
        x: root.ox + App.ruler-c0 * root.k;
        y: 4px;
        width: max(0, (App.ruler-c1 - App.ruler-c0) * root.k);
        height: 14px;
        background: Theme.raised;
        border-radius: 2px;
    }
    for t[i] in 60: Rectangle {
        property <float> pt: i * App.ruler-tick / 2;
        x: root.ox + self.pt * root.k;
        y: mod(i, 2) == 0 ? 12px : 15px;
        width: 1px;
        height: mod(i, 2) == 0 ? 6px : 3px;
        background: Theme.text-faint;
        visible: self.x > 0 && self.x < root.width;
    }
    for t[i] in 30: Text {
        x: root.ox + i * App.ruler-tick * root.k - 6px;
        y: 1px;
        width: 12px;
        text: i == 0 ? "" : i;
        font-size: 9px;
        color: Theme.text-faint;
        horizontal-alignment: center;
        visible: self.x > 0 && self.x < root.width;
    }
    TouchArea {
        clicked => {
            App.cmd("ruler", "tab+;" + ((self.mouse-x - root.ox) / root.k - App.ruler-c0));
        }
    }
    for t in App.ruler-tabs: RulerMark {
        y: 9px;
        kind: 3;
        at: root.ox + (App.ruler-c0 + t) * root.k;
        value: t;
        tip: @tr("Tabulator – przeciągnij, aby przesunąć; w dół, aby usunąć");
        done(v, off) => {
            App.cmd("ruler", (off ? "tab-;" : "tabmv;" + t + ";") + (off ? t : v));
        }
    }
    RulerMark {
        y: 0px;
        kind: 1;
        at: root.ox + (App.ruler-c0 + App.ruler-left + App.ruler-first) * root.k;
        value: App.ruler-first;
        tip: @tr("Wcięcie pierwszego wiersza");
        done(v, off) => {
            App.cmd("ruler", "first;" + v);
        }
    }
    RulerMark {
        y: 10px;
        kind: 2;
        at: root.ox + (App.ruler-c0 + App.ruler-left) * root.k;
        value: App.ruler-left;
        tip: @tr("Wcięcie z lewej");
        done(v, off) => {
            App.cmd("ruler", "left;" + v);
        }
    }
    RulerMark {
        y: 10px;
        kind: 2;
        at: root.ox + (App.ruler-c1 - App.ruler-right) * root.k;
        value: App.ruler-right;
        tip: @tr("Wcięcie z prawej");
        done(v, off) => {
            App.cmd("ruler", "right;" + v);
        }
    }
}

export component Canvas inherits Rectangle {
    background: Theme.desk.with-alpha(1 - Theme.clear);
    property <int> fserial: App.focus-serial;
    changed fserial => {
        fs.focus();
    }
    changed width => {
        App.viewport(-fl.viewport-x, -fl.viewport-y, self.width, self.height);
    }
    changed height => {
        App.viewport(-fl.viewport-x, -fl.viewport-y, self.width, self.height);
    }
    property <length> vr: App.ruler-v-on ? 22px : 0px;
    if App.ruler-on: Ruler {
        y: 0;
        // Pod linijką pionową narożnik; skala przesunięta o jej szerokość.
        x: root.vr;
        width: parent.width - root.vr;
    }
    if App.ruler-on && App.ruler-v-on: Rectangle {
        width: 22px;
        height: 22px;
        background: Theme.panel;
    }
    if App.ruler-v-on: VRuler {
        x: 0;
        y: App.ruler-on ? 22px : 0px;
        height: parent.height - self.y;
        top: self.y;
    }
    fs := FocusScope {
        x: root.vr;
        width: parent.width - root.vr;
        y: App.ruler-on ? 22px : 0px;
        height: parent.height - self.y;
        key-pressed(e) => {
            if (App.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt)) {
                return accept;
            }
            return reject;
        }
        fl := Flickable {
            viewport-width: App.content-w;
            viewport-height: App.content-h;
            viewport-x <=> App.view-x;
            viewport-y <=> App.view-y;
            changed viewport-y => {
                App.viewport(-self.viewport-x, -self.viewport-y, self.width, self.height);
            }
            changed viewport-x => {
                App.viewport(-self.viewport-x, -self.viewport-y, self.width, self.height);
            }
            Rectangle {
                width: App.content-w;
                height: App.content-h;
                for p in App.pages: Rectangle {
                    x: p.x;
                    y: p.y;
                    width: p.w;
                    height: p.h;
                    background: #ffffff;
                    drop-shadow-blur: 18px;
                    drop-shadow-color: Theme.dark ? #00000000 : #00000030;
                    drop-shadow-offset-y: 2px;
                    border-width: Theme.mode == 0 ? 1px : 0;
                    border-color: #ffffff14;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: p.img;
                        image-fit: fill;
                        image-rendering: smooth;
                    }
                }
                for r in App.find-rects: Rectangle {
                    x: r.x;
                    y: r.y;
                    width: r.w;
                    height: r.h;
                    background: #ffd60a66;
                    border-radius: 2px;
                }
                for r in App.sel-rects: Rectangle {
                    x: r.x;
                    y: r.y;
                    width: r.w;
                    height: r.h;
                    background: Theme.accent.with-alpha(0.3);
                }
                // Zaznaczony obiekt: kontur kształtu, ramka i uchwyty.
                if App.obj-sel && App.obj-path != "": Path {
                    x: 0;
                    y: 0;
                    width: App.content-w;
                    height: App.content-h;
                    viewbox-width: App.content-w / 1px;
                    viewbox-height: App.content-h / 1px;
                    commands: App.obj-path;
                    stroke: Theme.accent;
                    stroke-width: 1.2px;
                    fill: transparent;
                }
                for b in App.multi-boxes: Rectangle {
                    x: b.x;
                    y: b.y;
                    width: b.w;
                    height: b.h;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.7);
                }
                if App.obj-sel && !App.node-mode: Rectangle {
                    x: App.obj-box.x;
                    y: App.obj-box.y;
                    width: App.obj-box.w;
                    height: App.obj-box.h;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.55);
                    if !App.obj-locked: Handle {
                        x: -5px;
                        y: -5px;
                    }
                    if !App.obj-locked: Handle {
                        x: (parent.width - self.width) / 2;
                        y: -5px;
                    }
                    if !App.obj-locked: Handle {
                        x: parent.width - 4px;
                        y: -5px;
                    }
                    if !App.obj-locked: Handle {
                        x: -5px;
                        y: (parent.height - self.height) / 2;
                    }
                    if !App.obj-locked: Handle {
                        x: parent.width - 4px;
                        y: (parent.height - self.height) / 2;
                    }
                    if !App.obj-locked: Handle {
                        x: -5px;
                        y: parent.height - 4px;
                    }
                    if !App.obj-locked: Handle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - 4px;
                    }
                    if !App.obj-locked: Handle {
                        x: parent.width - 4px;
                        y: parent.height - 4px;
                    }
                }
                if App.node-mode && App.node-lines != "": Path {
                    x: 0;
                    y: 0;
                    width: App.content-w;
                    height: App.content-h;
                    viewbox-width: App.content-w / 1px;
                    viewbox-height: App.content-h / 1px;
                    commands: App.node-lines;
                    stroke: Theme.accent.with-alpha(0.7);
                    stroke-width: 1px;
                    fill: transparent;
                }
                for n in App.nodes: Rectangle {
                    x: n.x - self.width / 2;
                    y: n.y - self.height / 2;
                    width: n.kind == 2 ? 8px : 10px;
                    height: self.width;
                    border-radius: n.kind == 0 ? 1px : self.width / 2;
                    background: n.sel ? Theme.accent : #ffffff;
                    border-width: 1.5px;
                    border-color: Theme.accent;
                }
                if App.preview-path != "": Path {
                    x: 0;
                    y: 0;
                    width: App.content-w;
                    height: App.content-h;
                    viewbox-width: App.content-w / 1px;
                    viewbox-height: App.content-h / 1px;
                    commands: App.preview-path;
                    stroke: Theme.accent;
                    stroke-width: 1.5px;
                    fill: Theme.accent.with-alpha(0.08);
                }
                if App.snap-lines != "": Path {
                    x: 0;
                    y: 0;
                    width: App.content-w;
                    height: App.content-h;
                    viewbox-width: App.content-w / 1px;
                    viewbox-height: App.content-h / 1px;
                    commands: App.snap-lines;
                    stroke: #ff3ea5;
                    stroke-width: 1px;
                }
                if App.drag-box-on: Rectangle {
                    x: App.drag-box.x;
                    y: App.drag-box.y;
                    width: App.drag-box.w;
                    height: App.drag-box.h;
                    border-width: 1px;
                    border-color: Theme.accent;
                    background: Theme.accent.with-alpha(0.08);
                }
                if App.cell-on: Rectangle {
                    x: App.cell-box.x;
                    y: App.cell-box.y;
                    width: App.cell-box.w;
                    height: App.cell-box.h;
                    background: #ffffff;
                    border-width: 2px;
                    border-color: Theme.accent;
                    property <int> serial: App.cell-serial;
                    changed serial => {
                        cin.text = App.cell-text;
                        cin.focus();
                        cin.select-all();
                    }
                    cin := TextInput {
                        x: 4px;
                        width: parent.width - 8px;
                        height: parent.height;
                        text: App.cell-text;
                        color: #1a1a1a;
                        font-size: max(11px, min(parent.height * 0.5, 16px));
                        vertical-alignment: center;
                        single-line: true;
                        init => {
                            self.focus();
                            self.select-all();
                        }
                        accepted => {
                            App.cmd("cell-commit", self.text);
                        }
                        key-pressed(e) => {
                            if (e.text == Key.Tab) {
                                App.cmd(e.modifiers.shift ? "cell-prev" : "cell-next", self.text);
                                return accept;
                            }
                            if (e.text == Key.Escape) {
                                App.cmd("cell-cancel", "");
                                return accept;
                            }
                            return reject;
                        }
                    }
                }
                if App.caret-on && App.caret-blink: Rectangle {
                    x: App.caret.x;
                    y: App.caret.y;
                    width: max(1.5px, App.caret.w);
                    height: App.caret.h;
                    background: #101010;
                }
                ta := TouchArea {
                    mouse-cursor: App.cursor == "move" ? MouseCursor.move : App.cursor == "arrow" ? MouseCursor.default : App.cursor == "cross" ? MouseCursor.crosshair : App.cursor == "nwse" ? MouseCursor.nwse-resize : App.cursor == "nesw" ? MouseCursor.nesw-resize : App.cursor == "ew" ? MouseCursor.ew-resize : App.cursor == "ns" ? MouseCursor.ns-resize : App.cursor == "pointer" ? MouseCursor.pointer : App.cursor == "copy" ? MouseCursor.copy : MouseCursor.text;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            fs.focus();
                            App.ctx-x = self.absolute-position.x + self.mouse-x;
                            App.ctx-y = self.absolute-position.y + self.mouse-y;
                            App.pointer(0, self.mouse-x, self.mouse-y, e.button == PointerEventButton.right ? 1 : 0, e.modifiers.shift, e.modifiers.control, e.modifiers.alt);
                        } else if (e.kind == PointerEventKind.up) {
                            App.pointer(2, self.mouse-x, self.mouse-y, e.button == PointerEventButton.right ? 1 : 0, e.modifiers.shift, e.modifiers.control, e.modifiers.alt);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            App.pointer(1, self.mouse-x, self.mouse-y, 0, false, false, false);
                        } else {
                            App.hover(self.mouse-x, self.mouse-y);
                        }
                    }
                    changed has-hover => {
                        if (self.has-hover) {
                            App.hover(self.mouse-x, self.mouse-y);
                        }
                    }
                    scroll-event(e) => {
                        if (e.modifiers.control) {
                            App.wheel-zoom(e.delta-y / 1px, self.mouse-x, self.mouse-y);
                            return accept;
                        }
                        // Shift + kółko – w poziomie.
                        if (e.modifiers.shift && e.delta-x == 0) {
                            App.wheel-scroll(e.delta-y / 1px, 0);
                        } else {
                            App.wheel-scroll(e.delta-x / 1px, e.delta-y / 1px);
                        }
                        return accept;
                    }
                }
            }
        }
    }
    public function focus-canvas() {
        fs.focus();
    }
}
