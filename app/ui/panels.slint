// Panele wysuwane nad treścią (nie przesuwają układu): nawigator, style, znajdź i zamień,
// właściwości obiektu (położenie, wykres, tekst na ścieżce).

import { ScrollView, ListView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, NavV, StyleV } from "state.slint";
import { TipArea, IconButton, Field, Spin, Switch, MenuItem, MenuSep, Card, Segmented, Label, Dim, Button, Slider } from "widgets.slint";

component PanelHead inherits HorizontalLayout {
    in property <string> title;
    in property <image> icon;
    callback close();
    height: 38px;
    padding-left: 12px;
    padding-right: 6px;
    spacing: 8px;
    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        y: (parent.height - self.height) / 2;
        colorize: Theme.accent;
    }
    Label {
        text: root.title;
        font-weight: 600;
        horizontal-stretch: 1;
    }
    IconButton {
        icon: Icons.x;
        tip: @tr("Zamknij panel");
        y: (parent.height - self.height) / 2;
        clicked => {
            root.close();
        }
    }
}

component Section inherits Text {
    font-family: Theme.font;
    font-size: Theme.fs-small;
    font-weight: 600;
    color: Theme.text-faint;
    vertical-alignment: center;
    height: 22px;
}

export component LeftPanel inherits Card {
    width: 290px;
    VerticalLayout {
        padding-bottom: 8px;
        if App.left-panel == "nav": VerticalLayout {
            PanelHead {
                title: @tr("Nawigator");
                icon: Icons.list-tree;
                close => {
                    App.left-panel = "";
                }
            }
            if App.nav.length == 0: Dim {
                text: @tr("Brak nagłówków. Użyj stylów „Tytuł” i „Nagłówek 1–3”, a pojawią się tutaj.");
                wrap: word-wrap;
                x: 14px;
                width: parent.width - 28px;
                height: 60px;
            }
            ListView {
                for n in App.nav: Rectangle {
                    height: 28px;
                    border-radius: Theme.r-small;
                    background: n.current ? Theme.accent-soft : nta.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 12px + n.level * 14px;
                        padding-right: 10px;
                        spacing: 6px;
                        Text {
                            text: n.label;
                            font-family: Theme.font;
                            font-size: n.level == 0 ? Theme.fs : Theme.fs-small + 0.5px;
                            font-weight: n.level == 0 ? 600 : 400;
                            color: n.current ? Theme.accent : Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: n.page + 1;
                            font-family: Theme.font;
                            font-size: Theme.fs-small;
                            color: Theme.text-faint;
                            vertical-alignment: center;
                        }
                    }
                    nta := TipArea {
                        tip: @tr("Przejdź do: {}", n.label);
                        clicked => {
                            App.cmd("goto-para", n.para);
                        }
                    }
                }
            }
        }
        if App.left-panel == "styles": VerticalLayout {
            PanelHead {
                title: @tr("Style");
                icon: Icons.letter-text;
                close => {
                    App.left-panel = "";
                }
            }
            ListView {
                for s in App.styles: Rectangle {
                    height: max(34px, min(s.size, 26px) + 14px);
                    border-radius: Theme.r-small;
                    background: s.id == App.style-id ? Theme.accent-soft : sta.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: s.name;
                            font-family: s.font;
                            font-size: min(s.size, 26px);
                            font-weight: s.bold ? 700 : 400;
                            font-italic: s.italic;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: Icons.refresh-cw;
                            size: 24px;
                            icon-size: 13px;
                            y: (parent.height - self.height) / 2;
                            tip: @tr("Aktualizuj styl według zaznaczenia");
                            clicked => {
                                App.cmd("style-update", s.id);
                            }
                        }
                    }
                    sta := TipArea {
                        tip: @tr("Zastosuj styl: {}", s.name);
                        clicked => {
                            App.cmd("style", s.id);
                        }
                    }
                }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                spacing: 6px;
                Button {
                    label: @tr("Nowy styl z zaznaczenia");
                    icon: Icons.plus;
                    clicked => {
                        App.cmd("style-new", "");
                    }
                }
            }
        }
        if App.left-panel == "dict": VerticalLayout {
            PanelHead {
                title: @tr("Słownik użytkownika");
                icon: Icons.book-a;
                close => {
                    App.left-panel = "";
                }
            }
            if App.user-words.length == 0: Dim {
                text: @tr("Słownik jest pusty. Wyrazy dodasz z menu prawego przycisku na podkreślonym słowie.");
                wrap: word-wrap;
                x: 14px;
                width: parent.width - 28px;
                height: 60px;
            }
            ListView {
                for w in App.user-words: Rectangle {
                    height: 28px;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        Label {
                            text: w;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: Icons.trash-2;
                            size: 24px;
                            icon-size: 13px;
                            tip: @tr("Usuń ze słownika");
                            clicked => {
                                App.cmd("dict-remove", w);
                            }
                        }
                    }
                }
            }
        }
    }
}

export component RightPanel inherits Card {
    width: 310px;
    VerticalLayout {
        padding-bottom: 10px;
        if App.right-panel == "find": VerticalLayout {
            spacing: 8px;
            PanelHead {
                title: @tr("Znajdź i zamień");
                icon: Icons.search;
                close => {
                    App.right-panel = "";
                    App.cmd("find-close", "");
                }
            }
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                fnd := Field {
                    w: 286px;
                    text <=> App.find-text;
                    placeholder: @tr("Szukaj…");
                    edited(t) => {
                        App.cmd("find-run", t);
                    }
                    accepted(t) => {
                        App.cmd("find-next", "");
                    }
                }
                Field {
                    w: 286px;
                    text <=> App.replace-text;
                    placeholder: @tr("Zamień na…");
                }
                HorizontalLayout {
                    spacing: 10px;
                    Switch {
                        label: @tr("Wielkość liter");
                        on: App.find-case;
                        toggled => {
                            App.find-case = !App.find-case;
                            App.cmd("find-run", App.find-text);
                        }
                    }
                    Switch {
                        label: @tr("Całe wyrazy");
                        on: App.find-whole;
                        toggled => {
                            App.find-whole = !App.find-whole;
                            App.cmd("find-run", App.find-text);
                        }
                    }
                }
                Dim {
                    text: App.find-info;
                }
                HorizontalLayout {
                    spacing: 6px;
                    Button {
                        label: @tr("Poprzedni");
                        clicked => {
                            App.cmd("find-prev", "");
                        }
                    }
                    Button {
                        label: @tr("Następny");
                        primary: true;
                        clicked => {
                            App.cmd("find-next", "");
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Button {
                        label: @tr("Zamień");
                        clicked => {
                            App.cmd("replace-one", "");
                        }
                    }
                    Button {
                        label: @tr("Zamień wszystko");
                        clicked => {
                            App.cmd("replace-all", "");
                        }
                    }
                }
            }
            init => {
                fnd.focus-input();
            }
        }
        if App.right-panel == "props": ScrollView {
            VerticalLayout {
                spacing: 6px;
                PanelHead {
                    title: App.obj-name != "" ? App.obj-name : @tr("Obiekt");
                    icon: Icons.sliders-horizontal;
                    close => {
                        App.right-panel = "";
                    }
                }
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    Section {
                        text: @tr("POŁOŻENIE I ROZMIAR");
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Spin {
                            label: "X";
                            value: App.obj-x;
                            unit: App.unit;
                            w: 104px;
                            tip: @tr("Odległość od lewej krawędzi strony");
                            changed-value(v) => {
                                App.cmd("obj-x", v);
                            }
                            step(d) => {
                                App.cmd("obj-x-step", d);
                            }
                        }
                        Spin {
                            label: "Y";
                            value: App.obj-y;
                            unit: App.unit;
                            w: 104px;
                            tip: @tr("Odległość od górnej krawędzi strony");
                            changed-value(v) => {
                                App.cmd("obj-y", v);
                            }
                            step(d) => {
                                App.cmd("obj-y-step", d);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Spin {
                            label: "W";
                            value: App.obj-w;
                            unit: App.unit;
                            w: 104px;
                            tip: @tr("Szerokość");
                            changed-value(v) => {
                                App.cmd("obj-w", v);
                            }
                            step(d) => {
                                App.cmd("obj-w-step", d);
                            }
                        }
                        Spin {
                            label: "H";
                            value: App.obj-h;
                            unit: App.unit;
                            w: 104px;
                            tip: @tr("Wysokość");
                            changed-value(v) => {
                                App.cmd("obj-h", v);
                            }
                            step(d) => {
                                App.cmd("obj-h-step", d);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            label: @tr("Duplikuj");
                            icon: Icons.copy;
                            tip: @tr("Duplikuj obiekt (Ctrl+D)");
                            clicked => {
                                App.cmd("duplicate", "");
                            }
                        }
                        Button {
                            label: App.obj-locked ? @tr("Odblokuj") : @tr("Zablokuj");
                            icon: App.obj-locked ? Icons.lock-open : Icons.lock;
                            clicked => {
                                App.cmd("lock", "");
                            }
                        }
                        Button {
                            label: @tr("Usuń");
                            icon: Icons.trash-2;
                            clicked => {
                                App.cmd("delete-obj", "");
                            }
                        }
                    }
                    if App.obj-kind == "image": VerticalLayout {
                        spacing: 6px;
                        Section {
                            text: @tr("OBRAZ");
                        }
                        Segmented {
                            items: [@tr("Wypełnij kształt"), @tr("Zmieść cały")];
                            current: App.image-fit-cover ? 0 : 1;
                            tip: @tr("Dopasowanie obrazu do kształtu");
                            picked(i) => {
                                App.cmd("image-fit", i);
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button {
                                label: @tr("Wykryj kontur");
                                icon: Icons.scan;
                                clicked => {
                                    App.cmd("detect-contour", "");
                                }
                            }
                            Button {
                                label: @tr("Zmień obraz");
                                icon: Icons.image;
                                clicked => {
                                    App.cmd("replace-image", "");
                                }
                            }
                        }
                    }
                    if App.obj-kind == "chart": VerticalLayout {
                        spacing: 6px;
                        Section {
                            text: @tr("WYKRES");
                        }
                        Segmented {
                            items: [@tr("Kolumny"), @tr("Słupki"), @tr("Linie"), @tr("Pola"), @tr("Koło"), @tr("Pierścień")];
                            current: App.chart-kind;
                            picked(i) => {
                                App.cmd("chart-kind", i);
                            }
                        }
                        Field {
                            w: 286px;
                            text <=> App.chart-title;
                            placeholder: @tr("Tytuł wykresu");
                            accepted(t) => {
                                App.cmd("chart-title", t);
                            }
                        }
                        Dim {
                            text: @tr("Dane: pierwszy wiersz – nazwy serii, potem etykieta i wartości oddzielone średnikiem.");
                            wrap: word-wrap;
                            height: 32px;
                        }
                        TextEdit {
                            height: 150px;
                            text <=> App.chart-data;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Switch {
                                label: @tr("Legenda");
                                on: App.chart-legend;
                                toggled => {
                                    App.cmd("chart-legend", "");
                                }
                            }
                            Switch {
                                label: @tr("Wartości");
                                on: App.chart-values;
                                toggled => {
                                    App.cmd("chart-values", "");
                                }
                            }
                        }
                        Button {
                            label: @tr("Zastosuj dane");
                            primary: true;
                            clicked => {
                                App.cmd("chart-data", App.chart-data);
                            }
                        }
                    }
                    if App.obj-kind == "table": VerticalLayout {
                        spacing: 6px;
                        Section {
                            text: @tr("TABELA");
                        }
                        Dim {
                            text: @tr("Każdy wiersz w osobnej linii, komórki oddzielone średnikiem (albo tabulatorem – można wkleić z Excela).");
                            wrap: word-wrap;
                            height: 32px;
                        }
                        TextEdit {
                            height: 170px;
                            text <=> App.table-data;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Switch {
                                label: @tr("Nagłówek");
                                on: App.table-header;
                                toggled => {
                                    App.cmd("table-header", "");
                                }
                            }
                            Switch {
                                label: @tr("Pasy");
                                on: App.table-stripes;
                                toggled => {
                                    App.cmd("table-stripes", "");
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            for c in [#1f4e79, #00796b, #8a1c1c, #5b3a7a, #d05a00, #333333]: Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 4px;
                                background: c;
                                border-width: App.table-accent == c ? 2px : 0;
                                border-color: Theme.accent;
                                TipArea {
                                    tip: @tr("Kolor nagłówka");
                                    clicked => {
                                        App.table-accent = c;
                                        App.cmd("table-accent", "");
                                    }
                                }
                            }
                        }
                        Button {
                            label: @tr("Zastosuj dane");
                            primary: true;
                            clicked => {
                                App.cmd("table-data", App.table-data);
                            }
                        }
                    }
                    if App.obj-kind == "path-text": VerticalLayout {
                        spacing: 6px;
                        Section {
                            text: @tr("TEKST NA ŚCIEŻCE");
                        }
                        Field {
                            w: 286px;
                            text <=> App.path-text;
                            placeholder: @tr("Tekst biegnący po krzywej");
                            edited(t) => {
                                App.cmd("path-text-set", t);
                            }
                        }
                        Dim {
                            text: @tr("Przesunięcie wzdłuż ścieżki");
                        }
                        Slider {
                            value: App.path-offset;
                            tip: @tr("Początek tekstu na krzywej");
                            moved(v) => {
                                App.cmd("path-offset", v);
                            }
                        }
                        Dim {
                            text: @tr("Formatowanie (czcionka, kolor, rozmiar) – z karty Narzędzia główne, gdy obiekt jest zaznaczony. Kształt ścieżki zmienisz węzłami.");
                            wrap: word-wrap;
                            height: 46px;
                        }
                    }
                    Section {
                        text: @tr("NAZWA");
                    }
                    Field {
                        w: 286px;
                        text <=> App.obj-name;
                        placeholder: @tr("Nazwa obiektu");
                        accepted(t) => {
                            App.cmd("obj-name", t);
                        }
                    }
                }
            }
        }
    }
}
