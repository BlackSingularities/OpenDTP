// Paski boczne zadokowane przy stronie (szerokość zmienia uchwyt): nawigator, style, słownik,
// znajdź i zamień, właściwości obiektu (położenie, obraz, wykres, tabela, tekst na ścieżce).

import { ScrollView, ListView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, NavV, StyleV } from "state.slint";
import { TipArea, IconButton, Field, Spin, Switch, MenuItem, MenuSep, Segmented, IconSeg, Toggle, Label, Dim, Button, Slider } from "widgets.slint";

component PanelHead inherits HorizontalLayout {
    in property <string> title;
    in property <image> icon;
    callback close();
    height: 38px;
    padding-left: 12px;
    padding-right: 6px;
    spacing: 8px;
    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        y: (parent.height - self.height) / 2;
        colorize: Theme.accent;
    }
    Label {
        text: root.title;
        font-weight: 600;
        horizontal-stretch: 1;
    }
    IconButton {
        icon: Icons.x;
        tip: @tr("Zamknij panel");
        y: (parent.height - self.height) / 2;
        clicked => {
            root.close();
        }
    }
}

component Section inherits Text {
    font-family: Theme.font;
    font-size: Theme.fs-small;
    font-weight: 600;
    color: Theme.text-faint;
    vertical-alignment: center;
    height: 22px;
}

export component LeftPanel inherits Rectangle {
    background: Theme.panel;
    VerticalLayout {
        padding-bottom: 8px;
        if App.left-panel == "nav": VerticalLayout {
            PanelHead {
                title: @tr("Nawigator");
                icon: Icons.list-tree;
                close => {
                    App.left-panel = "";
                }
            }
            if App.nav.length == 0: Dim {
                text: @tr("Brak nagłówków. Użyj stylów „Tytuł” i „Nagłówek 1–3”, a pojawią się tutaj.");
                wrap: word-wrap;
                x: 14px;
                width: parent.width - 28px;
                height: 60px;
            }
            ListView {
                for n in App.nav: Rectangle {
                    height: 28px;
                    border-radius: Theme.r-small;
                    background: n.current ? Theme.accent-soft : nta.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 12px + n.level * 14px;
                        padding-right: 10px;
                        spacing: 6px;
                        Text {
                            text: n.label;
                            font-family: Theme.font;
                            font-size: n.level == 0 ? Theme.fs : Theme.fs-small + 0.5px;
                            font-weight: n.level == 0 ? 600 : 400;
                            color: n.current ? Theme.accent : Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: n.page + 1;
                            font-family: Theme.font;
                            font-size: Theme.fs-small;
                            color: Theme.text-faint;
                            vertical-alignment: center;
                        }
                    }
                    nta := TipArea {
                        tip: @tr("Przejdź do: {}", n.label);
                        clicked => {
                            App.cmd("goto-para", n.para);
                        }
                    }
                }
            }
        }
        if App.left-panel == "styles": VerticalLayout {
            PanelHead {
                title: @tr("Style");
                icon: Icons.letter-text;
                close => {
                    App.left-panel = "";
                }
            }
            ListView {
                for s in App.styles: Rectangle {
                    height: max(34px, min(s.size, 26px) + 14px);
                    border-radius: Theme.r-small;
                    background: s.id == App.style-id ? Theme.accent-soft : sta.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: s.name;
                            font-family: s.font;
                            font-size: min(s.size, 26px);
                            font-weight: s.bold ? 700 : 400;
                            font-italic: s.italic;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: Icons.refresh-cw;
                            size: 24px;
                            icon-size: 13px;
                            y: (parent.height - self.height) / 2;
                            tip: @tr("Aktualizuj styl według zaznaczenia");
                            clicked => {
                                App.cmd("style-update", s.id);
                            }
                        }
                    }
                    sta := TipArea {
                        tip: @tr("Zastosuj styl: {}", s.name);
                        clicked => {
                            App.cmd("style", s.id);
                        }
                    }
                }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                spacing: 6px;
                Button {
                    label: @tr("Nowy styl");
                    icon: Icons.plus;
                    tip: @tr("Utwórz nowy styl akapitu z formatowania zaznaczonego tekstu");
                    clicked => {
                        App.cmd("style-new", "");
                    }
                }
            }
        }
        if App.left-panel == "dict": VerticalLayout {
            PanelHead {
                title: @tr("Słownik użytkownika");
                icon: Icons.book-a;
                close => {
                    App.left-panel = "";
                }
            }
            if App.user-words.length == 0: Dim {
                text: @tr("Słownik jest pusty. Wyrazy dodasz z menu prawego przycisku na podkreślonym słowie.");
                wrap: word-wrap;
                x: 14px;
                width: parent.width - 28px;
                height: 60px;
            }
            ListView {
                for w in App.user-words: Rectangle {
                    height: 28px;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        Label {
                            text: w;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: Icons.trash-2;
                            size: 24px;
                            icon-size: 13px;
                            tip: @tr("Usuń ze słownika");
                            clicked => {
                                App.cmd("dict-remove", w);
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Przycisk z ikoną w pasku bocznym – zawsze z podpowiedzią opisującą działanie.
component Tool inherits IconButton {
    size: 30px * Theme.scale;
}

export component RightPanel inherits Rectangle {
    background: Theme.panel;
    // Pole na całą szerokość kolumny i pole w jednej z dwóch kolumn.
    property <length> full: root.width - 24px;
    property <length> half: (root.width - 32px) / 2;
    VerticalLayout {
        padding-bottom: 10px;
        if App.right-panel == "find": VerticalLayout {
            spacing: 8px;
            alignment: start;
            PanelHead {
                title: @tr("Znajdź i zamień");
                icon: Icons.search;
                close => {
                    App.right-panel = "";
                    App.cmd("find-close", "");
                }
            }
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                fnd := Field {
                    w: root.full;
                    text <=> App.find-text;
                    placeholder: @tr("Szukaj…");
                    tip: @tr("Szukany tekst – wyniki podświetlają się na bieżąco, Enter przechodzi do następnego");
                    edited(t) => {
                        App.cmd("find-run", t);
                    }
                    accepted(t) => {
                        App.cmd("find-next", "");
                    }
                }
                Field {
                    w: root.full;
                    text <=> App.replace-text;
                    placeholder: @tr("Zamień na…");
                    tip: @tr("Tekst wstawiany w miejsce znalezionego");
                }
                HorizontalLayout {
                    spacing: 4px;
                    Toggle {
                        icon: Icons.case-sensitive;
                        on: App.find-case;
                        tip: @tr("Uwzględniaj wielkość liter (A ≠ a)");
                        toggled => {
                            App.find-case = !App.find-case;
                            App.cmd("find-run", App.find-text);
                        }
                    }
                    Toggle {
                        icon: Icons.whole-word;
                        on: App.find-whole;
                        tip: @tr("Tylko całe wyrazy – bez trafień w środku dłuższych słów");
                        toggled => {
                            App.find-whole = !App.find-whole;
                            App.cmd("find-run", App.find-text);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Tool {
                        icon: Icons.chevron-up;
                        tip: @tr("Poprzednie wystąpienie");
                        clicked => {
                            App.cmd("find-prev", "");
                        }
                    }
                    Tool {
                        icon: Icons.chevron-down;
                        tip: @tr("Następne wystąpienie (Enter)");
                        clicked => {
                            App.cmd("find-next", "");
                        }
                    }
                    Tool {
                        icon: Icons.replace;
                        tip: @tr("Zamień bieżące wystąpienie i przejdź do następnego");
                        clicked => {
                            App.cmd("replace-one", "");
                        }
                    }
                    Tool {
                        icon: Icons.list-checks;
                        tip: @tr("Zamień wszystkie wystąpienia w dokumencie");
                        clicked => {
                            App.cmd("replace-all", "");
                        }
                    }
                }
                Dim {
                    text: App.find-info;
                }
            }
            init => {
                fnd.focus-input();
            }
        }
        if App.right-panel == "props": ScrollView {
            VerticalLayout {
                spacing: 6px;
                PanelHead {
                    title: App.obj-name != "" ? App.obj-name : @tr("Obiekt");
                    icon: Icons.sliders-horizontal;
                    close => {
                        App.right-panel = "";
                    }
                }
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    // Akcje obiektu jako ikony.
                    HorizontalLayout {
                        spacing: 4px;
                        Toggle {
                            icon: Icons.pin;
                            on: App.obj-anchored;
                            tip: @tr("Przesuwaj z tekstem: obiekt zakotwiczony w akapicie wędruje razem z nim (wyłączone – stałe miejsce na stronie)");
                            toggled => {
                                App.cmd("anchor-toggle", "");
                            }
                        }
                        Toggle {
                            icon: App.obj-locked ? Icons.lock : Icons.lock-open;
                            on: App.obj-locked;
                            tip: App.obj-locked ? @tr("Odblokuj obiekt – znów można go przesuwać i zmieniać") : @tr("Zablokuj obiekt przed przypadkowym przesunięciem i zmianą");
                            toggled => {
                                App.cmd("lock", "");
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        Tool {
                            icon: Icons.copy;
                            tip: @tr("Duplikuj obiekt (Ctrl+D)");
                            clicked => {
                                App.cmd("duplicate", "");
                            }
                        }
                        Tool {
                            icon: Icons.trash-2;
                            tip: @tr("Usuń obiekt (Delete)");
                            clicked => {
                                App.cmd("delete-obj", "");
                            }
                        }
                    }
                    Section {
                        text: @tr("POŁOŻENIE I ROZMIAR");
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Spin {
                            label: "X";
                            value: App.obj-x;
                            unit: App.unit;
                            w: root.half;
                            tip: @tr("Odległość od lewej krawędzi strony");
                            changed-value(v) => {
                                App.cmd("obj-x", v);
                            }
                            step(d) => {
                                App.cmd("obj-x-step", d);
                            }
                        }
                        Spin {
                            label: "Y";
                            value: App.obj-y;
                            unit: App.unit;
                            w: root.half;
                            tip: @tr("Odległość od górnej krawędzi strony");
                            changed-value(v) => {
                                App.cmd("obj-y", v);
                            }
                            step(d) => {
                                App.cmd("obj-y-step", d);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Spin {
                            label: "W";
                            value: App.obj-w;
                            unit: App.unit;
                            w: root.half;
                            tip: @tr("Szerokość obiektu");
                            changed-value(v) => {
                                App.cmd("obj-w", v);
                            }
                            step(d) => {
                                App.cmd("obj-w-step", d);
                            }
                        }
                        Spin {
                            label: "H";
                            value: App.obj-h;
                            unit: App.unit;
                            w: root.half;
                            tip: @tr("Wysokość obiektu");
                            changed-value(v) => {
                                App.cmd("obj-h", v);
                            }
                            step(d) => {
                                App.cmd("obj-h-step", d);
                            }
                        }
                    }
                    if App.obj-kind == "image": VerticalLayout {
                        spacing: 6px;
                        Section {
                            text: @tr("OBRAZ");
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            IconSeg {
                                icons: [Icons.maximize, Icons.minimize];
                                tips: [@tr("Wypełnij kształt – obraz pokrywa cały kształt, nadmiar jest przycięty"), @tr("Zmieść cały – widać cały obraz, mogą zostać puste pasy")];
                                current: App.image-fit-cover ? 0 : 1;
                                picked(i) => {
                                    App.cmd("image-fit", i);
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            Tool {
                                icon: Icons.scan;
                                tip: @tr("Wykryj kontur – opływanie tekstu po krawędzi rysunku zamiast prostokąta");
                                clicked => {
                                    App.cmd("detect-contour", "");
                                }
                            }
                            Tool {
                                icon: Icons.image;
                                tip: @tr("Zmień obraz na inny plik, zachowując położenie i rozmiar");
                                clicked => {
                                    App.cmd("replace-image", "");
                                }
                            }
                        }
                    }
                    if App.obj-kind == "chart": VerticalLayout {
                        spacing: 6px;
                        Section {
                            text: @tr("WYKRES");
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            IconSeg {
                                icons: [Icons.chart-column, Icons.chart-bar, Icons.chart-line, Icons.chart-area, Icons.chart-pie, Icons.circle-dot];
                                tips: [@tr("Kolumny – pionowe słupki"), @tr("Słupki – poziome paski"), @tr("Linie – zmiany w czasie"), @tr("Pola – linie z wypełnieniem"), @tr("Koło – udział części w całości"), @tr("Pierścień – koło z otworem")];
                                current: App.chart-kind;
                                picked(i) => {
                                    App.cmd("chart-kind", i);
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            Toggle {
                                icon: Icons.list;
                                on: App.chart-legend;
                                tip: @tr("Legenda – opis kolorów serii");
                                toggled => {
                                    App.cmd("chart-legend", "");
                                }
                            }
                            Toggle {
                                icon: Icons.hash;
                                on: App.chart-values;
                                tip: @tr("Wartości – liczby nad słupkami i przy punktach");
                                toggled => {
                                    App.cmd("chart-values", "");
                                }
                            }
                        }
                        Field {
                            w: root.full;
                            text <=> App.chart-title;
                            placeholder: @tr("Tytuł wykresu");
                            tip: @tr("Tytuł nad wykresem; Enter zatwierdza");
                            accepted(t) => {
                                App.cmd("chart-title", t);
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Dim {
                                text: @tr("Dane");
                                horizontal-stretch: 1;
                            }
                            Tool {
                                icon: Icons.badge-info;
                                tip: @tr("Pierwszy wiersz – nazwy serii, kolejne – etykieta i wartości oddzielone średnikiem, np. „I kw.;12;16”");
                            }
                            Tool {
                                icon: Icons.check;
                                tint: Theme.accent;
                                tip: @tr("Zastosuj dane do wykresu");
                                clicked => {
                                    App.cmd("chart-data", App.chart-data);
                                }
                            }
                        }
                        TextEdit {
                            height: 170px;
                            text <=> App.chart-data;
                            font-size: 12px;
                        }
                    }
                    if App.obj-kind == "table": VerticalLayout {
                        spacing: 6px;
                        Section {
                            text: @tr("TABELA");
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Toggle {
                                icon: Icons.panel-top;
                                on: App.table-header;
                                tip: @tr("Wiersz nagłówka – wyróżniony kolorem i powtarzany na kolejnych stronach");
                                toggled => {
                                    App.cmd("table-header", "");
                                }
                            }
                            Toggle {
                                icon: Icons.rows-3;
                                on: App.table-stripes;
                                tip: @tr("Pasy – co drugi wiersz lekko zacieniony");
                                toggled => {
                                    App.cmd("table-stripes", "");
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            for c in [#1f4e79, #00796b, #8a1c1c, #5b3a7a, #d05a00, #333333]: Rectangle {
                                width: 20px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: c;
                                border-width: App.table-accent == c ? 2px : 0;
                                border-color: Theme.accent;
                                TipArea {
                                    tip: @tr("Kolor nagłówka i pasów tabeli");
                                    clicked => {
                                        App.table-accent = c;
                                        App.cmd("table-accent", "");
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            Dim {
                                text: @tr("Dane");
                                horizontal-stretch: 1;
                            }
                            Tool {
                                icon: Icons.badge-info;
                                tip: @tr("Każdy wiersz w osobnej linii, komórki oddzielone średnikiem albo tabulatorem (można wkleić z Excela). Znak < scala komórkę z lewą. Dwuklik w komórkę na stronie – pisanie w niej, Tab – następna.");
                            }
                            Tool {
                                icon: Icons.check;
                                tint: Theme.accent;
                                tip: @tr("Zastosuj dane do tabeli");
                                clicked => {
                                    App.cmd("table-data", App.table-data);
                                }
                            }
                        }
                        TextEdit {
                            height: 200px;
                            text <=> App.table-data;
                            font-size: 12px;
                        }
                    }
                    if App.obj-kind == "path-text": VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            Section {
                                text: @tr("TEKST NA ŚCIEŻCE");
                                horizontal-stretch: 1;
                            }
                            Tool {
                                icon: Icons.badge-info;
                                tip: @tr("Czcionkę, kolor i rozmiar ustawisz na karcie Narzędzia główne, gdy obiekt jest zaznaczony. Kształt ścieżki zmienisz węzłami.");
                            }
                        }
                        Field {
                            w: root.full;
                            text <=> App.path-text;
                            placeholder: @tr("Tekst biegnący po krzywej");
                            tip: @tr("Tekst układany wzdłuż ścieżki – zmiany widać od razu");
                            edited(t) => {
                                App.cmd("path-text-set", t);
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Image {
                                source: Icons.move-horizontal;
                                width: 16px;
                                colorize: Theme.text-dim;
                            }
                            Slider {
                                horizontal-stretch: 1;
                                value: App.path-offset;
                                tip: @tr("Przesunięcie początku tekstu wzdłuż krzywej");
                                moved(v) => {
                                    App.cmd("path-offset", v);
                                }
                            }
                        }
                    }
                    Section {
                        text: @tr("NAZWA");
                    }
                    Field {
                        w: root.full;
                        text <=> App.obj-name;
                        placeholder: @tr("Nazwa obiektu");
                        tip: @tr("Nazwa widoczna w nagłówku panelu; Enter zatwierdza");
                        accepted(t) => {
                            App.cmd("obj-name", t);
                        }
                    }
                }
            }
        }
    }
}
